import { ListView, ScrollView } from "std-widgets.slint";
import { DraftEditor } from "draft-editor.slint";

export struct TRow {
    kind: int,          // 0 user, 1 agent text, 2 thinking, 3 python cell, 5 notice
    title: string,
    meta: string,
    body: styled-text,
    code: styled-text,
    output: styled-text,
    has-code: bool,
    has-output: bool,
    expanded: bool,
    failed: bool,
    reason: string,
}

export struct SessionItem {
    id: string,
    uuid: string,
    name: string,
    age: string,
    full: string,
    tip: string,
    status: string,
    scroll: length,
}

// one waiting message, addressed by its lane and its position in that lane
export struct QueueItem {
    // what the row shows: one line, elided
    text: string,
    // what the daemon addressed it by, untouched
    raw: string,
    slot: int,
}

export struct ModelItem {
    id: string,
    label: string,
    // right-aligned hint: context window
    detail: string,
    current: bool,
}

// one provider's models; `models` is empty while the group is collapsed, so a
// thousand-entry catalog never becomes a thousand elements
export struct ModelGroup {
    provider: string,
    label: string,
    count: int,
    open: bool,
    configured: bool,
    models: [ModelItem],
}


component IconUp inherits Path {
    in property <color> tint: #a18e41;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 5 8.4 L 5 1.8 M 2 4.8 L 5 1.8 L 8 4.8";
    stroke: tint;
    stroke-width: 1.3px;
    fill: transparent;
}

component IconX inherits Path {
    in property <color> tint: #8b8c85;
    width: 8px;
    height: 8px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 2 2 L 8 8 M 8 2 L 2 8";
    stroke: tint;
    stroke-width: 1.4px;
    fill: transparent;
}

// One waiting message in the steering lane: already inside this turn, so the
// only action is delete. Two row components instead of one with a conditional
// button: a button made conditional does not take clicks here, even though it
// paints.
component QueueRow inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    callback act(string, int, string);

    // Two lines, fixed height: the panel stacks rows by arithmetic, so a row
    // that grew with its text would overlap the next one. Wrapped and elided,
    // a long message shows its beginning and where it was cut.
    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? #1f211a : transparent;

    // the text is the edit affordance; it stops short of the button
    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 30px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    Text {
        x: 6px;
        y: 3px;
        width: parent.width - 38px;
        height: parent.height - 6px;
        text: root.text;
        color: #d9d8d1;
        font-size: 11px;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: del.has-hover ? #2a2d24 : transparent;
        del := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "delete"); }
        }
        IconX {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: del.has-hover ? #f3ded8 : #8b8c85;
        }
    }
}

// A follow-up row: the same row plus the up arrow that pulls the message into
// the turn that is already running.
component QueueRowUp inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    callback act(string, int, string);

    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? #1f211a : transparent;

    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 52px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    Text {
        x: 6px;
        y: 3px;
        width: parent.width - 60px;
        height: parent.height - 6px;
        text: root.text;
        color: #d9d8d1;
        font-size: 11px;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 46px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: up.has-hover ? #2a2d24 : transparent;
        up := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "promote"); }
        }
        IconUp {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: up.has-hover ? #d9c86a : #a18e41;
        }
    }

    Rectangle {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: del.has-hover ? #2a2d24 : transparent;
        del := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "delete"); }
        }
        IconX {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: del.has-hover ? #f3ded8 : #8b8c85;
        }
    }
}
component IconRail inherits Path {
    in property <bool> open;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: open ? "M 6.5 1.5 L 2.5 5 L 6.5 8.5" : "M 3.5 1.5 L 7.5 5 L 3.5 8.5";
    stroke: #8b8c85;
    stroke-width: 1.3px;
    fill: transparent;
}

component IconDown inherits Path {
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: #b6b2a4;
    stroke-width: 1.6px;
    fill: transparent;
}

component IconCaret inherits Path {
