                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 13.00 4.80 L 14.35 2.47";
                                    stroke: 0.0833 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
