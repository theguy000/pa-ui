import { ListView, ScrollView } from "std-widgets.slint";
import { DraftEditor } from "draft-editor.slint";

export struct TRow {
    kind: int,          // 0 user, 1 agent text, 2 thinking, 3 python cell, 5 notice
    title: string,
    meta: string,
    body: styled-text,
    code: styled-text,
    output: styled-text,
    has-code: bool,
    has-output: bool,
    expanded: bool,
    failed: bool,
    reason: string,
}

export struct SessionItem {
    id: string,
    name: string,
    age: string,
    full: string,
    tip: string,
    status: string,
    scroll: length,
}

export struct ModelItem {
    id: string,
    label: string,
    detail: string,
}

component IconRail inherits Path {
    in property <bool> open;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: open ? "M 6.5 1.5 L 2.5 5 L 6.5 8.5" : "M 3.5 1.5 L 7.5 5 L 3.5 8.5";
    stroke: #8b8c85;
    stroke-width: 1.3px;
    fill: transparent;
}

component IconDown inherits Path {
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: #b6b2a4;
    stroke-width: 1.6px;
    fill: transparent;
}

component IconCaret inherits Path {
    in property <bool> up;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: up ? "M 2 6.5 L 5 3.5 L 8 6.5" : "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: #7a7c72;
    stroke-width: 1.3px;
    fill: transparent;
}

component IconSend inherits Path {
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 6 10.5 L 6 2 M 2.2 5.8 L 6 2 L 9.8 5.8";
    stroke: #12130f;
    stroke-width: 1.6px;
    fill: transparent;
}

component IconCheck inherits Path {
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 1.8 5.4 L 4 7.6 L 8.2 2.6";
    stroke: #a18e41;
    stroke-width: 1.4px;
    fill: transparent;
}

component IconPencil inherits Path {
    width: 11px;
    height: 11px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 2 8.2 L 2 10 L 3.8 10 L 10 3.8 L 8.2 2 Z";
    stroke: #8b8c85;
    stroke-width: 1.1px;
    fill: transparent;
}

component IconAlert inherits Path {
    width: 14px;
    height: 14px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: "M 7 3.5 L 7 8.0 M 7 9.5 L 7 10.5";
    stroke: #f3ded8;
    stroke-width: 2px;
    fill: transparent;
}

component StatusDot inherits Rectangle {
    in property <string> status;
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background: status == "working" ? #a18e41 : status == "parked" ? #4a4d44 : #6f9f5f;
}

component SessionRow inherits Rectangle {
    in property <SessionItem> item;
    in property <bool> selected;
    in property <bool> editing;
    in-out property <string> draft;
    callback picked(string);
    callback hovered(string);
    callback edit(string);
    callback commit(string, string);

    height: 32px;
    border-radius: 6px;
    background: selected ? #1d1e19 : (ta.has-hover ? #171814 : transparent);

    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 30px;
        height: 100%;
        clicked => { root.picked(root.item.id); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered(root.item.tip);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            clip: true;

            if !root.editing : Text {
                text: root.item.name;
                color: root.selected ? #e7e5df : #b0b1a8;
                font-size: 12px;
                height: parent.height;
                vertical-alignment: center;
                x: ta.has-hover && root.item.scroll > 0px ? -root.item.scroll : 0px;
                animate x { duration: 1.8s; easing: ease-in-out; }
            }

            if root.editing : input := TextInput {
                text: root.draft;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                color: #e7e5df;
                font-size: 12px;
                single-line: true;
                edited => { root.draft = self.text; }
                accepted => { root.commit(root.item.id, root.draft); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.commit(root.item.id, root.item.full);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                init => { self.focus(); }
            }
        }

        Rectangle {
            width: 18px;
            height: 32px;
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: edit-touch.has-hover ? #2a2c24 : #1d1e19;
                visible: !root.editing;
                opacity: ta.has-hover || edit-touch.has-hover ? 1 : 0;
                animate opacity { duration: 100ms; }
                IconPencil {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                edit-touch := TouchArea {
                    enabled: !root.editing;
                    clicked => { root.edit(root.item.id); }
                }
            }
        }

        Rectangle {
            width: age-text.preferred-width;
            height: 32px;
            age-text := Text {
                text: root.item.age;
                color: #565a4f;
                font-size: 10px;
                height: parent.height;
                vertical-alignment: center;
                opacity: root.editing ? 0 : 1;
            }
        }

        Rectangle {
            width: 5px;
            height: 32px;
            StatusDot {
                y: (parent.height - self.height) / 2;
                status: root.item.status;
                opacity: root.editing ? 0 : 1;
            }
        }
    }
}

component TranscriptRow inherits VerticalLayout {
    spacing: 0px;
    property <bool> err-hover: false;

    in property <TRow> data;
    callback toggle();

    if data.kind == 0 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            background: #2e2916;
            border-radius: 10px;
            width: min(self.preferred-width, 560px);
            height: self.preferred-height;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                StyledText {
                    text: data.body;
                    default-color: #e7e5df;
                    default-font-size: 13px;
                    link-color: #a18e41;
                }
            }
        }
    }

    if data.kind == 1 : Rectangle {
        height: agent-text.preferred-height + 12px;
        agent-text := StyledText {
            x: 24px;
            y: 6px;
            width: parent.width - 48px;
            text: data.body;
            default-color: #d2d1ca;
            default-font-size: 13px;
            link-color: #a18e41;
        }
    }

    if data.kind == 2 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            width: self.preferred-width;
            height: 24px;
            border-radius: 6px;
            background: think-touch.has-hover ? #1a1b17 : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text { text: "thinking"; color: #6b6c65; font-size: 10px; vertical-alignment: center; }
                Text { text: data.meta; color: #4a4d44; font-size: 10px; vertical-alignment: center; }
                Rectangle {
                    width: 10px;
                    height: 24px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }
            }
            think-touch := TouchArea { clicked => { root.toggle(); } }
        }

        if data.expanded : Rectangle {
            background: #0f100d;
            border-color: #1e201a;
            border-width: 1px;
            border-radius: 8px;
            height: min(think-text.preferred-height + 24px, 6 * think-probe.preferred-height + 24px);
            think-probe := Text {
                x: -200px;
                y: 0px;
                text: "x";
                font-family: "Cascadia Code";
                font-size: 11px;
                opacity: 0;
            }
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    think-text := StyledText {
                        text: data.body;
                        default-color: #7e8076;
                        default-font-family: "Cascadia Code";
                        default-font-size: 11px;
                    }
                }
            }
        }
    }

    if data.kind == 3 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            height: 26px;
            border-radius: 6px;
            background: data.failed
                ? (cell-hot ? #241713 : #1d1412)
                : (cell-hot ? #181a14 : #14160f);

            property <bool> cell-hot: cell-touch.has-hover || root.err-hover;

            cell-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                clicked => { root.toggle(); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;

                Rectangle {
                    width: 10px;
                    height: 26px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }

                Text {
                    text: data.title;
                    color: data.failed ? #c98a7f : #8b8c85;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text { text: data.meta; color: #4a4d44; font-size: 10px; vertical-alignment: center; }

                if data.failed : Rectangle {
                    width: 14px;
                    height: 26px;
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: err-touch.has-hover ? #8d4235 : #6b342b;
                        IconAlert { x: 0; y: 0; }
                        err-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            changed has-hover => { root.err-hover = self.has-hover; }
                        }
                    }
                }
            }

            if data.failed && root.err-hover : Rectangle {
                x: parent.width - self.width - 4px;
                y: 28px;
                width: self.preferred-width;
                max-width: 320px;
                height: self.preferred-height;
                max-height: 4 * reason-line.preferred-height + 16px;
                background: #1d1412;
                border-color: #6b342b;
                border-width: 1px;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: data.reason;
                        color: #e0b6ad;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
                reason-line := Text {
                    x: -400px;
                    text: "x";
                    font-size: 10px;
                    opacity: 0;
                }
            }
        }

        if data.expanded : Rectangle {
            background: #0f100d;
            border-color: #23251f;
            border-width: 1px;
            border-radius: 8px;
            height: self.preferred-height;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                StyledText {
                    text: data.code;
                    default-color: #cfd3c8;
                    default-font-family: "Cascadia Code";
                    default-font-size: 12px;
                }
                if data.has-output : Rectangle {
                    height: 1px;
                    background: #1e201a;
                }
                if data.has-output : StyledText {
                    text: data.output;
                    default-color: data.failed ? #c98a7f : #8f9187;
                    default-font-family: "Cascadia Code";
                    default-font-size: 11px;
                }
            }
        }
    }

    if data.kind == 5 : HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: data.title;
            color: #4a4d44;
            font-size: 10px;
        }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback toggled;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: ct.has-hover || open ? #1d1e19 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Text { text: root.label; color: #8b8c85; font-size: 10px; vertical-alignment: center; }
        Rectangle {
            width: 10px;
            height: 24px;
            IconCaret {
                y: (parent.height - self.height) / 2;
                up: root.open;
            }
        }
    }
    ct := TouchArea { clicked => { root.toggled(); } }
}

export component AppWindow inherits Window {
    title: "prime-agent";
    // no fixed width/height: a fixed size leaves the new area blank when the
    // user resizes the window, because the root keeps its declared size
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 820px;
    background: #12130f;
    default-font-family: "Segoe UI";

    in property <[SessionItem]> sessions;
    in property <[TRow]> transcript;
    in property <[ModelItem]> models;
    in property <length> menu-width: 180px;
    in-out property <string> model-id;
    in-out property <string> model-label: "model";
    in-out property <string> title-text: "";
    in-out property <string> draft: "";
    in-out property <string> composer-text: "";
    in-out property <int> queued-count: 0;
    in-out property <string> queued-preview: "";
    in-out property <float> context-fill: 0.0;
    // composer input height; the pill on its top border toggles it
    in-out property <length> composer-height: 68px;
    // input + box chrome (10+8 padding, 10 spacing, 24 button row, 2 borders)
    // + strip (24) + band padding (8+10)
    // 13px text is ~17px per line: 4 lines by default, 10 at most
    out property <length> composer-min: 68px;
    out property <length> composer-max: 170px;
    // the band is exactly the box plus the 12px pad under it; the queue line
    // and the jump control live elsewhere, so nothing else needs reserving
    out property <length> composer-total: root.box-height + 12px;
    // box chrome around the input: 10+8 padding, 10 spacing, 24 button row, 2 borders
    out property <length> box-height: root.composer-height + 54px;
    in-out property <bool> dragging: false;
    // the band's height at press time: frozen for the gesture so the drag
    // origin (and the clamp on mouse-y) cannot move under the pointer
    in-out property <length> band-freeze: 0px;
    in-out property <length> last-pointer-y: 0px;
    in-out property <length> drag-start-y: 0px;
    in-out property <length> drag-start-h: 0px;
    in-out property <string> context-text: "";
    in-out property <string> stats-text: "";
    in-out property <bool> ctx-hover: false;
    in-out property <string> editing-id: "";
    in property <string> status-line: "connecting";
    in-out property <string> hover-title: "";
    in-out property <bool> rail-open: true;
    in-out property <bool> model-menu: false;
    in-out property <string> selected-id;

    in property <bool> activity-busy: false;
    in property <string> activity: "idle";
    in property <string> activity-elapsed: "";

    in property <bool> busy: false;
    in property <string> busy-label: "";
    in property <string> busy-elapsed: "";
    in property <string> spinner-frame: "\u{280b}";
    in property <float> shimmer: 0.0;

    callback send-requested(string);
    callback steer-requested(string);
    callback abort-requested();
    callback model-picked(string, string);
    callback rename-requested(string, string);
    callback toggle-row(int);

    // true while the reader is parked at the newest row; a new row then pulls
    // the view along, and scrolling up turns it off
    in-out property <bool> follow-bottom: true;
    // derived from the scroll offset, so it tracks wheel scrolling without
    // relying on change notifications from the ListView
    out property <length> dbg-cy: transcript-list.content-y;
    out property <length> dbg-ch: transcript-list.content-height;
    out property <length> dbg-h: transcript-list.height;
    out property <bool> at-bottom: transcript-list.content-y <= -root.scroll-range + 80px;

    // how far the transcript can travel; content-y is the *offset* of the
    // content, negative once you scroll down, so this is what it bottoms out at
    out property <length> scroll-range: max(
        0px,
        transcript-list.content-height - transcript-list.height
    );

    public function scroll-to-end() {
        root.follow-bottom = true;
        transcript-list.content-y = -root.scroll-range;
    }

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: #10110e;

            Rectangle {
                x: 8px;
                y: 9px;
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: rail-touch.has-hover ? #1d1e19 : transparent;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        IconRail { open: root.rail-open; }
                    }
                }
                rail-touch := TouchArea { clicked => { root.rail-open = !root.rail-open; } }
            }

            Text {
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
                text: root.status-line;
                color: #565a4f;
                font-size: 10px;
            }
        }

        HorizontalLayout {
            if root.rail-open : Rectangle {
                width: 232px;
                background: #10110e;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 18px;
                        padding-left: 8px;
                        Text { text: "sessions"; color: #565a4f; font-size: 10px; vertical-alignment: center; }
                    }
                    ListView {
                        for item in root.sessions : SessionRow {
                            item: item;
                            selected: item.id == root.selected-id;
                            editing: item.id == root.editing-id;
                            draft <=> root.draft;
                            picked(id) => { root.selected-id = id; }
                            hovered(full) => { root.hover-title = full; }
                            edit(id) => { root.editing-id = id; root.draft = item.full; }
                            commit(id, name) => {
                                root.editing-id = "";
                                root.rename-requested(id, name);
                            }
                        }
                    }
                }
            }

            // explicit geometry: a Rectangle's preferred size never reflects its
            // children in Slint, so a layout here always under-measured the
            // composer and let it spill past the window
            center-column := Rectangle {

                    transcript-area := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - busy-row.height - root.composer-total;
                        background: #12130f;

                        area-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move {
                                    root.hover-title = "";
                                }
                            }
                        }

                        transcript-list := ScrollView {
                            // explicit geometry: without it the view sizes itself to its
                            // content, its viewport height equals the content height, and
                            // there is no scroll range at all
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                for item[i] in root.transcript : TranscriptRow {
                                    data: item;
                                    toggle => { root.toggle-row(i); }
                                }
                            }
                        }

                        // floating just above the status row, aligned with the
                    // context ring: detached from the composer
                    if !root.at-bottom : Rectangle {
                        x: transcript-area.width - self.width - 22px;
                        y: transcript-area.height - self.height - 10px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: jump-touch.has-hover ? #2e3026 : #1b1d18;
                        border-color: #34372e;
                        border-width: 1px;
                        IconDown {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        jump-touch := TouchArea {
                            clicked => { root.scroll-to-end(); }
                            mouse-cursor: pointer;
                        }
                    }

                    if root.hover-title != "" : Rectangle {
                            x: 20px;
                            y: 10px;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            min-width: 90px;
                            max-width: 240px;
                            background: #171814;
                            border-color: #2a2c24;
                            border-width: 1px;
                            border-radius: 8px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 7px;
                                padding-bottom: 7px;
                                Text {
                                    text: root.hover-title;
                                    color: #d9d8d1;
                                    font-size: 11px;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // live status row: TUI-style — one cell size for glyph and label
                    // always present: an `if`-created subtree got no hover tracking

                    busy-row := Rectangle {
                        x: 0;
                        y: transcript-area.height;
                        width: parent.width;
                        height: root.busy ? 26px : 0px;

                        spin := Text {
                            x: 24px;
                            visible: root.busy;
                            text: root.spinner-frame;
                            color: #c9a86a;
                            font-family: "Cascadia Code";
                            font-size: 19px;
                            height: parent.height;
                            vertical-alignment: center;
                        }

                        lbl := Text {
                            x: spin.x + spin.width + 4px;
                            visible: root.busy;
                            text: root.busy-label;
                            color: #c9a86a;
                            font-family: "Cascadia Code";
                            font-size: 11px;
                            height: parent.height;
                            vertical-alignment: center;
                        }

                        Text {
                            x: lbl.x + lbl.width + 8px;
                            visible: root.busy;
                            text: root.busy-elapsed;
                            color: #565a4f;
                            font-family: "Cascadia Code";
                            font-size: 11px;
                            height: parent.height;
                            vertical-alignment: center;
                        }

                        // how much of the context window the turn is using
                        ctx := Rectangle {
                            visible: root.busy;
                            x: parent.width - self.width - 22px;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;

                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 10.00 4.00 L 10.00 1.30";
                                    stroke: 0.0000 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 11.55 4.20 L 12.25 1.60";
                                    stroke: 0.0417 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
