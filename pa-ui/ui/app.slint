import { ListView, ScrollView } from "std-widgets.slint";
import { DraftEditor } from "draft-editor.slint";
import { MarqueeText } from "marquee-text.slint";
import { IconChevronDown, IconNewChat, IconPlus, IconSearch, IconSend, PanelIcon, PrimeAgentMark } from "icons.slint";
import { EffortItem, ModelGroup, QueueItem, SearchRow, SessionEntry, SessionItem, SessionMenuItem, SlashItem, ThemeItem, TRow, Type } from "types.slint";
import { QueueRow, QueueRowUp, TranscriptRow } from "transcript.slint";
import { SessionGroupHeader, SessionRow as SidebarRow } from "sidebar.slint";
import { ActivityChip, Chip, ContextCard, ContextRing } from "composer.slint";
import { EffortLadder, ModelMenu, SessionMenu, SlashMenu } from "menus.slint";
import { SettingsPopup } from "settings.slint";
import { SearchPopup } from "search.slint";
import { SharePopup } from "share.slint";
import { TitleBar } from "chrome.slint";
import { StatusStrip } from "status-strip.slint";
import { Button, ButtonKind, Panel, PanelButton } from "primitives.slint";
// The theme global lives in its own source, next to nothing else. It is
// re-exported here because the window's Rust side reaches it through this
// file: only a global the compiled file exports becomes a global in Rust.
import { Theme } from "theme.slint";
export { Theme }

export component AppWindow inherits Window {
    // the failure reason of a cell, drawn here so no row can paint over it
    in-out property <bool> reason-open;
    in-out property <length> reason-x;
    in-out property <length> reason-y;
    in-out property <string> reason-text;
    title: "Prime Agent Desktop";

    // the custom title bar, driven from src/titlebar.rs
    callback titlebar-minimize();
    callback titlebar-close();
    in-out property <bool> titlebar-maximized: false;
    in-out property <bool> titlebar-max-hover: false;

    // The drag surface is the whole window, so the pointer can never leave it
    // mid-drag, and it measures the pointer in window coordinates: anchored to
    // the composer box it moved as the box grew, which is what made the drag
    // stutter and lose the pointer.
    drag-surface := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: root.handle-hover || root.dragging ? MouseCursor.row-resize
            : MouseCursor.default;
        // a click that lands on nothing in particular dismisses the model menu
        clicked => { root.model-menu = false; root.queue-open = false; root.settings-menu = false; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-moved();
            }
            if event.kind == PointerEventKind.down {
                // only the handle starts a drag; the rest of the band belongs
                // to the chip and the model menu
                if root.handle-hover {
                    root.dragging = true;
                    root.band-freeze = root.composer-total;
                    root.last-pointer-y = drag-surface.mouse-y;
                }
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
            if event.kind == PointerEventKind.move && root.dragging {
                let step = root.last-pointer-y - drag-surface.mouse-y;
                root.last-pointer-y = drag-surface.mouse-y;
                if step > -60px && step < 60px {
                    root.composer-height = clamp(
                        root.composer-height + step,
                        root.composer-min,
                        root.composer-max
                    );
                }
            }
        }
    }

    // no fixed width/height: a fixed size leaves the new area blank when the
    // user resizes the window, because the root keeps its declared size
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 820px;
    background: Theme.window-surface;
    default-font-family: "Segoe UI";

    // The rows, in group order: active, idle, done. The section property below
    // reads this list; nothing else writes it.
    in property <[SessionItem]> sessions;
    in property <[TRow]> transcript;
    in property <[ModelGroup]> model-groups;
    // how tall the menu needs to be for the groups that are open
    in-out property <length> model-menu-height: 0px;
    in-out property <string> model-provider: "";
    in-out property <string> model-id;
    // the running model's thinking level: the wire word (`max`) and the name
    // the menu shows (`Max`)
    in-out property <string> current-effort;
    in-out property <string> current-level;
    out property <length> box-x: composer-box.absolute-position.x;
    out property <length> box-y: composer-box.absolute-position.y;
    out property <length> box-w: composer-box.width;
    // the effort submenu: open while a hovered row has a ladder to choose from
    in-out property <bool> effort-open: false;
    in-out property <length> effort-y: 0px;
    in-out property <[EffortItem]> effort-items;
    in-out property <string> model-label: "model";
    in-out property <string> draft: "";
    in-out property <string> composer-text: "";
    // The command word, drawn in the accent in front of the caret: it stays gold
    // while the argument is typed, which a single-colour text box cannot do for
    // one word out of many.
    in-out property <string> composer-command: "";
    in-out property <length> command-word-width: 0px;
    // where the caret should land once new text has arrived (byte offset)
    in-out property <int> composer-caret-request: -1;
    // canvas mode (PA_CANVAS=1): the words are painted by Rust so a command can be
    // gold wherever it sits; off, everything behaves as it always has
    in-out property <bool> canvas-mode: false;
    in property <image> composer-canvas;
    in-out property <length> composer-canvas-height: 18px;
    in-out property <length> composer-caret-x: 0px;
    in-out property <length> composer-caret-y: 0px;
    in-out property <length> composer-caret-height: 18px;
    out property <int> composer-caret: draft-window.caret-offset;
    out property <int> composer-anchor: draft-window.anchor-offset;
    out property <length> composer-width: draft-window.width;
    // The command menu: every builtin the daemon knows, narrowed by what is
    // typed after the slash. It answers keys before the composer does, so Enter
    // picks the highlighted command instead of sending half a word.
    in-out property <[SlashItem]> slash-items;
    in-out property <bool> slash-open: false;
    in-out property <int> slash-index: 0;
    // the menu takes the keys it wants before the message box sees them
    public function slash-take(event: KeyEvent) -> bool {
        if !root.slash-open || root.slash-items.length == 0 {
            return false;
        }
        if event.text == Key.DownArrow {
            root.slash-move(1);
            return true;
        }
        if event.text == Key.UpArrow {
            root.slash-move(-1);
            return true;
        }
        if event.text == Key.Escape {
            root.slash-dismiss();
            return true;
        }
        if event.text == Key.Return || event.text == Key.Tab {
            root.slash-accept();
            return true;
        }
        false
    }
    in-out property <int> queued-count: 0;
    // the two lanes, kept apart: one runs inside this turn, one after it
    in property <[QueueItem]> queued-steering;
    in property <[QueueItem]> queued-followup;
    in-out property <bool> queue-open: false;
    // the queue panel's geometry, in one place: its rows are stacked by
    // arithmetic, and every y below is a sum of these
    out property <length> q-head-in: root.queued-steering.length > 0 ? 20px : 0px;
    out property <length> q-rows-in: root.queued-steering.length * 34px;
    out property <length> q-head-next: root.queued-followup.length > 0 ? 20px : 0px;
    out property <length> q-rows-next: root.queued-followup.length * 34px;
    out property <length> q-lane-gap: root.queued-steering.length > 0
        && root.queued-followup.length > 0 ? 8px : 0px;
    out property <length> q-content-h: root.q-head-in + root.q-rows-in + root.q-lane-gap
        + root.q-head-next + root.q-rows-next + 24px;
    out property <length> q-scroll-h: min(root.q-content-h, 288px);
    in-out property <float> context-fill: 0.0;
    // composer input height; the pill on its top border toggles it
    in-out property <length> composer-height: 68px;
    in-out property <[image]> attachment-images: [];
    // 44px tiles plus the layout's 10px spacing plus a hairline of slack
    out property <length> attach-h: root.attachment-images.length > 0 ? 62px : 0px;
    animate attach-h { duration: 170ms; easing: ease-out; }
    // input + box chrome (10+8 padding, 10 spacing, 24 button row, 2 borders)
    // + strip (24) + band padding (8+10)
    // 13px text is ~17px per line: 4 lines by default, 10 at most
    out property <length> composer-min: 68px;
    out property <length> composer-max: 170px;
    // The band is the box plus the 12px pad under it; the chip sits above the box
    // and the queue line lives in the strip, so nothing else is reserved here.
    // The popup is drawn at the window root (a child at negative y paints but
    // cannot be hit), so it anchors off this.
    // The strip grows open and shuts fast; everything that moves with it reads
    // this one length. It also opens while anything is queued, even after the
    // turn that queued it has ended.
    in-out property <length> busy-h: root.busy || root.queued-count > 0 ? 26px : 0px;
    animate busy-h {
        duration: root.busy ? 190ms : 110ms;
        easing: root.busy ? ease-out : ease-in;
    }
    // the contents come in a beat after the gap opens, and go before it shuts
    in-out property <float> busy-fade: root.busy || root.queued-count > 0 ? 1.0 : 0.0;
    animate busy-fade {
        duration: root.busy ? 150ms : 90ms;
        delay: root.busy ? 60ms : 0ms;
        easing: ease-out;
    }
    out property <length> composer-total: root.box-height + 46px + root.busy-h;
    // box chrome around the input: 10+8 padding, 10 spacing, 24 button row, 2 borders
    out property <length> box-height: root.composer-height + 54px + root.attach-h;
    in-out property <bool> dragging: false;
    // where the handle actually sits, in window coordinates: the drag surface
    // is the whole window, so the press has to be tested against it
    out property <length> handle-cy: composer-band.absolute-position.y + 34px + root.busy-h;
    out property <length> handle-cx: composer-band.absolute-position.x + composer-band.width / 2;
    out property <bool> handle-hover: drag-surface.has-hover
        && abs(drag-surface.mouse-x - root.handle-cx) <= 48px
        && abs(drag-surface.mouse-y - root.handle-cy) <= 9px;
    // the band's height at press time: frozen for the gesture so the drag
    // origin (and the clamp on mouse-y) cannot move under the pointer
    in-out property <length> band-freeze: 0px;
    in-out property <length> last-pointer-y: 0px;
    in-out property <string> context-text: "";
    in-out property <string> ctx-percent: "";
    in-out property <string> stat-messages: "";
    in-out property <string> stat-tools: "";
    in-out property <string> stat-in: "";
    in-out property <string> stat-out: "";
    in-out property <string> stat-cache: "";
    in-out property <string> cost-session: "";
    in-out property <string> cost-family: "";
    in-out property <bool> cost-family-on: false;
    in-out property <bool> ctx-hover: false;
    // The activity chip's live counts: running subagent descendants, scoped
    // heartbeats, and running shell commands for the selected Session.
    in-out property <int> activity-subagents: 0;
    in-out property <int> activity-heartbeats: 0;
    in-out property <int> activity-shells: 0;
    in-out property <string> editing-id: "";
    in-out property <string> hover-title: "";
    in-out property <length> hover-y: 0px;
    in-out property <bool> tooltip-on: false;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> open-sidebar-tip: false;
    // The right-hand column. It is blank on purpose: the shell exists and nothing
    // lives in it yet.
    in-out property <bool> right-open: false;
    in-out property <bool> model-menu: false;
    in-out property <bool> settings-menu: false;
    in-out property <string> settings-page: "general";
    in-out property <string> settings-query: "";
    in-out property <int> settings-focus-tick: 0;
    in-out property <string> settings-open-choice: "";
    in-out property <bool> themes-open: true;
    in-out property <[ThemeItem]> theme-items;
    in-out property <string> setting-thread-notifications: "Off";
    in-out property <bool> setting-in-app-notifications: true;
    in-out property <string> setting-session-order: "Last used";
    in-out property <bool> setting-confirm-quit: false;
    in-out property <bool> setting-confirm-delete-session: true;
    in-out property <string> setting-queue-key: "Ctrl+Enter";
    in-out property <bool> setting-reopen-last-session: true;
    in-out property <string> setting-interface-size: "Default";
    in-out property <string> setting-code-font: "Cascadia Code";
    in-out property <string> setting-row-spacing: "Comfortable";
    in-out property <bool> setting-show-timestamps: false;
    in-out property <bool> setting-reduce-motion: false;
    in-out property <bool> settings-show-notifications: true;
    in-out property <bool> settings-show-sidebar: true;
    in-out property <bool> settings-show-confirmations: true;
    in-out property <bool> settings-show-behavior: true;
    in-out property <bool> settings-show-theme: true;
    in-out property <bool> settings-show-typography: true;
    in-out property <bool> settings-show-density: true;
    callback theme-picked(string);
    callback setting-toggled(string);
    callback setting-chosen(string, string);
    callback settings-search-edited(string);
    callback settings-toggle-requested();
    callback settings-closed();

    public function toggle-settings-choice(key: string) {
        root.settings-open-choice = root.settings-open-choice == key ? "" : key;
    }

    public function dismiss-settings-choice() {
        root.settings-open-choice = "";
    }

    callback selection-picked(string);
    callback wake();
    callback scroll-paging();
    callback attachment-ready();
    in-out property <string> selected-id;
    in-out property <bool> draft-chat;
    in-out property <int> draft-generation: 0;
    in-out property <bool> draft-model-picked;
    in-out property <string> draft-level;
    in-out property <string> draft-cwd;
    // The sidebar's groups: the rows of each, in the order they are drawn, and
    // which of the three the reader has folded. The window fills all three from
    // the one session list (src/sessions.rs `session_items`), so a row's group
    // and the group it is drawn under are decided in one place and cannot
    // disagree.
    in-out property <[SessionItem]> active-items;
    in-out property <[SessionItem]> idle-items;
    in-out property <[SessionItem]> done-items;
    // Which of the three groups the reader has folded. One bool per group rather
    // than a list: a binding cannot call a function that writes.
    in-out property <bool> active-folded: false;
    in-out property <bool> idle-folded: false;
    in-out property <bool> done-folded: false;
    // The session menu: which row opened it, and where its dots were. The items
    // are filled when the dots open, from what that row is.
    in-out property <string> menu-id: "";
    in-out property <[SessionMenuItem]> menu-items;
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    // a row's dots opened its menu: the window fills `menu-items` from what that
    // row is, since the item set depends on whether it has a worker
    callback session-menu-opened(string);
    callback menu-closed();

    // The three groups, drawn in the daemon's order, as one flat list: a header
    // or a row, each with the vertical position the window computed for it.
    //
    // Flat on purpose. Slint's `ScrollView`, `VerticalLayout` and conditional
    // elements all rewrite the children's sizes and positions, and every attempt
    // to place three nested sections that way left rows drawn in the wrong
    // place or off the bottom of the window. One list, each entry at a `y` the
    // writer already knows, keeps the sidebar's geometry in one place.
    in property <[SessionEntry]> session-entries: [];
    // the height of that list, header by header and row by row: the scroll view
    // takes it as its content height, and the window writes both
    in-out property <length> sessions-height: 0px;
    // A fold in flight. The window answers a header click with the rows held
    // where they are listed plus the y each settles at; `fold-mix` then runs
    // from 0 to 1 (opening) or 1 to 0 (closing), and the rows and the group's
    // box both follow it.
    in-out property <length> prev-sessions-height: 0px;
    in-out property <bool> fold-open: false;
    in-out property <int> fold-index: -1;
    in-out property <bool> fold-flip: false;
    in-out property <float> fold-mix: 0.0;
    out property <float> fold-progress: root.fold-flip ? root.fold-mix : (1.0 - root.fold-mix);
    out property <length> animated-sessions-height:
        root.splice-at.length > 0
            ? (root.prev-sessions-height + (root.sessions-height - root.prev-sessions-height) * root.fold-progress)
            : root.sessions-height;
    // the y every entry started from before the fold, or empty when at rest
    in property <[float]> splice-at: [];

    animate fold-mix {
        duration: 220ms;
        easing: ease-in-out;
    }

    public function trigger-list-anim() {
        root.fold-flip = !root.fold-flip;
        root.fold-mix = root.fold-flip ? 1.0 : 0.0;
    }

    // Where the entry at `index` is drawn: headers and whole groups slide from
    // `splice-at[index]` to `entry.at`; the rows inside the group being folded
    // keep their natural 32px spacing (`entry.target`) and rise 18px into the
    // header as the group closes.
    pure public function row-y(index: int) -> length {
        let entry = root.session-entries[index];
        if !entry.is-header && root.fold-index == entry.seam && root.splice-at.length > 0 {
            let open-fac = root.fold-open ? root.fold-progress : (1.0 - root.fold-progress);
            return entry.target - 18px * (1.0 - open-fac);
        }
        if index < 0 || index >= root.splice-at.length {
            return entry.at;
        }
        let from = root.splice-at[index] * 1px;
        from + (entry.at - from) * root.fold-progress
    }

    // How many rows the fold in flight moves. A per-row Opacity item costs a
    // layer, so only fade a group small enough to afford one layer per row.
    pure public function fold-size() -> int {
        if root.fold-index == 0 { return root.active-items.length; }
        if root.fold-index == 1 { return root.idle-items.length; }
        if root.fold-index == 2 { return root.done-items.length; }
        return root.session-entries.length;
    }

    // Opacity for the rows of the group being folded, and for rows that arrived
    // in a new group (fold-index == -2), which fade in as they slide.
    pure public function row-opacity(index: int) -> float {
        let entry = root.session-entries[index];
        if root.fold-index == entry.seam && root.splice-at.length > 0 {
            return root.fold-open ? root.fold-progress : (1.0 - root.fold-progress);
        }
        if entry.folded {
            return 0.0;
        }
        if root.fold-index == -2 && index >= 0 && index < root.splice-at.length {
            let diff = abs(entry.at - root.splice-at[index] * 1px);
            if diff > 1px {
                return 0.25 + 0.75 * root.fold-progress;
            }
        }
        1.0
    }

    // The opacity a row wrapper paints with. A per-row Opacity item costs a
    // layer, so a large fold skips the fade and rides the slide alone; small
    // folds keep the fade they can afford.
    pure public function row-fade(index: int) -> float {
        root.fold-size() > 12 ? 1.0 : root.row-opacity(index)
    }

    // A row is drawn at 32px while it is at all, and not at all once its group
    // is folded shut. Large folds have no fade to reveal the moment a row
    // should leave, so they use the fold's endpoints instead of its opacity.
    pure public function row-h(index: int) -> length {
        let entry = root.session-entries[index];
        if root.fold-size() > 12 {
            if !entry.is-header && root.fold-index == entry.seam && root.splice-at.length > 0 {
                let shown = root.fold-open
                    ? root.fold-progress > 0.0
                    : root.fold-progress < 1.0;
                return shown ? 32px : 0px;
            }
            return entry.folded ? 0px : 32px;
        }
        root.row-opacity(index) > 0.01 ? 32px : 0px
    }

    public function group-toggled(label: string) {
        if label == "Active" {
            root.active-folded = !root.active-folded;
        } else if label == "Idle" {
            root.idle-folded = !root.idle-folded;
        } else {
            root.done-folded = !root.done-folded;
        }
        // the positions are a function of the fold state, so the list is rebuilt
        // from the same three arrays
        root.fold-changed();
    }

    // the window listens to this and recomposes `session-entries` from the
    // three item lists plus the fold state
    callback fold-changed();

    // The session search: whether it is open, the field's text, the row the
    // arrows or the pointer are on, and the rows themselves. The rows are worked
    // out in Rust, so the window draws a match it was handed rather than making
    // one of its own.
    in-out property <bool> search-open: false;
    // Counts the times the window has asked for the caret to be put in the
    // popup's field: Rust cannot reach the field directly while the popup lives
    // inside an `if`, and this is the one thing a change can be hung on.
    in-out property <int> search-focus-tick: 0;
    in-out property <string> search-query: "";
    in-out property <int> search-index: 0;
    in-out property <[SearchRow]> search-rows;
    // The least room the panel keeps between itself and the title bar above it,
    // and between itself and the window's side.
    private property <length> search-clearance: 48px;

    // Opening: the highlight goes to the best row and Rust fills the rows. The
    // window draws the popup the moment `search-open` rises, and Rust raises it
    // only after the rows are in, so the popup never shows a blank panel that
    // fills in a frame later.
    public function open-requested() {
        root.search-open-requested();
    }

    // The popup's field was typed into, so the window stops handing every
    // unrelated word back to the caret's last owner.
    public function search-field-used() { root.search-field-typed = true; }

    // A press that lands outside the popup. The popup's strips cover the whole
    // window while it is up, so this only ever hears a press on the window
    // itself. It closes the way Escape does, through the same callback.
    public function search-outside() { root.search-closed(); }

    callback search-open-requested();

    // The window works this out itself for the keys: everything typed while a
    // popup is up belongs to its field, wherever the caret last was.
    in-out property <bool> search-field-typed: false;
    callback search-typed(string);
    callback search-picked(string);
    callback search-closed();
    // Ctrl+K anywhere the window has focus opens the popup, and so does the
    // magnifier in the column's header. What counts as the chord is decided in
    // Rust, where it has tests: the toolkit reports a chord as the character it
    // makes, and a rule that is wrong here fails silently.
    pure callback opens-search(string, bool, bool) -> bool;
    public function search-key(event: KeyEvent) -> bool {
        if root.opens-search(event.text, event.modifiers.control, root.search-open) {
            root.open-requested();
            return true;
        }
        false
    }

    // The share card: what "Share as gist" produced. The menu opens it before the
    // upload starts, so the reader sees that something is happening even when
    // the GitHub CLI is slow, and it stays up with the viewer URL the moment the
    // gist exists. `share-copied` says whether the window managed to put the
    // link on the clipboard; the card's Copy control always offers a second try.
    in-out property <bool> share-open: false;
    in-out property <bool> share-pending: false;
    in-out property <string> share-url: "";
    in-out property <string> share-error: "";
    in-out property <string> share-action-error: "";
    in-out property <bool> share-copied: false;
    callback share-copy-requested();
    callback share-open-link-requested();
    callback share-dismissed();


    in property <bool> busy: false;
    callback busy-changed(bool);
    changed busy => { root.busy-changed(self.busy); }
    in property <string> busy-label: "";
    in property <string> busy-elapsed: "";
    in property <string> spinner-frame: "\u{280b}";

    callback send-requested(string);
    // the command menu: what is typed after the slash, moving the highlight, and
    // taking the highlighted command
    callback slash-typed(string, int);
    callback slash-move(int);
    callback slash-accept();
    callback slash-dismiss();
    callback composer-command-cleared();
    callback steer-requested(string);
    callback abort-requested();
    // images ride beside the text: the strip is the attachment list, and the
    // prompt carries whatever is in it when the message is sent
    callback attach-requested();
    callback attach-pasted() -> bool;
    callback attachment-removed(int);
    callback model-picked(string, string);
    // a row's effort ladder: which model, and the row's window y to hang from
    callback model-hovered(string, string, length);
    // the pointer is somewhere that is neither a model row nor its ladder:
    // the popup has no reason to stay
    callback pointer-moved();
    // the pointer is on the ladder itself, which keeps it alive
    callback effort-hovered();
    callback effort-picked(int);
    callback model-menu-opened;
    callback provider-toggled(string);
    callback rename-requested(string, string);
    // A session row's menu, taken: the row's id and the action's key.
    callback session-menu-picked(string, string);
    callback toggle-row(int);
    callback queue-act(string, int, string);
    callback queue-clear();
    callback new-chat();
    // 0 while idle, 1 while a run is in flight: the one clock the send button's
    // two marks share
    // Stop is only the button's job while the composer is empty. The moment you
    // type, the same control becomes send again, and sending while a turn runs
    // queues the message instead of interrupting it.
    in-out property <bool> composer-has-text: false;
    out property <bool> stop-mode: root.busy && !root.composer-has-text;
    in-out property <float> stop-mix: root.stop-mode ? 1.0 : 0.0;
    animate stop-mix { duration: 240ms; easing: ease-in-out; }
    // the composer taking the caret is "somewhere else" too

    // A latch, not a measurement: while it is true a new row pulls the view
    // along; the moment the reader touches the wheel or the bar it is false, and
    // nothing can turn it back on except the reader arriving at the floor again.
    // Deriving it from "how close to the bottom am I" every frame is what let a
    // token arriving 16 ms after a drag started yank the page back down.
    in-out property <bool> follow-bottom: true;
    // true from the moment the bar is grabbed until it is let go
    in-out property <bool> scrollbar-dragging: false;
    // the last offset we saw, so a step *towards the top* can be told apart from
    // content growing at the bottom
    in-out property <length> seen-content-y: 0px;
    // set when the reader moves up, cleared only when they are back on the floor
    in-out property <bool> reader-scrolled: false;
    // derived from the scroll offset, so it tracks wheel scrolling without
    // relying on change notifications from the ListView
    out property <length> dbg-cy: transcript-list.content-y;
    out property <length> dbg-ch: transcript-list.content-height;
    out property <length> dbg-h: transcript-list.height;
    pure public function get-sidebar-cy() -> length { sidebar-list.content-y }
    public function restore-sidebar-cy(cy: length) {
        let max-scroll = max(0px, sidebar-list.content-height - sidebar-list.height);
        sidebar-list.content-y = clamp(cy, -max-scroll, 0px);
    }
    changed dbg-cy => {
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }
    out property <bool> at-bottom: transcript-list.content-y <= -root.scroll-range + 80px;
    /// how far the last row is from the floor of the view, in pixels
    out property <length> from-bottom: max(
        0px,
        root.scroll-range + transcript-list.content-y
    );

    // Following is a latch. Moving up turns it off and only three gestures turn it
    // back on: the jump button, sending, or scrolling down onto the floor.
    // A measurement must never re-arm it: content growing at the bottom rewrites
    // the offset, and for one frame the distance to the floor reads as zero.
    /// Called by anything that is definitely the reader's own input.
    public function reader-moved-up() {
        root.reader-scrolled = true;
        root.follow-bottom = false;
    }

    public function reader-reached-floor() {
        if (!root.scrollbar-dragging && root.from-bottom <= 12px && root.bottom-pad <= 1px) {
            root.reader-scrolled = false;
            root.follow-bottom = true;
            root.seen-content-y = transcript-list.content-y;
        }
    }

    in-out property <length> top-pad: 0px;
    in-out property <length> bottom-pad: 0px;
    in-out property <int> window-start: 0;
    callback viewport-scrolled(length, length);
    callback row-measured(int, length);
    in property <bool> has-older: false;
    in property <bool> loading-older: false;
    in property <bool> pager-ready: false;

    in-out property <length> live-vel: 0px;
    in-out property <bool> programmatic-scroll: false;

    public function set-scroll-y(value: length) {
        let preserved-vel = abs(root.flick-vel) > abs(root.live-vel) ? root.flick-vel : root.live-vel;
        root.programmatic-scroll = true;
        transcript-list.content-y = max(-root.scroll-range, min(0px, value));
        root.seen-content-y = transcript-list.content-y;
        root.programmatic-scroll = false;
        if (abs(preserved-vel) > 1.0px && !root.follow-bottom && !root.scrollbar-dragging) {
            root.flick-vel = clamp(preserved-vel, -240px, 240px);
            root.live-vel = root.flick-vel;
        }
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    in-out property <length> prev-scroll-range: 0px;
    out property <length> scroll-range: max(
        0px,
        transcript-list.content-height - transcript-list.height
    );

    changed scroll-range => {
        if (root.follow-bottom && !root.scrollbar-dragging && root.scroll-range >= root.prev-scroll-range && transcript-list.content-y > root.seen-content-y + 1px) {
            root.reader-moved-up();
        }
        // If the scroll range shrank (e.g. busy bar closing) while parked, keep seen-content-y in sync
        if (root.scroll-range < root.prev-scroll-range && root.follow-bottom && !root.scrollbar-dragging) {
            transcript-list.content-y = -root.scroll-range;
            root.seen-content-y = transcript-list.content-y;
        }
        root.prev-scroll-range = root.scroll-range;
    }

    // Smooth 60fps glide toward the floor while follow-bottom is latched
    smooth-follow := Timer {
        interval: 16ms;
        running: root.follow-bottom && !root.scrollbar-dragging && root.from-bottom > 0.5px;
        triggered => {
            if (transcript-list.content-y > root.seen-content-y + 1px && root.from-bottom > 2px) {
                root.reader-moved-up();
                root.seen-content-y = transcript-list.content-y;
                return;
            }
            let target = -root.scroll-range;
            let gap = transcript-list.content-y - target;
            if (gap <= 1.5px) {
                transcript-list.content-y = target;
            } else if (gap > 600px) {
                // On initial session attach or huge jump, close most of the gap and glide the last 140px
                transcript-list.content-y = target + 140px;
            } else {
                transcript-list.content-y = transcript-list.content-y - max(1.5px, gap * 0.28);
            }
            root.seen-content-y = transcript-list.content-y;
        }
    }

    public function scroll-to-ratio(ratio: float) {
        transcript-list.content-y = -max(0.0, min(1.0, ratio)) * root.scroll-range;
        root.seen-content-y = transcript-list.content-y;
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    public function scroll-to-thumb(y: length) {
        let travel = max(1px, transcript-area.height - root.thumb-height);
        root.scroll-to-ratio(y / travel);
    }

    in-out property <length> flick-vel: 0px;

    // 60fps inertial momentum timer (Flickable-style deceleration)
    flick-timer := Timer {
        interval: 16ms;
        running: abs(root.flick-vel) > 0.8px && !root.scrollbar-dragging && !root.follow-bottom;
        triggered => {
            let next-y = max(
                -root.scroll-range,
                min(0px, transcript-list.content-y + root.flick-vel)
            );
            root.programmatic-scroll = true;
            transcript-list.content-y = next-y;
            root.seen-content-y = next-y;
            root.programmatic-scroll = false;
            root.flick-vel = root.flick-vel * 0.91;
            root.live-vel = root.flick-vel;
            if (abs(root.flick-vel) <= 0.8px || (next-y == 0px && !root.has-older) || next-y == -root.scroll-range) {
                root.flick-vel = 0px;
                root.live-vel = 0px;
            }
            if (root.flick-vel < 0px) {
                root.reader-reached-floor();
            }
            root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
        }
    }

    public function page-scroll(direction: int) {
        if (direction < 0) {
            root.reader-moved-up();
        }
        let step = transcript-list.height * 0.82;
        // Impulse into flick velocity for butter-smooth inertial glide
        root.flick-vel = clamp(root.flick-vel - (step * direction) * 0.24, -220px, 220px);
        let immediate = transcript-list.content-y - (step * direction) * 0.18;
        transcript-list.content-y = max(-root.scroll-range, min(0px, immediate));
        root.seen-content-y = transcript-list.content-y;
        if (direction > 0) {
            root.reader-reached-floor();
        }
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    public function step-scroll(direction: int) {
        if (direction < 0) {
            root.reader-moved-up();
        }
        root.flick-vel = clamp(root.flick-vel - (36px * direction), -140px, 140px);
        if (direction > 0) {
            root.reader-reached-floor();
        }
    }

    public function scroll-to-top() {
        root.flick-vel = 0px;
        root.reader-moved-up();
        transcript-list.content-y = 0px;
        root.seen-content-y = 0px;
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    out property <length> thumb-height: max(
        28px,
        min(
            transcript-area.height,
            transcript-area.height * transcript-list.height
                / max(1px, transcript-list.content-height)
        )
    );

    transcript-scope := FocusScope {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if root.search-key(event) {
                return EventResult.accept;
            }
            if event.text == Key.PageUp {
                root.page-scroll(-1);
                return EventResult.accept;
            }
            if event.text == Key.PageDown {
                root.page-scroll(1);
                return EventResult.accept;
            }
            if event.text == Key.UpArrow {
                root.step-scroll(-1);
                return EventResult.accept;
            }
            if event.text == Key.DownArrow {
                root.step-scroll(1);
                return EventResult.accept;
            }
            if event.text == Key.Home && event.modifiers.control {
                root.scroll-to-top();
                return EventResult.accept;
            }
            if event.text == Key.End && event.modifiers.control {
                root.force-scroll-to-end();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    public function force-scroll-to-end() {
        root.reader-scrolled = false;
        root.follow-bottom = true;
        root.seen-content-y = transcript-list.content-y;
    }

    public function scroll-to-end() {
        if (transcript-list.content-y > root.seen-content-y + 1px && root.from-bottom > 2px) {
            root.reader-moved-up();
            root.seen-content-y = transcript-list.content-y;
            return;
        }
    }

    // Closing the search popup hands the window back to the words the reader was
    // writing, wherever they were: the composer is what an open window is for.
    public function focus-composer() { draft-window.grab-focus(); }

    VerticalLayout {

        HorizontalLayout {
            // Folded: the column keeps only its controls. The session rows cannot
            // survive at 48px - there is no room for a name - so the strip keeps the
            // mark and the three controls and drops the rows.
            sidebar-column := Rectangle {
                width: root.sidebar-open ? 232px : 48px;
                vertical-stretch: 1;
                // Explicit height: the column holds a layout and a list, and a
                // Rectangle sizes itself to its first children only - with the
                // list last, everything past the button was cut away.
                clip: true;
                background: Theme.sidebar-surface;

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: !root.sidebar-open;
                    padding-top: 4px;
                    spacing: 6px;
        
                    Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            alignment: center;
                            // The mark becomes the way back open under the pointer,
                            // so the control says what it does exactly when it can
                            // be used - and the hint that says the same thing in
                            // words is opened from the same hover.
                            strip-panel := PanelButton {
                                described: "Open sidebar";
                                hovered(over) => { root.open-sidebar-tip = over; }
                                clicked => {
                                    root.open-sidebar-tip = false;
                                    root.sidebar-open = true;
                                }
                                if !strip-panel.hot : PrimeAgentMark {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                if strip-panel.hot : PanelIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    arrow: true;
                                    point-left: false;
                                    tint: Theme.sidebar-fold-glyph-hover;
                                }
                            }
                        }
                    }
        
                    // New Session, mark only: the label has nowhere to go at this width.
                    Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            alignment: center;
                            strip-new := PanelButton {
                                described: "New Session";
                                clicked => { root.new-chat(); }
                                IconNewChat {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: strip-new.hot
                                        ? Theme.sidebar-strip-new-session-mark-hover
                                        : Theme.sidebar-strip-new-session-mark;
                                }
                            }
                        }
                    }
        
                    // The magnifier in the folded strip also opens the search popup.
                    Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            alignment: center;
                            strip-search := PanelButton {
                                described: "Search sessions";
                                clicked => { root.open-requested(); }
                                IconSearch {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: strip-search.hot
                                        ? Theme.sidebar-search-mark-hover
                                        : Theme.sidebar-search-mark;
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.sidebar-open;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    spacing: 6px;
                    // The band: the column's own header. Logo + wordmark on the left,
                    // search and collapse panel control on the right.
                    Rectangle {
                        height: 36px;
                        // opaque: the list runs underneath, and the band is
                        // the edge it disappears behind
                        PrimeAgentMark {
                            x: 6px;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            x: 32px;
                            y: (parent.height - self.height) / 2;
                            text: "Prime Agent";
                            color: Theme.sidebar-wordmark-ink;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        // The magnifier opens the search popup. It keeps the band's
                        // place: the fold still sits where it always has.
                        band-search := PanelButton {
                            size: 30px;
                            x: parent.width - 64px;
                            y: (parent.height - 30px) / 2;
                            described: "Search sessions";
                            clicked => { root.open-requested(); }
                            IconSearch {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: band-search.hot
                                    ? Theme.sidebar-search-mark-hover
                                    : Theme.sidebar-search-mark;
                            }
                        }

                        // The collapse button: a frame with its edge turning away,
                        // on a round hit area, the way the reference draws it.
                        panel-fold := PanelButton {
                            size: 30px;
                            x: parent.width - 30px;
                            y: (parent.height - 30px) / 2;
                            described: "Collapse sidebar";
                            clicked => { root.sidebar-open = !root.sidebar-open; }
                            PanelIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                arrow: panel-fold.hot;
                                point-left: root.sidebar-open;
                                tint: panel-fold.hot
                                    ? Theme.sidebar-fold-glyph-hover
                                    : Theme.sidebar-fold-glyph;
                            }
                        }
                    }

                    // The primary action of the column, at full width, because it is
                    // the one thing a session list is for. It calls the same new-chat
                    // the folded strip does: a layout change, not a lifecycle change.
                    new-session := Button {
                        height: 36px;
                        border-radius: 10px;
                        kind: ButtonKind.primary;
                        described: "New Session";
                        clicked => { root.new-chat(); }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 7px;

                            Rectangle {
                                width: 16px;
                                height: parent.height;
                                IconNewChat {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    tint: new-session.hot
                                        ? Theme.sidebar-new-session-mark-hover
                                        : Theme.sidebar-new-session-mark;
                                }
                            }

                            Text {
                                height: parent.height;
                                vertical-alignment: center;
                                text: "New Session";
                                color: new-session.hot
                                    ? Theme.sidebar-new-session-ink-hover
                                    : Theme.sidebar-new-session-ink;
                                font-size: 12px;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                // The list starts at the column's top edge and covers the band and
                // New Session: its entries begin at 88px, which is where the band
                // ends, so no row is drawn over them and a scrolled list slides
                // under the column's edge rather than through the header.
                //
                // A Flickable, not a ScrollView. ScrollView is a layout item: it
                // lays its children out, and when those children are a `for`
                // block it gives them their width once - a pass that runs before
                // the window has a size. Every row then measured zero wide and
                // every click fell through to the list behind it. A Flickable
                // lays nothing out, so each entry keeps the box it is given.
                sidebar-list := Flickable {
                    visible: root.sidebar-open;
                    // The list starts below the band and New Session at 88px,
                    // matching `COLUMN_TOP`, and its entries subtract 88px so
                    // the first header lands at y=0 inside the Flickable.
                    x: 8px;
                    y: 88px;
                    width: 232px - 16px;
                    // the window's height, not the Flickable's own or the
                    // column's: either way back through the layout is a loop
                    height: max(0px, root.height - 88px);
                    content-width: self.width;
                    content-height: max(0px, root.animated-sessions-height - 88px);
                    interactive: true;

                    sidebar-content := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: max(0px, root.animated-sessions-height - 88px);

                        for entry[k] in root.session-entries : Rectangle {
                            visible: !entry.is-header && root.row-h(k) > 0.5px
                                && root.row-opacity(k) > 0.01;
                            y: root.row-y(k) - 88px;
                            width: 100%;
                            height: 32px;
                            opacity: root.row-fade(k);
                            clip: true;

                            if !entry.is-header : SidebarRow {
                                width: 100%;
                                height: 32px;
                                item: entry.item;
                                selected: root.selected-id != "" && entry.item.id == root.selected-id;
                                editing: root.editing-id != "" && entry.item.id == root.editing-id;
                                menu-open: root.menu-id != "" && root.menu-id == entry.item.id;
                                draft <=> root.draft;
                                picked(id) => {
                                    root.model-menu = false;
                                    root.settings-menu = false;
                                    root.menu-id = "";
                                    if root.selected-id != id {
                                        root.selected-id = id;
                                        root.selection-picked(id);
                                    }
                                    // a picked row drops the card: leaving
                                    // hover as the only way to clear it
                                    // made it look stuck
                                    root.hover-title = "";
                                }
                                hovered(full, row-y) => {
                                    if full != "" {
                                        root.hover-y = row-y;
                                    }
                                    root.hover-title = full;
                                    // hover rots: hide the card if it
                                    // stops being fed, which is what
                                    // made a stale title look stuck.
                                    // Toggling restarts the timer:
                                    // `running` is bound, so calling
                                    // restart() on it would be
                                    // overridden.
                                    root.tooltip-on = false;
                                    root.tooltip-on = true;
                                }
                                edit(id) => {
                                    root.menu-id = "";
                                    root.editing-id = id;
                                    root.draft = entry.item.full;
                                }
                                commit(id, name) => {
                                    root.editing-id = "";
                                    root.rename-requested(id, name);
                                }
                                // a second press on the dots of the row whose
                                // menu is open closes it
                                toggled(id, x, y) => {
                                    if root.menu-id == id {
                                        root.menu-id = "";
                                        root.menu-closed();
                                    } else {
                                        root.menu-id = id;
                                        root.menu-x = x;
                                        root.menu-y = y;
                                        root.session-menu-opened(id);
                                    }
                                }
                            }
                        }

                        for header[k] in root.session-entries : Rectangle {
                            visible: header.is-header;
                            y: root.row-y(k) - 88px;
                            width: 100%;
                            height: 32px;

                            hdr := SessionGroupHeader {
                                width: 100%;
                                height: 32px;
                                label: header.label;
                                count: header.count;
                                closed: header.folded;
                                toggled => { root.group-toggled(header.label); }
                            }
                        }
                    }
                }

                // Thin scrollbar thumb on the right edge of the sessions list
                if root.sidebar-open && sidebar-list.content-height > sidebar-list.height : Rectangle {
                    x: 232px - 6px;
                    y: 88px;
                    width: 4px;
                    height: sidebar-list.height;
                    property <length> range: max(1px, sidebar-list.content-height - sidebar-list.height);
                    property <length> thumb-h: clamp(self.height * (self.height / max(1px, sidebar-list.content-height)), 28px, self.height);
                    property <length> travel: max(0px, self.height - self.thumb-h);
                    Rectangle {
                        x: 0;
                        y: clamp((-sidebar-list.content-y / parent.range) * parent.travel, 0px, parent.travel);
                        width: 4px;
                        height: parent.thumb-h;
                        border-radius: 2px;
                        background: Theme.transcript-scroll-thumb;
                    }
                }
            }

            // explicit geometry: a Rectangle's preferred size never reflects its
            // children in Slint, so a layout here always under-measured the
            // composer and let it spill past the window
            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                padding-top: 32px;
            center-column := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Theme.transcript-surface;
                border-top-left-radius: 10px;
                border-top-right-radius: root.right-open ? 10px : 0px;
                clip: true;

                    transcript-area := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - root.composer-total;
                        background: transparent;

                        area-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move {
                                    root.hover-title = "";
                                }
                                // this area takes the press, so the drag surface
                                // below never reports the click it should have seen
                                if event.kind == PointerEventKind.down {
                                    root.settings-menu = false;
                                    // the page keys follow the pointer: clicking
                                    // the transcript lets Page Up/Down scroll it
                                    transcript-scope.focus();
                                }
                            }
                        }

                                                transcript-list := Flickable {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            flicked => {
                                if (root.programmatic-scroll) {
                                    return;
                                }
                                let delta = transcript-list.content-y - root.seen-content-y;
                                if (abs(delta) > 0.5px) {
                                    root.live-vel = clamp(delta, -220px, 220px);
                                }
                                if (delta > 0.5px && root.from-bottom > 2px) {
                                    root.reader-moved-up();
                                } else if (delta < -0.5px && root.from-bottom <= 12px && root.bottom-pad <= 1px) {
                                    root.reader-reached-floor();
                                }
                                // Smoothly boost wheel impulses into inertial coasting
                                if (!root.scrollbar-dragging && abs(delta) >= 20px && abs(delta) <= 300px) {
                                    root.programmatic-scroll = true;
                                    transcript-list.content-y = root.seen-content-y + delta * 0.45;
                                    root.programmatic-scroll = false;
                                    root.flick-vel = clamp(root.flick-vel + delta * 0.32, -240px, 240px);
                                    root.live-vel = root.flick-vel;
                                }
                                root.seen-content-y = transcript-list.content-y;
                                root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
                            }
                            VerticalLayout {
                                width: transcript-list.width;
                                alignment: start;
                                spacing: 0px;
                                Rectangle {
                                    width: 1px;
                                    height: root.top-pad;
                                }
                                for item[i] in root.transcript : TranscriptRow {
                                    width: transcript-list.width;
                                    data: item;
                                    init => {
                                        root.row-measured(root.window-start + i, self.height);
                                    }
                                    changed height => {
                                        root.row-measured(root.window-start + i, self.height);
                                    }
                                    toggle => {
                                        root.model-menu = false;
                                        root.toggle-row(root.window-start + i);
                                    }
                                    reason-hover(reason, x, y) => {
                                        root.reason-text = reason;
                                        root.reason-x = x;
                                        root.reason-y = y;
                                        root.reason-open = true;
                                    }
                                    reason-leave => {
                                        root.reason-open = false;
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: root.bottom-pad;
                                }
                            }
                        }

                        // The transcript's scrollbar: a track that takes the
                        // whole height, so a drag keeps working once the thumb
                        // has moved out from under the pointer.
                        scroll-bar := Rectangle {
                            x: transcript-area.width - self.width;
                            y: 0;
                            width: 10px;
                            height: transcript-area.height;
                            background: transparent;
                            visible: transcript-list.content-height > transcript-list.height;

                            property <length> travel: max(0px, self.height - root.thumb-height);
                            property <length> thumb-y: max(
                                0px,
                                min(
                                    self.travel,
                                    (-transcript-list.content-y) / max(1px, root.scroll-range) * self.travel
                                )
                            );
                            property <length> grabbed: 0px;
                            property <bool> dragged: false;

                            Rectangle {
                                x: 2px;
                                y: scroll-bar.thumb-y;
                                width: 6px;
                                height: root.thumb-height;
                                border-radius: 3px;
                                background: bar-touch.pressed ? Theme.transcript-scroll-thumb-pressed
                                    : bar-touch.has-hover ? Theme.transcript-scroll-thumb-hover
                                    : Theme.transcript-scroll-thumb;
                                animate background { duration: 120ms; }
                            }

                            bar-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        scroll-bar.dragged = false;
                                        scroll-bar.grabbed = self.mouse-y - scroll-bar.thumb-y;
                                        root.scrollbar-dragging = true;
                                        root.reader-moved-up();
                                    }
                                    if event.kind == PointerEventKind.up
                                        || event.kind == PointerEventKind.cancel
                                    {
                                        root.scrollbar-dragging = false;
                                        root.reader-reached-floor();
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        scroll-bar.dragged = true;
                                        root.reader-moved-up();
                                        if (scroll-bar.grabbed >= 0px && scroll-bar.grabbed <= root.thumb-height) {
                                            root.scroll-to-thumb(self.mouse-y - scroll-bar.grabbed);
                                        } else {
                                            root.scroll-to-thumb(self.mouse-y - root.thumb-height / 2);
                                        }
                                    }
                                }
                                clicked => {
                                    if (!scroll-bar.dragged && (scroll-bar.grabbed < 0px || scroll-bar.grabbed > root.thumb-height)) {
                                        root.reader-moved-up();
                                        root.scroll-to-thumb(self.mouse-y - root.thumb-height / 2);
                                        root.reader-reached-floor();
                                    }
                                }
                            }
                        }

                        // floating just above the status row, aligned with the
                    // context ring: detached from the composer
                    if !root.at-bottom : Button {
                        x: transcript-area.width - self.width - 22px;
                        y: transcript-area.height - self.height - 10px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        fill: Theme.transcript-jump-fill;
                        fill-hover: Theme.transcript-jump-fill-hover;
                        border-color: Theme.transcript-jump-edge;
                        border-width: 1px;
                        described: "Jump to the newest row";
                        clicked => { root.force-scroll-to-end(); }
                        IconChevronDown {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    }

                    // live status row: TUI-style, one cell size for glyph and label
                    // always present: an `if`-created subtree got no hover tracking

                composer-band := Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: root.dragging ? root.band-freeze : root.composer-total;
                    background: transparent;

                    // handle, drawn on the box's top border
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: composer-box.y - 1.5px;
                        width: 36px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: root.dragging
                            ? Theme.composer-handle-fill-dragging
                            : (root.handle-hover ? Theme.composer-handle-fill-hover
                                : Theme.composer-handle-fill);
                    }



    StatusStrip {
        strip-x: 18px;
        box-y: composer-box.y;
        strip-w: parent.width - 36px;
        strip-h: root.busy-h;
        fade: root.busy-fade;
        spinner: root.spinner-frame;
        label: root.busy-label;
        elapsed: root.busy-elapsed;
        queued: root.queued-count;
        queue-open <=> root.queue-open;
    }

                    composer-box := Rectangle {
                    x: 18px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 36px;
                    height: root.box-height;
    background: Theme.composer-surface;
    border-color: Theme.composer-edge;
    border-width: 1px;
    border-radius: 12px;

    // the handle drawn on the box's top border
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: -self.height / 2;
        width: 36px;
        height: 3px;
        border-radius: 1.5px;
        background: root.dragging
            ? Theme.composer-handle-fill-dragging
            : (root.handle-hover ? Theme.composer-handle-fill-hover
                : Theme.composer-handle-fill);
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 10px;
        // a fixed-height window over a text input that is allowed to grow:
        // pinning its bottom edge keeps the caret (newest line) in view, which
        // a fixed-height TextInput does not do on its own
        // thumbnails, 44px tiles at an 8px pitch, only while something is attached
        if root.attachment-images.length > 0 : Rectangle {
            height: 52px;
            clip: true;
            background: transparent;
            HorizontalLayout {
                y: (parent.height - 44px) / 2;
                spacing: 8px;
                for image[i] in root.attachment-images : Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 8px;
                    clip: true;
                    background: Theme.composer-attachment-fill;
                    border-width: 1px;
                    border-color: thumb-touch.has-hover ? Theme.composer-attachment-edge-hover
                        : Theme.composer-attachment-edge;

                    Image {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        source: image;
                        image-fit: cover;
                    }
                    thumb-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.attachment-removed(i); }
                    }
                    // the × only shows when the pointer is on the tile: a strip of
                    // crosses at rest reads as a toolbar, not as your attachment
                    Rectangle {
                        x: parent.width - 17px;
                        y: 3px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.composer-attachment-remove-fill;
                        opacity: thumb-touch.has-hover ? 0.92 : 0.0;
                        animate opacity { duration: 120ms; }
                        Rectangle {
                            x: (parent.width - 7px) / 2;
                            y: (parent.height - 1.5px) / 2;
                            width: 7px;
                            height: 1.5px;
                            border-radius: 0.75px;
                            background: Theme.composer-attachment-remove-ink;
                            transform-rotation: 45deg;
                        }
                        Rectangle {
                            x: (parent.width - 7px) / 2;
                            y: (parent.height - 1.5px) / 2;
                            width: 7px;
                            height: 1.5px;
                            border-radius: 0.75px;
                            background: Theme.composer-attachment-remove-ink;
                            transform-rotation: -45deg;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        Rectangle {
            height: root.composer-height;
            background: transparent;

            if root.composer-command != "" : Text {
                x: 0;
                y: 1px;
                height: 20px;
                text: root.composer-command;
                color: Theme.composer-command-ink;
                font-size: 13px;
                vertical-alignment: center;
                init => { root.command-word-width = self.preferred-width; }
                changed preferred-width => { root.command-word-width = self.preferred-width; }
            }

            draft-window := DraftEditor {
                use-canvas: root.canvas-mode;
                canvas: root.composer-canvas;
                canvas-height: root.composer-canvas-height;
                caret-x: root.composer-caret-x;
                caret-y: root.composer-caret-y;
                caret-height: root.composer-caret-height;
                x: root.composer-command == "" ? 0px : root.command-word-width + 6px;
                width: parent.width - self.x;
                height: root.composer-height;
                caret-request <=> root.composer-caret-request;
                text <=> root.composer-text;
                font-size: Type.body;
                edited(t) => {
                    root.composer-text = t;
                    root.composer-has-text = t != "";
                    // the caret travels with the text: the command token is
                    // whatever the caret is inside, wherever that is
                    root.slash-typed(t, self.caret-offset);
                }
                        key-pressed(event) => {
                                // While the popup is up it owns the keyboard: a
                                // word meant for its field must not reach the
                                // words the reader was writing as well.
                                if root.search-open && root.search-field-typed {
                                    return EventResult.accept;
                                }
                                // Ctrl+K opens the search popup from the words the
                                // reader is writing; the window owns the chord.
                                if root.search-key(event) {
                                    return EventResult.accept;
                                }
                                // The command menu answers first while it is open.
                                if root.slash-take(event) {
                                    return EventResult.accept;
                                }
                                // Backspace at the very start of the words takes
                                // the command word away with it: it is the only
                                // way to remove it, and it must work
                                if event.text == Key.Backspace
                                    && root.composer-command != ""
                                    && (root.composer-text == "" || self.caret-offset <= 0)
                                {
                                    root.composer-command-cleared();
                                    return EventResult.accept;
                                }
                                // Enter sends, or queues for the next turn while busy.
                                // The chosen chord steers the running turn,
                                // Shift+Enter is a newline, Esc aborts.
                                if event.text == Key.Return {
                                    // A command word in front of the caret is half of
                                    // the message: the box is empty when a command was
                                    // taken from the menu, and that is still something
                                    // to send, not a dead key.
                                    if (root.setting-queue-key == "Ctrl+Enter" && event.modifiers.control)
                                        || (root.setting-queue-key == "Alt+Enter" && event.modifiers.alt)
                                    {
                                        if root.composer-text != ""
                                            || root.composer-command != ""
                                            || root.attachment-images.length > 0
                                        {
                                            root.steer-requested(root.composer-text);
                                            root.composer-text = "";
                                        }
                                        return EventResult.accept;
                                    }
                                    if !event.modifiers.shift
                                        && !event.modifiers.control
                                        && !event.modifiers.alt
                                    {
                                        if root.composer-text != ""
                                            || root.composer-command != ""
                                            || root.attachment-images.length > 0
                                        {
                                            root.send-requested(root.composer-text);
                                            root.composer-text = "";
                                        }
                                        return EventResult.accept;
                                    }
                                }
                                // Ctrl+Shift+V attaches an image from the clipboard;
                                // plain Ctrl+V stays text paste
                                // One key for both kinds of paste: Ctrl+V attaches the
                                // image when the clipboard holds one, and otherwise
                                // falls through to the text input's own paste. The text
                                // of a chorded key is not always the letter: with
                                // control it arrives as the control character, with
                                // shift as the capital, so all three are the same key.
                                if event.modifiers.control
                                    && (event.text == "v" || event.text == "V"
                                        || event.text == "\u{16}")
                                {
                                    if root.attach-pasted() {
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                                if event.text == Key.Escape {
                                    root.abort-requested();
                                    return EventResult.accept;
                                }
                                if event.text == Key.End && event.modifiers.control {
                                    root.scroll-to-end();
                                    return EventResult.accept;
                                }
                                // page keys scroll the transcript while the caret
                                // stays in the words being written
                                if event.text == Key.PageUp {
                                    root.page-scroll(-1);
                                    return EventResult.accept;
                                }
                                if event.text == Key.PageDown {
                                    root.page-scroll(1);
                                    return EventResult.accept;
                                }
                                if event.text == Key.Home && event.modifiers.control {
                                    root.scroll-to-top();
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                // the keys belong to the composer: it is where the window opens
                // and where the reader types after a session is picked
                init => { draft-window.grab-focus(); }

            }
        }
        HorizontalLayout {
            spacing: 8px;
            ActivityChip {
                subagents: root.activity-subagents;
                heartbeats: root.activity-heartbeats;
                shells: root.activity-shells;
            }
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
            // the context ring sits in the button row, not in the status strip:
            // the strip appears and disappears with every turn, and a number you
            // are reading should not travel
            Rectangle {
                width: 22px;
                height: 24px;

                ContextRing {
                    x: 1px;
                    y: 2px;
                    fill: root.context-fill;
                }

                // the ring is 20px: the hover target is the whole cell
                ctx-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.pointer;
                    changed has-hover => { root.ctx-hover = self.has-hover; }
                }

                // the numbers behind the ring
                if root.ctx-hover : Panel {
                    x: -self.width + 20px;
                    y: -self.height - 14px;
                    width: 216px;
                    height: self.preferred-height;
                    // A panel of the composer's own: it opens off the ring rather
                    // than off the window's edge, and its three fields are the
                    // card's, so a theme that moves the panels leaves this one to
                    // the composer.
                    surface: Theme.composer-card-surface;
                    edge: Theme.composer-card-edge;
                    shadow: Theme.composer-card-shadow;
                    border-radius: 8px;
                    drop-shadow-blur: 10px;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        ContextCard {
                            fill: root.context-fill;
                            used: root.context-text;
                            percent: root.ctx-percent;
                            messages: root.stat-messages;
                            tools: root.stat-tools;
                            input: root.stat-in;
                            output: root.stat-out;
                            cached: root.stat-cache;
                            cost: root.cost-session;
                            cost-family: root.cost-family;
                            cost-family-on: root.cost-family-on;
                        }
                    }
                }
            }

            // attach: a plus in a quiet resting surface, same family as the rest
            attach := Button {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                fill: Theme.composer-attach-fill;
                fill-hover: Theme.composer-attach-fill-hover;
                described: "Attach a picture";
                clicked => { root.attach-requested(); }
                IconPlus {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: attach.hot ? Theme.composer-attach-ink-hover : Theme.composer-attach-ink;
                }
            }
            Chip {
                label: root.model-label;
                open: root.model-menu;
                toggled => {
                    root.settings-menu = false;
                    root.model-menu = !root.model-menu;
                    if root.model-menu {
                        root.model-menu-opened();
                    }
                }
            }
            // One control, two jobs: send while idle, stop while working. One hit
            // area with the branch inside it, because a button swapped on a
            // condition does not take clicks here. Both fields are named, not a
            // kind, since the job changes under the pointer.
            // Both marks are always present and cross over: the arrow shrinks and
            // turns, the square grows and turns. Slint cannot interpolate one path
            // into another, so the morph is scale, rotation and opacity.
            Button {
                width: 25px;
                height: 25px;
                border-radius: 12.5px;
                fill: root.stop-mode ? Theme.button-danger-fill : Theme.composer-send-fill;
                fill-hover: root.stop-mode
                    ? Theme.button-danger-fill-hover : Theme.composer-send-fill-hover;
                fade: 240ms;
                fade-curve: ease-in-out;
                described: root.stop-mode ? "Stop the turn" : "Send";
                clicked => {
                    root.model-menu = false;
                    if root.stop-mode {
                        // the daemon keeps the queue flowing behind the stopped
                        // run, so the next waiting message is not stranded
                        root.abort-requested();
                    } else {
                        root.send-requested(root.composer-text);
                        root.composer-text = "";
                    }
                }

                IconSend {
                    width: 12px * (1.0 - 0.34 * root.stop-mix);
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    opacity: 1.0 - root.stop-mix;
                    transform-rotation: root.stop-mix * 45deg;
                    tint: Theme.composer-send-mark;
                }

                Rectangle {
                    width: 2px + 6px * root.stop-mix;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    // a dot rounding out into a square as it arrives
                    border-radius: 3px - 1.5px * root.stop-mix;
                    background: Theme.composer-stop-mark;
                    opacity: root.stop-mix;
                    transform-rotation: (1.0 - root.stop-mix) * -45deg;
                }
            }
        }
    }
                    }
                }

            }
            }

            // Blank by request: the column, its width and its fold, nothing else.
            if root.right-open : Rectangle {
                width: 320px;
                background: Theme.window-surface;
            }
        }
    }

    // title card: anchored to the row it describes and shown just to the right
    // of the sidebar, the way a tooltip is expected to behave
    if root.hover-title != "" : Panel {
        // 12px clear of the column, whichever width it has
        x: root.sidebar-open ? 244px : 60px;
        y: clamp(root.hover-y - 4px, 40px, root.height - self.height - 12px);
        width: min(self.preferred-width, 260px);
        height: self.preferred-height;
        // The panels' own field and shadow, and an edge of its own: the card hangs
        // off a row rather than over the window, and lies nearer the reader.
        edge: Theme.session-card-edge;
        border-radius: 8px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            Text {
                text: root.hover-title;
                color: Theme.session-card-ink;
                font-size: 11px;
                wrap: word-wrap;
                max-width: 240px;
            }
        }
    }


        // nothing keeps a hover alive forever: this is the safety net
    tooltip-timer := Timer {
        interval: 6000ms;
        running: root.tooltip-on;
        triggered => {
            root.hover-title = "";
            root.tooltip-on = false;
        }
    }

    // the menu is the last child of the window so nothing paints or hit-tests
    // above it: nested in the composer it sat behind the transcript's scroll
    // layer, which composites over later siblings

    // The command menu: opens the moment a slash starts the message, narrows as
    // more is typed, and sits directly above the box it belongs to. Capped and
    // scrollable, because it can hold every builtin at once.
    if root.slash-open && root.slash-items.length > 0 : SlashMenu {
        items: root.slash-items;
        index <=> root.slash-index;
        anchor-x: composer-box.absolute-position.x;
        anchor-y: composer-box.absolute-position.y;
        anchor-w: composer-box.width;
        accepted => { root.slash-accept(); }
    }



    if root.model-menu : ModelMenu {
        groups: root.model-groups;
        measured-height: root.model-menu-height;
        anchor-x: composer-box.absolute-position.x;
        anchor-y: composer-box.absolute-position.y;
        anchor-w: composer-box.width;
        picked(provider, model) => { root.model-picked(provider, model); }
        hovered(provider, model, y) => { root.model-hovered(provider, model, y); }
        pointer-moved => { root.pointer-moved(); }
        provider-toggled(provider) => { root.provider-toggled(provider); }
        close-requested => {
            root.model-menu = false;
            root.effort-open = false;
        }
    }

    if root.model-menu && root.effort-open : EffortLadder {
        items: root.effort-items;
        row-y: root.effort-y;
        measured-height: root.model-menu-height;
        anchor-x: composer-box.absolute-position.x;
        anchor-y: composer-box.absolute-position.y;
        anchor-w: composer-box.width;
        picked(level) => { root.effort-picked(level); }
        hovered => { root.effort-hovered(); }
    }

    // Click-away backdrop for the session menu.
    if root.menu-id != "" : TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clicked => {
            root.menu-id = "";
            root.menu-closed();
        }
    }

    // A session row's own menu, hung off the dots that opened it. At the window
    // root like the model menu and the queue panel, so it paints over the
    // transcript and the composer rather than under them.
    if root.menu-id != "" : SessionMenu {
        items: root.menu-items;
        anchor-x: root.menu-x;
        anchor-y: root.menu-y - 32px;
        viewport-h: root.height;
        picked(key) => { root.session-menu-picked(root.menu-id, key); }
    }

    // The queue panel hangs off the strip, at the window root like the model
    // menu: inside the band it sat at a negative y, where it painted outside
    // the area that answers clicks.
    if root.queue-open && root.queued-count > 0 : Panel {
        // measured off the composer box, not the band: the strip's height is
        // animated, and the panel has to ride it
        x: composer-box.absolute-position.x + composer-box.width - self.width;
        y: composer-box.absolute-position.y - root.busy-h - self.height - 6px;
        width: 320px;
        // the list is capped and scrolls: a long queue used to walk off the top
        // of the window, where the rows could not even be reached
        // not `q-scroll.height`: a ScrollView's height reads back as nothing at
        // the time the parent binds, which collapsed the panel to a sliver
        height: root.q-scroll-h + 12px;
        border-radius: 10px;

        q-scroll := ScrollView {
            x: 0;
            y: 6px;
            width: parent.width;
            height: root.q-scroll-h;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: root.q-content-h;

            Rectangle {
                width: 100%;
                height: root.q-content-h;
                // rows are placed by arithmetic, so the content root is the one
                // thing that can stop a long queue painting past the panel
                clip: true;

                if root.queued-steering.length > 0 : Text {
                    x: 10px;
                    y: 0;
                    height: 20px;
                    vertical-alignment: center;
                    text: root.queued-count == 1 ? "1 message waiting" : root.queued-count + " messages waiting";
                    color: Theme.queue-card-count-ink;
                    font-size: 9px;
                }
                for item[i] in root.queued-steering : QueueRow {
                    y: root.q-head-in + i * 34px;
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.text;
                    lane: "steering";
                    slot: item.slot;
                    thumb: item.thumb;
                    act(lane, slot, action) => {
                        root.queue-act(lane, slot, action);
                        if action != "edit" {
                            root.queue-open = false;
                        }
                    }
                }

                if root.queued-followup.length > 0 : Text {
                    x: 10px;
                    y: root.q-head-in + root.q-rows-in + root.q-lane-gap;
                    height: 20px;
                    vertical-alignment: center;
                    text: "runs next";
                    color: Theme.queue-card-lane-ink;
                    font-size: 9px;
                }
                for item[i] in root.queued-followup : QueueRowUp {
                    y: root.q-head-in + root.q-rows-in + root.q-lane-gap + root.q-head-next + i * 34px;
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.text;
                    lane: "followUp";
                    slot: item.slot;
                    thumb: item.thumb;
                    act(lane, slot, action) => {
                        root.queue-act(lane, slot, action);
                        if action != "edit" {
                            root.queue-open = false;
                        }
                    }
                }

                clear-all := Button {
                    x: 8px;
                    y: root.q-content-h - 24px;
                    width: parent.width - 16px;
                    height: 22px;
                    border-radius: 5px;
                    // a row-shaped control: the panel's own row fill is what it
                    // lights with, so it reads as one of the card's rows.
                    fill-hover: Theme.panel-row-fill-hover;
                    described: "Clear all waiting messages";
                    clicked => {
                        root.queue-clear();
                        root.queue-open = false;
                    }

                    Text {
                        x: 2px;
                        y: 0;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "clear all";
                        color: clear-all.hot ? Theme.queue-card-clear-ink-hover
                            : Theme.queue-card-clear-ink;
                        font-size: 10px;
                    }
                }
            }
        }
    }

    // Drawn at the window root: inside the row it was covered by whichever row came
    // next. The cap is on the width, not `max-width` - this popup is out of every
    // layout, so the constraint is not applied. One line, because the interesting
    // end of an exception is its tail; the rest travels in MarqueeText.
    // Hidden rather than destroyed: a marquee created already past its end has
    // nothing to animate from.
    Rectangle {
        visible: root.reason-open;
        x: min(root.reason-x, root.width - self.width - 12px);
        y: root.reason-y + 4px;
        width: min(reason-text.preferred-width + 20px, 440px);
        height: reason-text.height + 16px;
        background: Theme.transcript-cell-fill-failed;
        border-color: Theme.transcript-reason-edge;
        border-width: 1px;
        border-radius: 6px;

        reason-text := MarqueeText {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            text: root.reason-text;
            text-color: Theme.transcript-reason-ink;
            font-size: 10px;
            active: root.reason-open;
            loop: true;
        }
    }







    // The search popup, over the middle of the window: a place to find one
    // session out of all of them, not a part of any column. It is the last thing
    // the window draws, so it paints above the menus and the title bar, and the
    // strips around it are the window itself: a click there closes the popup,
    // and a click on the panel never reaches them.
    search-backdrop := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: root.search-open;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.search-outside(); }
        }

        // The popup declares its width and height, so its place in the middle
        // of the window is known without waiting for a first paint, and it never
        // comes nearer the title bar than the clearance.
        search-popup := SearchPopup {
            x: max(root.search-clearance, (root.width - self.width) / 2);
            y: max(root.search-clearance, (root.height - self.height) / 2);
            rows: root.search-rows;
            placeholder: "Search sessions";
            query <=> root.search-query;
            index <=> root.search-index;
            typed(text) => {
                if root.search-open {
                    root.search-field-used();
                    root.search-typed(text);
                }
            }
            picked(id) => { root.search-picked(id); }
            // The window closes the popup and hands the caret back to the
            // composer in the same call, so the popup may bind its Escape, its
            // cross and Return straight to this.
            closed => { root.search-closed(); }
            focus-tick: root.search-focus-tick;
        }
    }

    // The share card over the middle of the window: the same place and the same
    // shape as the search popup, because the two are the window's only surfaces
    // that open over everything rather than hanging off a control. The strips
    // around it are the window itself: a click there dismisses the card, and a
    // click on the panel never reaches them.
    if root.share-open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.share-dismissed(); }
        }

        share-popup := SharePopup {
            x: max(root.search-clearance, (root.width - self.width) / 2);
            y: max(root.search-clearance, (root.height - self.height) / 2);
            pending: root.share-pending;
            url: root.share-url;
            error: root.share-error;
            action-error: root.share-action-error;
            copied: root.share-copied;
            copy-requested => { root.share-copy-requested(); }
            open-requested => { root.share-open-link-requested(); }
            dismissed => { root.share-dismissed(); }
        }
    }

    if root.settings-menu : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.settings-closed(); }
        }

        settings-popup := SettingsPopup {
            width: min(1040px, root.width - 48px);
            height: min(780px, root.height - 48px);
            x: max(24px, (root.width - self.width) / 2);
            y: max(36px, (root.height - self.height) / 2);
            page <=> root.settings-page;
            query <=> root.settings-query;
            open-choice <=> root.settings-open-choice;
            focus-tick: root.settings-focus-tick;
            theme-items: root.theme-items;
            thread-notifications: root.setting-thread-notifications;
            in-app-notifications: root.setting-in-app-notifications;
            session-order: root.setting-session-order;
            confirm-quit: root.setting-confirm-quit;
            confirm-delete-session: root.setting-confirm-delete-session;
            queue-key: root.setting-queue-key;
            reopen-last-session: root.setting-reopen-last-session;
            interface-size: root.setting-interface-size;
            code-font: root.setting-code-font;
            row-spacing: root.setting-row-spacing;
            show-timestamps: root.setting-show-timestamps;
            reduce-motion: root.setting-reduce-motion;
            show-notifications: root.settings-show-notifications;
            show-sidebar: root.settings-show-sidebar;
            show-confirmations: root.settings-show-confirmations;
            show-behavior: root.settings-show-behavior;
            show-theme: root.settings-show-theme;
            show-typography: root.settings-show-typography;
            show-density: root.settings-show-density;
            theme-picked(id) => { root.theme-picked(id); }
            setting-toggled(key) => { root.setting-toggled(key); }
            setting-chosen(key, val) => { root.setting-chosen(key, val); }
            choice-toggled(key) => { root.toggle-settings-choice(key); }
            choice-dismissed => { root.dismiss-settings-choice(); }
            search-edited(text) => { root.settings-search-edited(text); }
            closed => { root.settings-closed(); }
        }
    }


    // The hint the folded strip raises under its own control: it names the action
    // the pointer is over, so it answers no pointer of its own and takes no click
    // - the strip's button is what heard the hover that shows it.
    if !root.sidebar-open && root.open-sidebar-tip : Button {
        x: 52px;
        y: 6px;
        width: open-tip-label.preferred-width + 24px;
        height: 28px;
        border-radius: 14px;
        kind: ButtonKind.primary;
        fill: Theme.sidebar-open-tip-fill;
        fill-hover: Theme.sidebar-open-tip-fill;
        enabled: false;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.sidebar-open-tip-shadow;
        open-tip-label := Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "Open sidebar";
            color: Theme.sidebar-open-tip-ink;
            font-size: 12px;
            font-weight: 500;
        }
    }

    // drawn last so it sits above the content and the drag surface beneath it
    title-bar := TitleBar {
        y: 0;
        width: 100%;
        caption: root.title;
        right-open: root.right-open;
        toggle-right => { root.right-open = !root.right-open; }
        settings-open: root.settings-menu;
        toggle-settings => { root.settings-toggle-requested(); }
        maximized: root.titlebar-maximized;
        max-hover: root.titlebar-max-hover;
        minimize => { root.titlebar-minimize(); }
        close => { root.titlebar-close(); }
    }
}

