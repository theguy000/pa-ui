import { ListView, ScrollView } from "std-widgets.slint";
import { DraftEditor } from "draft-editor.slint";
import { MarqueeText } from "marquee-text.slint";
import { MatEdit, MatDelete, MatDeleteForever, LucidePencil, LucideTrash2, LucideSquarePen, MatClose, SimpleBin, CrossEven, CrossHeavy, LucideCross, IMDeleteoutline, IMHighlightoff, IMIndeterminatecheckbox, ILCircleX } from "icons-real.slint";

// The reading size. The DeepSeek Harness sets its conversation text at 14px on
// a 24px line; this toolkit gives no control over that line, so the size carries
// the difference instead: one point up, on the spacing the font chooses.
export global Type {
    out property <length> body: 15px;
    // The sidebar: the harness sets its list of conversations at 13px, one step
    // under the conversation itself.
    out property <length> item: 13px;
}

export struct TRow {
    kind: int,          // 0 user, 1 agent text, 2 thinking, 3 python cell, 5 notice
    title: string,
    meta: string,
    body: styled-text,
    code: styled-text,
    output: styled-text,
    has-code: bool,
    has-output: bool,
    expanded: bool,
    failed: bool,
    reason: string,
    image: image,
    elapsed: string,
}

export struct SessionItem {
    id: string,
    uuid: string,
    name: string,
    age: string,
    full: string,
    tip: string,
    status: string,
}

// one waiting message, addressed by its lane and its position in that lane
// One row of the command menu: the word after the slash, the argument hint the
// command takes, and what it does.
export struct SlashItem {
    name: string,
    hint: string,
    description: string,
}

export struct QueueItem {
    // what the row shows: one line, elided
    text: string,
    // what the daemon addressed it by, untouched
    raw: string,
    slot: int,
    // the picture this message carries, if any: the queue projection names text
    // only, so the window supplies the thumbnail it sent
    thumb: image,
}

export struct ModelItem {
    id: string,
    label: string,
    // right-aligned hint: context window
    detail: string,
    // the level this model is thinking at � only ever set on the running one,
    // since a level belongs to the model that holds it
    effort: string,
    current: bool,
}

// one rung of a model's thinking ladder, in the submenu that drops off its row
export struct EffortItem {
    level: string,
    label: string,
    current: bool,
}

// one provider's models; `models` is empty while the group is collapsed, so a
// thousand-entry catalog never becomes a thousand elements
export struct ModelGroup {
    provider: string,
    label: string,
    count: int,
    open: bool,
    configured: bool,
    models: [ModelItem],
}

component IconToTop inherits Path {
    in property <color> tint: #a18e41;
    width: 16px;
    height: 16px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: "M 3.2 2.9 L 10.8 2.9 M 7 11.6 L 7 5.3 M 4.4 7.9 L 7 5.3 L 9.6 7.9";
    stroke: tint;
    stroke-width: 1.3px;
    fill: transparent;
}

// One waiting message in the steering lane: already inside this turn, so the
// only action is delete. Two row components instead of one with a conditional
// button: a button made conditional does not take clicks here, even though it
// paints.
component IconPencil inherits Path {
    width: 11px;
    height: 11px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 2 8.2 L 2 10 L 3.8 10 L 10 3.8 L 8.2 2 Z";
    stroke: #8b8c85;
    stroke-width: 1.1px;
    fill: transparent;
}
// The panel marks, from the two sidebar sheets: a frame, its folded edge, and -
// once the pointer is on it - the direction the column will travel. Resting, it
// is only a frame, so the hover is what tells you what the click is going to do.
component PanelIcon inherits Path {
    // the folded edge sits on the right for the right-hand column
    in property <bool> folded-edge-right: false;
    in property <bool> arrow: false;
    in property <bool> point-left: false;
    in property <color> tint: #b0b1a8;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 7 3 L 17 3 A 4 4 0 0 1 21 7 L 21 17 A 4 4 0 0 1 17 21 L 7 21 A 4 4 0 0 1 3 17 L 3 7 A 4 4 0 0 1 7 3 Z"
        + (folded-edge-right ? " M 16 8 L 16 16" : " M 8 8 L 8 16")
        + (arrow
            ? (folded-edge-right
                ? (point-left ? " M 11.5 9.5 L 8.5 12 L 11.5 14.5" : " M 9 9.5 L 12 12 L 9 14.5")
                : (point-left ? " M 15 9.5 L 12 12 L 15 14.5" : " M 12.5 9.5 L 15.5 12 L 12.5 14.5"))
            : "");
}

// The new-session mark: a ring left open at its top right, with the pen that
// opened it still crossing the gap. Both shapes are stroked outlines, so they
// share one Path: the viewbox is the 24 the mark was drawn on, and the pen is
// that drawing's rounded rect carried through its own -45 degree turn.
component IconNewChat inherits Path {
    in property <color> tint: #b0b1a8;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    // the mark's own 2.1 on a 24 viewbox, at the size it is drawn here
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 10.5 5 C 6 5 4 7.2 4 12.5 C 4 17.8 6.2 20 11.8 20 C 17.4 20 19.5 17.8 19.5 13 "
        + "M 9.36 10.93 L 15.73 4.56 A 1.8 1.8 0 0 1 18.27 4.56 L 18.84 5.13 "
        + "A 1.8 1.8 0 0 1 18.84 7.67 L 12.47 14.04 A 1.8 1.8 0 0 1 9.93 14.04 "
        + "L 9.36 13.47 A 1.8 1.8 0 0 1 9.36 10.93 Z";
}

// The magnifier: a lens that fills most of its box and a handle cut short, so
// the pair still reads at 16px. Its tint stays the dim one both columns already
// use for search: the mark is drawn and inert until search exists, and a control
// that cannot be clicked should not look like one.
component IconSearch inherits Path {
    in property <color> tint: #8b8c85;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    // the mark's own 2.3 on a 24 viewbox, at the size it is drawn here
    stroke-width: 1.5px;
    stroke-line-cap: butt;
    // the circle is four quarter arcs: no half-turn flag to get wrong
    commands: "M 11 3.5 A 7.5 7.5 0 0 1 18.5 11 A 7.5 7.5 0 0 1 11 18.5 "
        + "A 7.5 7.5 0 0 1 3.5 11 A 7.5 7.5 0 0 1 11 3.5 Z "
        + "M 16.3 16.3 L 20.2 20.2";
}


component QueueRow inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    in property <image> thumb;
    callback act(string, int, string);

    // Two lines, fixed height: the panel stacks rows by arithmetic, so a row
    // that grew with its text would overlap the next one. Wrapped and elided,
    // a long message shows its beginning and where it was cut.
    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? #1f211a : transparent;

    // the text is the edit affordance; it stops short of the button
    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 64px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    if root.thumb.width > 0 : Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.thumb;
            image-fit: cover;
        }
    }

    Text {
        x: root.thumb.width > 0 ? 34px : 6px;
        y: 0;
        width: parent.width - (root.thumb.width > 0 ? 100px : 72px);
        height: 100%;
        text: root.text;
        color: #d9d8d1;
        font-size: 11px;
        // centred: a one-line message sat against the top of a 34px row
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    // editing is a button, not a lucky click on the text: a row whose only way
    // to change is an invisible target looks uneditable
    Rectangle {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: edit.has-hover ? #383c30 : #2c2f26;
        edit := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "edit"); }
        }
        MatEdit {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: edit.has-hover ? #e7e5df : #b0b1a8;
        }
    }

    // a resting surface, not a hover-only one: an action that looks like empty
    // space until the pointer finds it is a hidden control
    Rectangle {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        // colour alone, no outline: the fill sits a clear step above both the
        // panel and the row's hover, which is what keeps the button a button
        background: del.has-hover ? #383c30 : #2c2f26;
        del := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "delete"); }
        }
        IMDeleteoutline {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: del.has-hover ? #f3ded8 : #b0b1a8;
        }
    }
}

// A follow-up row: the same row plus the up arrow that pulls the message into
// the turn that is already running.
component QueueRowUp inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    in property <image> thumb;
    callback act(string, int, string);

    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? #1f211a : transparent;

    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 92px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    if root.thumb.width > 0 : Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.thumb;
            image-fit: cover;
        }
    }

    Text {
        x: root.thumb.width > 0 ? 34px : 6px;
        y: 0;
        width: parent.width - (root.thumb.width > 0 ? 128px : 100px);
        height: 100%;
        text: root.text;
        color: #d9d8d1;
        font-size: 11px;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 84px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: edit.has-hover ? #383c30 : #2c2f26;
        edit := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "edit"); }
        }
        MatEdit {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: edit.has-hover ? #e7e5df : #b0b1a8;
        }
    }

    Rectangle {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: up.has-hover ? #383c30 : #2c2f26;
        up := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "promote"); }
        }
        IconToTop {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: up.has-hover ? #e0cd7c : #a18e41;
        }
    }

    Rectangle {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        // colour alone, no outline: the fill sits a clear step above both the
        // panel and the row's hover, which is what keeps the button a button
        background: del.has-hover ? #383c30 : #2c2f26;
        del := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "delete"); }
        }
        IMDeleteoutline {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: del.has-hover ? #f3ded8 : #b0b1a8;
        }
    }
}


component IconDown inherits Path {
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: #b6b2a4;
    stroke-width: 1.6px;
    fill: transparent;
}

component IconCaret inherits Path {
    in property <bool> up;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: up ? "M 2 6.5 L 5 3.5 L 8 6.5" : "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: #7a7c72;
    stroke-width: 1.3px;
    fill: transparent;
}

component IconSend inherits Path {
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 6 10.5 L 6 2 M 2.2 5.8 L 6 2 L 9.8 5.8";
    stroke: #12130f;
    stroke-width: 1.6px;
    fill: transparent;
}

component IconAlert inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: "M 7 3.5 L 7 8.0 M 7 9.5 L 7 10.5";
    stroke: #f3ded8;
    stroke-width: 2px;
    fill: transparent;
}

component StatusDot inherits Rectangle {
    in property <string> status;
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background: status == "working" ? #a18e41 : status == "parked" ? #4a4d44 : #6f9f5f;
}

component SessionRow inherits Rectangle {
    in property <SessionItem> item;
    in property <bool> selected;
    in property <bool> editing;
    in-out property <string> draft;
    callback picked(string);
    // the row's own window position rides along, so the card can sit beside it
    callback hovered(string, length);
    callback edit(string);
    callback commit(string, string);
    // the row's own pointer state, so the component can watch it change: a
    // `changed` block only takes an identifier, and `ta.has-hover` is not one
    out property <bool> hot: ta.has-hover;

    height: 32px;
    border-radius: 6px;
    background: selected ? #1d1e19 : (ta.has-hover ? #171814 : transparent);

    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 30px;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(root.item.id); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered(root.item.tip, self.absolute-position.y);
            }
        }
    }

    // Leaving the row is the half `move` cannot report: walking up into the
    // blank band above the list produces no further move inside the row, so the
    // card used to sit there until the timer gave up. The `changed` block lives
    // on the row rather than inside the TouchArea - inside it, a has-hover
    // change eats the click that follows.
    changed hot => {
        if !hot {
            root.hovered("", 0px);
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            clip: true;

            // a name longer than the sidebar travels while the row is hovered;
            // left alone the row is clipped where it lies, as it always was
            if !root.editing : MarqueeText {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.item.name;
                text-color: root.selected ? #e7e5df : #b0b1a8;
                font-size: Type.item;
                active: ta.has-hover;
            }

            if root.editing : input := TextInput {
                text: root.draft;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                color: #e7e5df;
                font-size: Type.item;
                single-line: true;
                edited => { root.draft = self.text; }
                accepted => { root.commit(root.item.id, root.draft); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.commit(root.item.id, root.item.full);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                init => { self.focus(); }
            }
        }

        Rectangle {
            width: 18px;
            height: 32px;
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: edit-touch.has-hover ? #2a2c24 : #1d1e19;
                visible: !root.editing;
                opacity: ta.has-hover || edit-touch.has-hover ? 1 : 0;
                animate opacity { duration: 100ms; }
                IconPencil {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                edit-touch := TouchArea {
                    enabled: !root.editing;
                    clicked => { root.edit(root.item.id); }
                }
            }
        }

        Rectangle {
            width: age-text.preferred-width;
            height: 32px;
            age-text := Text {
                text: root.item.age;
                color: #565a4f;
                font-size: 10px;
                height: parent.height;
                vertical-alignment: center;
                opacity: root.editing ? 0 : 1;
            }
        }

        Rectangle {
            width: 5px;
            height: 32px;
            StatusDot {
                y: (parent.height - self.height) / 2;
                status: root.item.status;
                opacity: root.editing ? 0 : 1;
            }
        }
    }
}

component TranscriptRow inherits VerticalLayout {
    spacing: 0px;
    property <bool> err-hover: false;

    in property <TRow> data;
    callback toggle();
    // where the failure reason should be drawn: at the window's root, not in
    // this row, or the row beneath paints over it
    callback reason-hover(string, length, length);
    callback reason-leave();

    if data.kind == 0 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            background: #2e2916;
            border-radius: 10px;
            width: min(self.preferred-width, 560px);
            height: self.preferred-height;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                StyledText {
                    text: data.body;
                    default-color: #e7e5df;
                    default-font-size: Type.body;
                    link-color: #a18e41;
                }
            }
        }
    }

    if data.kind == 1 : Rectangle {
        height: agent-text.preferred-height + 12px;
        agent-text := StyledText {
            x: 24px;
            y: 6px;
            width: parent.width - 48px;
            text: data.body;
            default-color: #d2d1ca;
            default-font-size: Type.body;
            link-color: #a18e41;
        }
    }

    if data.kind == 2 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            width: self.preferred-width;
            height: 24px;
            border-radius: 6px;
            background: think-touch.has-hover ? #1a1b17 : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text { text: "thinking"; color: #6b6c65; font-size: 10px; vertical-alignment: center; }
                Text { text: data.meta; color: #4a4d44; font-size: 10px; vertical-alignment: center; }

                Rectangle {
                    width: 10px;
                    height: 24px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }
            }
            think-touch := TouchArea { clicked => { root.toggle(); } }
        }

        if data.expanded : Rectangle {
            background: #0f100d;
            border-color: #1e201a;
            border-width: 1px;
            border-radius: 8px;
            height: min(think-text.preferred-height + 24px, 6 * think-probe.preferred-height + 24px);
            think-probe := Text {
                x: -200px;
                y: 0px;
                text: "x";
                font-family: "Cascadia Code";
                font-size: 11px;
                opacity: 0;
            }
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    think-text := StyledText {
                        text: data.body;
                        default-color: #7e8076;
                        default-font-family: "Cascadia Code";
                        default-font-size: 11px;
                    }
                }
            }
        }
    }

    if data.kind == 3 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            height: 26px;
            border-radius: 6px;
            background: data.failed
                ? (cell-hot ? #241713 : #1d1412)
                : (cell-hot ? #181a14 : #14160f);

            property <bool> cell-hot: cell-touch.has-hover || root.err-hover;

            cell-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                clicked => { root.toggle(); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;

                Rectangle {
                    width: 10px;
                    height: 26px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }

                Text {
                    text: data.title;
                    color: data.failed ? #c98a7f : #8b8c85;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text { text: data.meta; color: #4a4d44; font-size: 10px; vertical-alignment: center; }
                // the separator is full white so the run reads as two parts
                // instead of a sentence ending in a full stop
                Text {
                    text: "\u{00b7}";
                    color: #ffffff;
                    font-size: 10px;
                    vertical-alignment: center;
                    visible: data.elapsed != "";
                }
                Text {
                    text: data.elapsed;
                    color: #4a4d44;
                    font-size: 10px;
                    vertical-alignment: center;
                    visible: data.elapsed != "";
                }

                if data.failed : Rectangle {
                    width: 14px;
                    height: 26px;
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: err-touch.has-hover ? #8d4235 : #6b342b;
                        // the glyph is drawn in the badge's own box: at its
                        // default 16px it overhangs a 14px ring, and its stroke
                        // lands a pixel right and a pixel down of the centre
                        IconAlert {
                            width: parent.width;
                            height: parent.height;
                        }
                        err-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            changed has-hover => {
                                root.err-hover = self.has-hover;
                                if self.has-hover {
                                    root.reason-hover(
                                        data.reason,
                                        self.absolute-position.x,
                                        self.absolute-position.y + self.height,
                                    );
                                } else {
                                    root.reason-leave();
                                }
                            }
                        }
                    }
                }
            }


        }

        if data.expanded : Rectangle {
            background: #0f100d;
            border-color: #23251f;
            border-width: 1px;
            border-radius: 8px;
            height: self.preferred-height;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                StyledText {
                    text: data.code;
                    default-color: #cfd3c8;
                    default-font-family: "Cascadia Code";
                    default-font-size: 12px;
                }
                if data.has-output : Rectangle {
                    height: 1px;
                    background: #1e201a;
                }
                if data.has-output : StyledText {
                    text: data.output;
                    default-color: data.failed ? #c98a7f : #8f9187;
                    default-font-family: "Cascadia Code";
                    default-font-size: 11px;
                }
            }
        }
    }

    if data.kind == 5 : HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: data.title;
            color: #4a4d44;
            font-size: 10px;
        }
    }

    // A fenced block: its own surface, mono, the language named in the corner
    // the way a code card names it. The colours are the TUI's mdCodeBlock (a
    // sage) and its syntax palette, warmed to sit in this theme.
    if data.kind == 6 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 5px;
        padding-bottom: 5px;
        Rectangle {
            height: code-text.preferred-height + 24px + (data.meta == "" ? 0px : 15px);
            background: #0d0e0b;
            border-radius: 8px;

            Text {
                x: 12px;
                y: 9px;
                text: data.meta;
                color: #565a4f;
                font-size: 9px;
                visible: data.meta != "";
            }
            code-text := StyledText {
                x: 12px;
                y: 12px + (data.meta == "" ? 0px : 15px);
                width: parent.width - 24px;
                text: data.code;
                default-color: #b3bb9e;
                default-font-size: 11.5px;
                default-font-family: "Cascadia Code";
            }
        }
    }

    // A table, box-drawn as text: it stays copyable and needs no cell model.
    if data.kind == 7 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 5px;
        padding-bottom: 5px;
        table-text := StyledText {
            text: data.body;
            default-color: #a9ab9d;
            default-font-size: 11px;
            default-font-family: "Cascadia Code";
        }
    }
    // an image the user sent: the picture itself, thumbnailed, on the same edge
    // as the bubble so the sent turn reads as one thing
    if data.kind == 8 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        Rectangle {
            width: 220px;
            height: 150px;
            background: #1a1c16;
            border-radius: 10px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: data.image;
                image-fit: contain;
            }
        }
    }
}


// One line of the context ledger: the label, then the value flush right in a
// fixed slot so the whole column of numbers has one edge to line up on.
component Ledger inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> ink: #b0b1a8;
    height: 16px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: #6b6e63;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.value;
            color: root.ink;
            font-size: 10.5px;
            width: 58px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// The context card, shared by the ring's hover popup and the right column: the
// window first (how close the session is to forgetting), then the counts, then
// the money - one question at two scales.
component ContextCard inherits Rectangle {
    in property <float> fill: 0.0;
    in property <string> used: "";
    in property <string> percent: "";
    in property <string> messages: "";
    in property <string> tools: "";
    in property <string> input: "";
    in property <string> output: "";
    in property <string> cached: "";
    in property <string> cost: "";
    in property <string> cost-family: "";
    in property <bool> cost-family-on: false;
    background: transparent;
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            Text {
                text: "context";
                color: #6b6e63;
                font-size: 10px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.percent;
                color: #e7e5df;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        // the bar answers "how close am I" before a single number is read
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: #23251f;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * root.fill;
                border-radius: 1.5px;
                background: #a18e41;
            }
        }
        Text {
            text: root.used;
            color: #8b8c85;
            font-size: 10px;
        }
        Rectangle { height: 1px; background: #1c1e19; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 1px;
            Ledger { label: "messages"; value: root.messages; }
            Ledger { label: "tools"; value: root.tools; }
            Ledger { label: "in"; value: root.input; }
            Ledger { label: "out"; value: root.output; }
            Ledger { label: "cached"; value: root.cached; }
        }
        Rectangle { height: 1px; background: #1c1e19; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 1px;
            Ledger { label: "cost"; value: root.cost; ink: #d9d7cd; }
            if root.cost-family-on : Ledger {
                label: "with subagents";
                value: root.cost-family;
                ink: #d9d7cd;
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback toggled;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    // The resting state is what the old hover state was: a chip that only
    // appears under the pointer reads as decoration, not as a control.
    background: ct.has-hover || open ? #23251f : #1a1b16;
    border-color: ct.has-hover || open ? #33362d : #23251f;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.label;
            color: ct.has-hover || open ? #e7e5df : #b0b1a8;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 10px;
            height: 24px;
            IconCaret {
                y: (parent.height - self.height) / 2;
                up: root.open;
            }
        }
    }
    ct := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}









// ---- custom title bar -------------------------------------------------------
// Windows draws nothing here: titlebar.rs makes the frame invisible while keeping
// its behaviours, so this row *is* the caption. Geometry must agree with HEIGHT
// and BUTTON in src/titlebar.rs.

component CaptionButton inherits Rectangle {
    in property <bool> hover;
    in property <color> hover-fill: #ffffff12;
    width: 46px;
    height: 100%;
    background: hover ? hover-fill : transparent;
}

component CaptionGlyph inherits Path {
    in property <color> tint: #d7d7d1;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    stroke: tint;
    stroke-width: 1px;
    fill: transparent;
}

component TitleBar inherits Rectangle {
    in property <bool> right-open: false;
    callback toggle-right();
    in property <bool> maximized: false;
    in property <bool> max-hover: false;
    in property <string> caption: "Prime Agent Desktop";
    callback minimize();
    callback close();
    callback menu();

    height: 32px;
    width: 100%;
    background: #0c0d0a;

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("../assets/icon-tile-32.png");
    }

    // the icon is a button: left-click drops the system menu, like the native caption
    icon-touch := TouchArea {
        x: 6px;
        y: 0;
        width: 28px;
        height: 100%;
        clicked => { root.menu(); }
    }

    Text {
        x: 36px;
        // Windows sits caption ink about a pixel below the bar's centre (asymmetric
        // font ascent/descent); match that instead of centring the box exactly.
        y: (parent.height - self.height) / 2 - 1px;
        text: root.caption;
        color: #b9bab2;
        font-size: 12px;
        vertical-alignment: center;
    }

    // The right column's fold lives in the chrome, not in the column: the column is
    // blank, so a mark inside it would have nothing to sit on.
    right-toggle := Rectangle {
        x: parent.width - 172px;
        y: (parent.height - 26px) / 2;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: right-touch.has-hover ? #2a2c24 : transparent;
        PanelIcon {
            x: 5px;
            y: 5px;
            folded-edge-right: true;
            arrow: right-touch.has-hover;
            point-left: !root.right-open;
            tint: right-touch.has-hover ? #e7e5df : #6d7066;
        }
        right-touch := TouchArea {
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Toggle the right column";
            clicked => { root.toggle-right(); }
        }
    }

    // minimise and close are ours; maximise belongs to Windows for Snap Layouts
    min-button := CaptionButton {
        x: parent.width - 138px;
        hover: min-touch.has-hover;
        min-touch := TouchArea { clicked => { root.minimize(); } }
        CaptionGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2; commands: "M 0.5 5.5 L 9.5 5.5"; }
    }

    max-button := CaptionButton {
        x: parent.width - 92px;
        hover: root.max-hover;
        CaptionGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            commands: root.maximized
                ? "M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z"
                : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
        }
    }

    close-button := CaptionButton {
        x: parent.width - 46px;
        hover: close-touch.has-hover;
        hover-fill: #c42b1c;
        close-touch := TouchArea { clicked => { root.close(); } }
        CaptionGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: close-touch.has-hover ? #ffffff : #d7d7d1;
            commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
        }
    }

    // no rule under the caption: the bar and the body meet in one flat field,
    // because the frame around them draws nothing to stop against
}

export component AppWindow inherits Window {
    // the failure reason of a cell, drawn here so no row can paint over it
    in-out property <bool> reason-open;
    in-out property <length> reason-x;
    in-out property <length> reason-y;
    in-out property <string> reason-text;
    title: "Prime Agent Desktop";

    // the custom title bar, driven from src/titlebar.rs
    callback titlebar-minimize();
    callback titlebar-close();
    callback titlebar-menu();
    in-out property <bool> titlebar-maximized: false;
    in-out property <bool> titlebar-max-hover: false;

    // The drag surface is the whole window, so the pointer can never leave it
    // mid-drag, and it measures the pointer in window coordinates: anchored to
    // the composer box it moved as the box grew, which is what made the drag
    // stutter and lose the pointer.
    drag-surface := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: root.handle-hover || root.dragging ? MouseCursor.row-resize
            : MouseCursor.default;
        // a click that lands on nothing in particular dismisses the model menu
        clicked => { root.model-menu = false; root.queue-open = false; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-moved();
            }
            if event.kind == PointerEventKind.down {
                // only the handle starts a drag; the rest of the band belongs
                // to the chip and the model menu
                if root.handle-hover {
                    root.dragging = true;
                    root.band-freeze = root.composer-total;
                    root.last-pointer-y = drag-surface.mouse-y;
                }
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
            if event.kind == PointerEventKind.move && root.dragging {
                let step = root.last-pointer-y - drag-surface.mouse-y;
                root.last-pointer-y = drag-surface.mouse-y;
                if step > -60px && step < 60px {
                    root.composer-height = clamp(
                        root.composer-height + step,
                        root.composer-min,
                        root.composer-max
                    );
                }
            }
        }
    }

    // no fixed width/height: a fixed size leaves the new area blank when the
    // user resizes the window, because the root keeps its declared size
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 820px;
    background: #12130f;
    default-font-family: "Segoe UI";

    in property <[SessionItem]> sessions;
    in property <[TRow]> transcript;
    in property <[ModelGroup]> model-groups;
    // how tall the menu needs to be for the groups that are open
    in-out property <length> model-menu-height: 0px;
    in-out property <string> model-provider: "";
    in property <length> menu-width: 180px;
    in-out property <string> model-id;
    // the running model's thinking level: the wire word (`max`) and the name
    // the menu shows (`Max`)
    in-out property <string> current-effort;
    in-out property <string> current-level;
    out property <length> box-x: composer-box.absolute-position.x;
    out property <length> box-y: composer-box.absolute-position.y;
    out property <length> box-w: composer-box.width;
    // the effort submenu: open while a hovered row has a ladder to choose from
    in-out property <bool> effort-open: false;
    in-out property <length> effort-y: 0px;
    in-out property <[EffortItem]> effort-items;
    in-out property <string> model-label: "model";
    in-out property <string> title-text: "";
    in-out property <string> draft: "";
    in-out property <string> composer-text: "";
    // The command word, drawn in the accent in front of the caret: it stays gold
    // while the argument is typed, which a single-colour text box cannot do for
    // one word out of many.
    in-out property <string> composer-command: "";
    in-out property <length> command-word-width: 0px;
    // where the caret should land once new text has arrived (byte offset)
    in-out property <int> composer-caret-request: -1;
    // canvas mode (PA_CANVAS=1): the words are painted by Rust so a command can be
    // gold wherever it sits; off, everything behaves as it always has
    in-out property <bool> canvas-mode: false;
    in property <image> composer-canvas;
    in-out property <length> composer-canvas-height: 18px;
    in-out property <length> composer-caret-x: 0px;
    in-out property <length> composer-caret-y: 0px;
    in-out property <length> composer-caret-height: 18px;
    out property <int> composer-caret: draft-window.caret-offset;
    out property <int> composer-anchor: draft-window.anchor-offset;
    out property <length> composer-width: draft-window.width;
    // The command menu: every builtin the daemon knows, narrowed by what is
    // typed after the slash. It answers keys before the composer does, so Enter
    // picks the highlighted command instead of sending half a word.
    in-out property <[SlashItem]> slash-items;
    in-out property <bool> slash-open: false;
    in-out property <int> slash-index: 0;
    // the menu takes the keys it wants before the message box sees them
    public function slash-take(event: KeyEvent) -> bool {
        if !root.slash-open || root.slash-items.length == 0 {
            return false;
        }
        if event.text == Key.DownArrow {
            root.slash-move(1);
            return true;
        }
        if event.text == Key.UpArrow {
            root.slash-move(-1);
            return true;
        }
        if event.text == Key.Escape {
            root.slash-dismiss();
            return true;
        }
        if event.text == Key.Return || event.text == Key.Tab {
            root.slash-accept();
            return true;
        }
        false
    }
    in-out property <int> queued-count: 0;
    // the two lanes, kept apart: one runs inside this turn, one after it
    in property <[QueueItem]> queued-steering;
    in property <[QueueItem]> queued-followup;
    in-out property <bool> queue-open: false;
    // the queue panel's geometry, in one place: its rows are stacked by
    // arithmetic, and every y below is a sum of these
    out property <length> q-head-in: root.queued-steering.length > 0 ? 20px : 0px;
    out property <length> q-rows-in: root.queued-steering.length * 34px;
    out property <length> q-head-next: root.queued-followup.length > 0 ? 20px : 0px;
    out property <length> q-rows-next: root.queued-followup.length * 34px;
    out property <length> q-lane-gap: root.queued-steering.length > 0
        && root.queued-followup.length > 0 ? 8px : 0px;
    out property <length> q-content-h: root.q-head-in + root.q-rows-in + root.q-lane-gap
        + root.q-head-next + root.q-rows-next + 24px;
    out property <length> q-scroll-h: min(root.q-content-h, 288px);
    in-out property <string> queued-preview: "";
    in-out property <float> context-fill: 0.0;
    // composer input height; the pill on its top border toggles it
    in-out property <length> composer-height: 68px;
    in-out property <[image]> attachment-images: [];
    // 44px tiles plus the layout's 10px spacing plus a hairline of slack
    out property <length> attach-h: root.attachment-images.length > 0 ? 62px : 0px;
    animate attach-h { duration: 170ms; easing: ease-out; }
    // input + box chrome (10+8 padding, 10 spacing, 24 button row, 2 borders)
    // + strip (24) + band padding (8+10)
    // 13px text is ~17px per line: 4 lines by default, 10 at most
    out property <length> composer-min: 68px;
    out property <length> composer-max: 170px;
    // the band is exactly the box plus the 12px pad under it; the queue line
    // and the jump control live elsewhere, so nothing else needs reserving
    // queued chip sits above the box, so the transcript has to stop short of it
    // the popup is drawn at the window root (a child at negative y paints but
    // cannot be hit), so it anchors off the composer box, which never moves
    // The band reserves 34px above the box for the chip, and - while a turn is
    // running - the busy row plus another 34px above it, so the gap that keeps
    // the transcript off the input sits above the status line instead of below.
    // The status strip grows open and shuts fast. Everything that has to move
    // with it reads this one length: the strip's height, the box's height, the
    // padding above the input, and the band the transcript stops at.
    // the strip is the home of the queue as well, so it opens while anything is
    // waiting even if the turn that queued it has just ended
    in-out property <length> busy-h: root.busy || root.queued-count > 0 ? 26px : 0px;
    animate busy-h {
        duration: root.busy ? 190ms : 110ms;
        easing: root.busy ? ease-out : ease-in;
    }
    // the contents come in a beat after the gap opens, and go before it shuts
    in-out property <float> busy-fade: root.busy || root.queued-count > 0 ? 1.0 : 0.0;
    animate busy-fade {
        duration: root.busy ? 150ms : 90ms;
        delay: root.busy ? 60ms : 0ms;
        easing: ease-out;
    }
    out property <length> composer-total: root.box-height + 46px + root.busy-h;
    // box chrome around the input: 10+8 padding, 10 spacing, 24 button row, 2 borders
    out property <length> box-height: root.composer-height + 54px + root.attach-h;
    in-out property <bool> dragging: false;
    // where the handle actually sits, in window coordinates: the drag surface
    // is the whole window, so the press has to be tested against it
    out property <length> handle-cy: composer-band.absolute-position.y + 34px + root.busy-h;
    out property <length> handle-cx: composer-band.absolute-position.x + composer-band.width / 2;
    out property <bool> handle-hover: drag-surface.has-hover
        && abs(drag-surface.mouse-x - root.handle-cx) <= 48px
        && abs(drag-surface.mouse-y - root.handle-cy) <= 9px;
    // the band's height at press time: frozen for the gesture so the drag
    // origin (and the clamp on mouse-y) cannot move under the pointer
    in-out property <length> band-freeze: 0px;
    in-out property <length> last-pointer-y: 0px;
    in-out property <length> drag-start-y: 0px;
    in-out property <length> drag-start-h: 0px;
    in-out property <string> context-text: "";
    in-out property <string> ctx-percent: "";
    in-out property <string> stat-messages: "";
    in-out property <string> stat-tools: "";
    in-out property <string> stat-in: "";
    in-out property <string> stat-out: "";
    in-out property <string> stat-cache: "";
    in-out property <string> cost-session: "";
    in-out property <string> cost-family: "";
    in-out property <bool> cost-family-on: false;
    in-out property <bool> ctx-hover: false;
    in-out property <string> editing-id: "";
    in property <string> status-line: "connecting";
    in-out property <string> hover-title: "";
    in-out property <length> hover-y: 0px;
    in-out property <bool> tooltip-on: false;
    in-out property <bool> sidebar-open: true;
    // The right-hand column. It is blank on purpose: the shell exists and nothing
    // lives in it yet.
    in-out property <bool> right-open: false;
    in-out property <bool> model-menu: false;
    in-out property <string> selected-id;

    in property <bool> activity-busy: false;
    in property <string> activity: "idle";
    in property <string> activity-elapsed: "";

    in property <bool> busy: false;
    in property <string> busy-label: "";
    in property <string> busy-elapsed: "";
    in property <string> spinner-frame: "\u{280b}";
    in property <float> shimmer: 0.0;

    callback send-requested(string);
    // the command menu: what is typed after the slash, moving the highlight, and
    // taking the highlighted command
    callback slash-typed(string, int);
    callback slash-move(int);
    callback slash-accept();
    callback slash-dismiss();
    callback composer-command-cleared();
    callback steer-requested(string);
    callback abort-requested();
    // images ride beside the text: the strip is the attachment list, and the
    // prompt carries whatever is in it when the message is sent
    callback attach-requested();
    callback attach-pasted() -> bool;
    callback attachment-removed(int);
    callback model-picked(string, string);
    // a row's effort ladder: which model, and the row's window y to hang from
    callback model-hovered(string, string, length);
    // the pointer is somewhere that is neither a model row nor its ladder:
    // the popup has no reason to stay
    callback pointer-moved();
    // the pointer is on the ladder itself, which keeps it alive
    callback effort-hovered();
    callback effort-picked(int);
    callback model-menu-opened;
    callback provider-toggled(string);
    callback rename-requested(string, string);
    callback toggle-row(int);
    callback queue-act(string, int, string);
    callback queue-clear();
    callback new-chat();
    // 0 while idle, 1 while a run is in flight: the one clock the send button's
    // two marks share
    // Stop is only the button's job while the composer is empty. The moment you
    // type, the same control becomes send again � and sending while a turn runs
    // queues the message instead of interrupting it.
    in-out property <bool> composer-has-text: false;
    out property <bool> stop-mode: root.busy && !root.composer-has-text;
    in-out property <float> stop-mix: root.stop-mode ? 1.0 : 0.0;
    animate stop-mix { duration: 240ms; easing: ease-in-out; }
    // the composer taking the caret is "somewhere else" too
    out property <bool> composer-focused: draft-window.has-focus;

    // A latch, not a measurement: while it is true a new row pulls the view
    // along; the moment the reader touches the wheel or the bar it is false, and
    // nothing can turn it back on except the reader arriving at the floor again.
    // Deriving it from "how close to the bottom am I" every frame is what let a
    // token arriving 16 ms after a drag started yank the page back down.
    in-out property <bool> follow-bottom: true;
    // true from the moment the bar is grabbed until it is let go
    in-out property <bool> scrollbar-dragging: false;
    // the last offset we saw, so a step *towards the top* can be told apart from
    // content growing at the bottom
    in-out property <length> seen-content-y: 0px;
    // set when the reader moves up, cleared only when they are back on the floor
    in-out property <bool> reader-scrolled: false;
    // derived from the scroll offset, so it tracks wheel scrolling without
    // relying on change notifications from the ListView
    out property <length> dbg-cy: transcript-list.content-y;
    out property <length> dbg-ch: transcript-list.content-height;
    out property <length> dbg-h: transcript-list.height;
    changed dbg-cy => {
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }
    out property <bool> at-bottom: transcript-list.content-y <= -root.scroll-range + 80px;
    /// how far the last row is from the floor of the view, in pixels
    out property <length> from-bottom: max(
        0px,
        root.scroll-range + transcript-list.content-y
    );

    // Following is a latch, and stopping to read is not an invitation: once the
    // reader moves up it stays off, through any number of tokens, layout passes
    // and pauses. Three things turn it back on, and all three are gestures: the
    // jump-to-bottom button, sending a message, or the reader scrolling *down*
    // onto the floor with the wheel or the bar.
    //
    // A measurement must never re-arm it. Content growing at the bottom rewrites
    // the scroll offset on the list's own layout pass, and for one frame that
    // made the distance to the floor read as zero � which is how a paused reader
    // got yanked to the bottom.
    // `scrolled` is the window's own "the reader did this" signal: the widget
    // fires it only for a user drag or wheel, never for our programmatic moves
    // and never for the list rewriting its offset while rows are measured. That
    // distinction is the whole fix � a distance measured after a layout pass is
    // not evidence that anybody scrolled.
    /// Called by anything that is definitely the reader's own input.
    public function reader-moved-up() {
        root.reader-scrolled = true;
        root.follow-bottom = false;
    }

    public function reader-reached-floor() {
        if (!root.scrollbar-dragging && root.from-bottom <= 12px && root.bottom-pad <= 1px) {
            root.reader-scrolled = false;
            root.follow-bottom = true;
            root.seen-content-y = transcript-list.content-y;
        }
    }

    in-out property <length> top-pad: 0px;
    in-out property <length> bottom-pad: 0px;
    in-out property <int> window-start: 0;
    callback viewport-scrolled(length, length);
    callback row-measured(int, length);
    in property <bool> has-older: false;
    in property <bool> loading-older: false;
    in property <bool> pager-ready: false;

    in-out property <length> live-vel: 0px;
    in-out property <bool> programmatic-scroll: false;

    public function set-scroll-y(value: length) {
        let preserved-vel = abs(root.flick-vel) > abs(root.live-vel) ? root.flick-vel : root.live-vel;
        root.programmatic-scroll = true;
        transcript-list.content-y = max(-root.scroll-range, min(0px, value));
        root.seen-content-y = transcript-list.content-y;
        root.programmatic-scroll = false;
        if (abs(preserved-vel) > 1.0px && !root.follow-bottom && !root.scrollbar-dragging) {
            root.flick-vel = clamp(preserved-vel, -240px, 240px);
            root.live-vel = root.flick-vel;
        }
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    in-out property <length> prev-scroll-range: 0px;
    out property <length> scroll-range: max(
        0px,
        transcript-list.content-height - transcript-list.height
    );

    changed scroll-range => {
        if (root.follow-bottom && !root.scrollbar-dragging && root.scroll-range >= root.prev-scroll-range && transcript-list.content-y > root.seen-content-y + 1px) {
            root.reader-moved-up();
        }
        // If the scroll range shrank (e.g. busy bar closing) while parked, keep seen-content-y in sync
        if (root.scroll-range < root.prev-scroll-range && root.follow-bottom && !root.scrollbar-dragging) {
            transcript-list.content-y = -root.scroll-range;
            root.seen-content-y = transcript-list.content-y;
        }
        root.prev-scroll-range = root.scroll-range;
    }

    // Smooth 60fps glide toward the floor while follow-bottom is latched
    smooth-follow := Timer {
        interval: 16ms;
        running: root.follow-bottom && !root.scrollbar-dragging && root.from-bottom > 0.5px;
        triggered => {
            if (transcript-list.content-y > root.seen-content-y + 1px && root.from-bottom > 2px) {
                root.reader-moved-up();
                root.seen-content-y = transcript-list.content-y;
                return;
            }
            let target = -root.scroll-range;
            let gap = transcript-list.content-y - target;
            if (gap <= 1.5px) {
                transcript-list.content-y = target;
            } else if (gap > 600px) {
                // On initial session attach or huge jump, close most of the gap and glide the last 140px
                transcript-list.content-y = target + 140px;
            } else {
                transcript-list.content-y = transcript-list.content-y - max(1.5px, gap * 0.28);
            }
            root.seen-content-y = transcript-list.content-y;
        }
    }

    public function scroll-to-ratio(ratio: float) {
        transcript-list.content-y = -max(0.0, min(1.0, ratio)) * root.scroll-range;
        root.seen-content-y = transcript-list.content-y;
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    public function scroll-to-thumb(y: length) {
        let travel = max(1px, transcript-area.height - root.thumb-height);
        root.scroll-to-ratio(y / travel);
    }

    in-out property <length> flick-vel: 0px;

    // 60fps inertial momentum timer (Flickable-style deceleration)
    flick-timer := Timer {
        interval: 16ms;
        running: abs(root.flick-vel) > 0.8px && !root.scrollbar-dragging && !root.follow-bottom;
        triggered => {
            let next-y = max(
                -root.scroll-range,
                min(0px, transcript-list.content-y + root.flick-vel)
            );
            root.programmatic-scroll = true;
            transcript-list.content-y = next-y;
            root.seen-content-y = next-y;
            root.programmatic-scroll = false;
            root.flick-vel = root.flick-vel * 0.91;
            root.live-vel = root.flick-vel;
            if (abs(root.flick-vel) <= 0.8px || (next-y == 0px && !root.has-older) || next-y == -root.scroll-range) {
                root.flick-vel = 0px;
                root.live-vel = 0px;
            }
            if (root.flick-vel < 0px) {
                root.reader-reached-floor();
            }
            root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
        }
    }

    public function page-scroll(direction: int) {
        if (direction < 0) {
            root.reader-moved-up();
        }
        let step = transcript-list.height * 0.82;
        // Impulse into flick velocity for butter-smooth inertial glide
        root.flick-vel = clamp(root.flick-vel - (step * direction) * 0.24, -220px, 220px);
        let immediate = transcript-list.content-y - (step * direction) * 0.18;
        transcript-list.content-y = max(-root.scroll-range, min(0px, immediate));
        root.seen-content-y = transcript-list.content-y;
        if (direction > 0) {
            root.reader-reached-floor();
        }
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    public function step-scroll(direction: int) {
        if (direction < 0) {
            root.reader-moved-up();
        }
        root.flick-vel = clamp(root.flick-vel - (36px * direction), -140px, 140px);
        if (direction > 0) {
            root.reader-reached-floor();
        }
    }

    public function scroll-to-top() {
        root.flick-vel = 0px;
        root.reader-moved-up();
        transcript-list.content-y = 0px;
        root.seen-content-y = 0px;
        root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
    }

    out property <length> thumb-height: max(
        28px,
        min(
            transcript-area.height,
            transcript-area.height * transcript-list.height
                / max(1px, transcript-list.content-height)
        )
    );

    transcript-scope := FocusScope {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.PageUp {
                root.page-scroll(-1);
                return EventResult.accept;
            }
            if event.text == Key.PageDown {
                root.page-scroll(1);
                return EventResult.accept;
            }
            if event.text == Key.UpArrow {
                root.step-scroll(-1);
                return EventResult.accept;
            }
            if event.text == Key.DownArrow {
                root.step-scroll(1);
                return EventResult.accept;
            }
            if event.text == Key.Home && event.modifiers.control {
                root.scroll-to-top();
                return EventResult.accept;
            }
            if event.text == Key.End && event.modifiers.control {
                root.force-scroll-to-end();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    public function force-scroll-to-end() {
        root.reader-scrolled = false;
        root.follow-bottom = true;
        root.seen-content-y = transcript-list.content-y;
    }

    public function scroll-to-end() {
        if (transcript-list.content-y > root.seen-content-y + 1px && root.from-bottom > 2px) {
            root.reader-moved-up();
            root.seen-content-y = transcript-list.content-y;
            return;
        }
    }

    VerticalLayout {
        // room for the custom title bar drawn above this layout
        padding-top: 32px;

        HorizontalLayout {
            // Folded: the column keeps only its controls. The session rows cannot survive
            // at 48px - there is no room for a name - and the caption bar already carries
            // the mark, so drawing it again 30px lower would say the same thing twice.
            if !root.sidebar-open : Rectangle {
                width: 48px;
                background: #10110e;
        
                VerticalLayout {
                    padding-top: 10px;
                    spacing: 4px;
        
                    Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: strip-panel-touch.has-hover ? #2a2c24 : transparent;
                                PanelIcon {
                                    x: 6px;
                                    y: 6px;
                                    arrow: strip-panel-touch.has-hover;
                                    point-left: false;
                                    tint: strip-panel-touch.has-hover ? #e7e5df : #b0b1a8;
                                }
                                strip-panel-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    accessible-role: button;
                                    accessible-label: "Expand sidebar";
                                    clicked => { root.sidebar-open = true; }
                                }
                            }
                        }
                    }
        
                    // New Session, mark only: the label has nowhere to go at this width.
                    Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: strip-new-touch.has-hover ? #23251f : transparent;
                                IconNewChat {
                                    x: 5px;
                                    y: 5px;
                                    tint: strip-new-touch.has-hover ? #e7e5df : #b0b1a8;
                                }
                                strip-new-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    accessible-role: button;
                                    accessible-label: "New Session";
                                    clicked => { root.new-chat(); }
                                }
                            }
                        }
                    }
        
                    // The magnifier again, still drawn and still inert: folded or not,
                    // it holds the same place in the column.
                    Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                IconSearch {
                                    x: 6px;
                                    y: 6px;
                                }
                            }
                        }
                    }
                }
            }
        
            if root.sidebar-open : Rectangle {
                width: 232px;
                background: #10110e;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    spacing: 6px;
                    // The band: the column's own header. The wordmark says whose window
                    // this is; the magnifier is drawn and inert, because search is not
                    // built yet and a button that does nothing is a lie; the panel mark
                    // folds the column away and is the only thing here that is a control.
                    Rectangle {
                        height: 40px;

                        Text {
                            x: 2px;
                            y: (parent.height - self.height) / 2;
                            text: "Prime Agent";
                            color: #e7e5df;
                            font-size: 12px;
                        }

                        // Drawn, not wired: no TouchArea, no callback, no pointer.
                        // It holds the band's shape until search exists.
                        Rectangle {
                            x: parent.width - 56px;
                            y: (parent.height - 26px) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            IconSearch {
                                x: 5px;
                                y: 5px;
                            }
                        }

                        // The fold: a frame with its edge turning away, on a round
                        // hit area, the way the reference draws it.
                        Rectangle {
                            x: parent.width - 26px;
                            y: (parent.height - 26px) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: panel-touch.has-hover ? #2a2c24 : transparent;
                            PanelIcon {
                                x: 5px;
                                y: 5px;
                                arrow: panel-touch.has-hover;
                                point-left: root.sidebar-open;
                                tint: panel-touch.has-hover ? #e7e5df : #b0b1a8;
                            }
                            panel-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "Collapse sidebar";
                                clicked => { root.sidebar-open = !root.sidebar-open; }
                            }
                        }
                    }

                    // The primary action of the column, at full width, because it is
                    // the one thing a session list is for. It calls the same new-chat
                    // the folded strip does: a layout change, not a lifecycle change.
                    Rectangle {
                        height: 36px;
                        border-radius: 10px;
                        background: new-session-touch.has-hover ? #23251f : #1a1b16;

                        IconNewChat {
                            x: 9px;
                            y: (parent.height - self.height) / 2;
                            tint: new-session-touch.has-hover ? #e7e5df : #b0b1a8;
                        }

                        Text {
                            x: 32px;
                            y: (parent.height - self.height) / 2;
                            text: "New Session";
                            color: new-session-touch.has-hover ? #ffffff : #e7e5df;
                            font-size: 12px;
                        }

                        new-session-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "New Session";
                            clicked => { root.new-chat(); }
                        }
                    }



                    ListView {
                        for item in root.sessions : SessionRow {
                            item: item;
                            selected: item.id == root.selected-id;
                            editing: item.id == root.editing-id;
                            draft <=> root.draft;
                            picked(id) => {
                                root.model-menu = false;
                                root.selected-id = id;
                                // a picked row drops the card: leaving hover as the
                                // only way to clear it made it look stuck
                                root.hover-title = "";
                            }
                            hovered(full, row-y) => {
                                if full != "" {
                                    root.hover-y = row-y;
                                }
                                root.hover-title = full;
                                // hover rots: hide the card if it stops being fed,
                                // which is what made a stale title look stuck.
                                // Toggling restarts the timer: `running` is bound,
                                // so calling restart() on it would be overridden.
                                root.tooltip-on = false;
                                root.tooltip-on = true;
                            }
                            edit(id) => { root.editing-id = id; root.draft = item.full; }
                            commit(id, name) => {
                                root.editing-id = "";
                                root.rename-requested(id, name);
                            }
                        }
                    }
                }
            }

            // explicit geometry: a Rectangle's preferred size never reflects its
            // children in Slint, so a layout here always under-measured the
            // composer and let it spill past the window
            center-column := Rectangle {

                    transcript-area := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - root.composer-total;
                        background: #12130f;

                        area-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move {
                                    root.hover-title = "";
                                }
                                // this area takes the press, so the drag surface
                                // below never reports the click it should have seen
                                if event.kind == PointerEventKind.down {
                                    // the page keys follow the pointer: clicking
                                    // the transcript lets Page Up/Down scroll it
                                    transcript-scope.focus();
                                }
                            }
                        }

                                                transcript-list := Flickable {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            flicked => {
                                if (root.programmatic-scroll) {
                                    return;
                                }
                                let delta = transcript-list.content-y - root.seen-content-y;
                                if (abs(delta) > 0.5px) {
                                    root.live-vel = clamp(delta, -220px, 220px);
                                }
                                if (delta > 0.5px && root.from-bottom > 2px) {
                                    root.reader-moved-up();
                                } else if (delta < -0.5px && root.from-bottom <= 12px && root.bottom-pad <= 1px) {
                                    root.reader-reached-floor();
                                }
                                // Smoothly boost wheel impulses into inertial coasting
                                if (!root.scrollbar-dragging && abs(delta) >= 20px && abs(delta) <= 300px) {
                                    root.programmatic-scroll = true;
                                    transcript-list.content-y = root.seen-content-y + delta * 0.45;
                                    root.programmatic-scroll = false;
                                    root.flick-vel = clamp(root.flick-vel + delta * 0.32, -240px, 240px);
                                    root.live-vel = root.flick-vel;
                                }
                                root.seen-content-y = transcript-list.content-y;
                                root.viewport-scrolled(transcript-list.content-y, transcript-list.height);
                            }
                            VerticalLayout {
                                width: transcript-list.width;
                                alignment: start;
                                spacing: 0px;
                                Rectangle {
                                    width: 1px;
                                    height: root.top-pad;
                                }
                                for item[i] in root.transcript : TranscriptRow {
                                    width: transcript-list.width;
                                    data: item;
                                    init => {
                                        root.row-measured(root.window-start + i, self.height);
                                    }
                                    changed height => {
                                        root.row-measured(root.window-start + i, self.height);
                                    }
                                    toggle => {
                                        root.model-menu = false;
                                        root.toggle-row(root.window-start + i);
                                    }
                                    reason-hover(reason, x, y) => {
                                        root.reason-text = reason;
                                        root.reason-x = x;
                                        root.reason-y = y;
                                        root.reason-open = true;
                                    }
                                    reason-leave => {
                                        root.reason-open = false;
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: root.bottom-pad;
                                }
                            }
                        }

                        // The transcript's scrollbar: a track that takes the
                        // whole height, so a drag keeps working once the thumb
                        // has moved out from under the pointer.
                        scroll-bar := Rectangle {
                            x: transcript-area.width - self.width;
                            y: 0;
                            width: 10px;
                            height: transcript-area.height;
                            background: transparent;
                            visible: transcript-list.content-height > transcript-list.height;

                            property <length> travel: max(0px, self.height - root.thumb-height);
                            property <length> thumb-y: max(
                                0px,
                                min(
                                    self.travel,
                                    (-transcript-list.content-y) / max(1px, root.scroll-range) * self.travel
                                )
                            );
                            property <length> grabbed: 0px;
                            property <bool> dragged: false;

                            Rectangle {
                                x: 2px;
                                y: scroll-bar.thumb-y;
                                width: 6px;
                                height: root.thumb-height;
                                border-radius: 3px;
                                background: bar-touch.pressed ? #565a4f : bar-touch.has-hover ? #43463c : #2f322a;
                                animate background { duration: 120ms; }
                            }

                            bar-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        scroll-bar.dragged = false;
                                        scroll-bar.grabbed = self.mouse-y - scroll-bar.thumb-y;
                                        root.scrollbar-dragging = true;
                                        root.reader-moved-up();
                                    }
                                    if event.kind == PointerEventKind.up
                                        || event.kind == PointerEventKind.cancel
                                    {
                                        root.scrollbar-dragging = false;
                                        root.reader-reached-floor();
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        scroll-bar.dragged = true;
                                        root.reader-moved-up();
                                        if (scroll-bar.grabbed >= 0px && scroll-bar.grabbed <= root.thumb-height) {
                                            root.scroll-to-thumb(self.mouse-y - scroll-bar.grabbed);
                                        } else {
                                            root.scroll-to-thumb(self.mouse-y - root.thumb-height / 2);
                                        }
                                    }
                                }
                                clicked => {
                                    if (!scroll-bar.dragged && (scroll-bar.grabbed < 0px || scroll-bar.grabbed > root.thumb-height)) {
                                        root.reader-moved-up();
                                        root.scroll-to-thumb(self.mouse-y - root.thumb-height / 2);
                                        root.reader-reached-floor();
                                    }
                                }
                            }
                        }

                        // floating just above the status row, aligned with the
                    // context ring: detached from the composer
                    if !root.at-bottom : Rectangle {
                        x: transcript-area.width - self.width - 22px;
                        y: transcript-area.height - self.height - 10px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: jump-touch.has-hover ? #2e3026 : #1b1d18;
                        border-color: #34372e;
                        border-width: 1px;
                        IconDown {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        jump-touch := TouchArea {
                            clicked => { root.force-scroll-to-end(); }
                            mouse-cursor: pointer;
                        }
                    }

                    }

                    // live status row: TUI-style � one cell size for glyph and label
                    // always present: an `if`-created subtree got no hover tracking

                composer-band := Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: root.dragging ? root.band-freeze : root.composer-total;
                    background: transparent;

                    // handle, drawn on the box's top border
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: composer-box.y - 1.5px;
                        width: 36px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: root.dragging ? #6b7059
                            : (root.handle-hover ? #4a4d42 : #33362d);
                    }



    // The status row is its own rounded top, tucked 12px behind the box: while
    // a turn runs you see two rounded tops (a small one above the input's), and
    // the corner of the strip is the one that grows.
    busy-row := Rectangle {
        x: 18px;
        y: composer-box.y - root.busy-h;
        width: parent.width - 36px;
        height: root.busy-h + 12px;
        opacity: root.busy-fade;
        // No background on this rectangle at all: its own rounded corner would
        // draw a second edge a pixel off the stroke. The fill is a child, inset
        // by exactly the stroke width.

        // The outline: a border-coloured rounded rect with a fill-coloured one
        // inset by a pixel, both clipped at the strip's *visible* height. The
        // clip cuts away the bottom edge, so what is left is a rounded top and
        // two straight sides - the curvature is the rectangle's own, which is
        // the only way to get it the right way round without stroked paths.
        // The fill reaches 12px past the junction and is square by then, so it
        // wraps the box's rounded corner instead of leaving bare background in
        // the wedge between the two outlines. The box paints over the rest.
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height + 24px;
                background: #2c2f26;
                border-radius: 12px;
            }
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height + 24px;
                background: #191a14;
                border-radius: 11px;
            }
        }

        // the visible half of the strip: everything above the box's top edge
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: root.busy-h;

                            spin := Text {
                                x: 14px;
                                visible: root.busy-h > 1px;
                                text: root.spinner-frame;
                                color: #c9a86a;
                                font-family: "Cascadia Code";
                                font-size: 19px;
                                height: parent.height;
                                vertical-alignment: center;
                            }

                            lbl := Text {
                                x: spin.x + spin.width + 4px;
                                visible: root.busy-h > 1px;
                                text: root.busy-label;
                                color: #c9a86a;
                                font-family: "Cascadia Code";
                                font-size: 11px;
                                height: parent.height;
                                vertical-alignment: center;
                            }

                            Text {
                                x: lbl.x + lbl.width + 8px;
                                visible: root.busy-h > 1px;
                                text: root.busy-elapsed;
                                color: #565a4f;
                                font-family: "Cascadia Code";
                                font-size: 11px;
                                height: parent.height;
                                vertical-alignment: center;
                            }

                            // The queue lives on the strip itself: the lanes
                            // named the way the panel names them, right-aligned
                            // against the strip's padding so it balances the
                            // spinner on the left. The pill only appears under
                            // the pointer - at rest it is part of the strip.
                            if root.queued-count > 0 : Rectangle {
                                x: parent.width - self.width - 14px;
                                y: (parent.height - self.height) / 2;
                                width: lane-row.preferred-width + 16px;
                                height: 18px;
                                border-radius: 6px;
                                background: lane-touch.has-hover || root.queue-open ? #1f211a : transparent;

                                lane-row := HorizontalLayout {
                                    // full width with centred alignment: the
                                    // contents are centred in the pill by the
                                    // layout itself, not by arithmetic on a
                                    // guessed preferred width
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: root.queued-count;
                                        color: lane-touch.has-hover ? #e7e5df : #b0b1a8;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "queued";
                                        color: lane-touch.has-hover ? #b0b1a8 : #6b6e63;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                lane-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.queue-open = !root.queue-open;
                                    }
                                }
                            }

                            }
    }

                    composer-box := Rectangle {
                    x: 18px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 36px;
                    height: root.box-height;
    background: #0f100d;
    border-color: #23251f;
    border-width: 1px;
    border-radius: 12px;

    // the handle drawn on the box's top border
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: -self.height / 2;
        width: 36px;
        height: 3px;
        border-radius: 1.5px;
        background: root.dragging ? #6b7059
            : (root.handle-hover ? #4a4d42 : #33362d);
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 10px;
        // a fixed-height window over a text input that is allowed to grow:
        // pinning its bottom edge keeps the caret (newest line) in view, which
        // a fixed-height TextInput does not do on its own
        // thumbnails, 44px tiles at an 8px pitch, only while something is attached
        if root.attachment-images.length > 0 : Rectangle {
            height: 52px;
            clip: true;
            background: transparent;
            HorizontalLayout {
                y: (parent.height - 44px) / 2;
                spacing: 8px;
                for image[i] in root.attachment-images : Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 8px;
                    clip: true;
                    background: #191a15;
                    border-width: 1px;
                    border-color: thumb-touch.has-hover ? #3a3d32 : #2a2c24;

                    Image {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        source: image;
                        image-fit: cover;
                    }
                    thumb-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.attachment-removed(i); }
                    }
                    // the � only shows when the pointer is on the tile: a strip of
                    // crosses at rest reads as a toolbar, not as your attachment
                    Rectangle {
                        x: parent.width - 17px;
                        y: 3px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: #0b0c09;
                        opacity: thumb-touch.has-hover ? 0.92 : 0.0;
                        animate opacity { duration: 120ms; }
                        Rectangle {
                            x: (parent.width - 7px) / 2;
                            y: (parent.height - 1.5px) / 2;
                            width: 7px;
                            height: 1.5px;
                            border-radius: 0.75px;
                            background: #d9d6cc;
                            transform-rotation: 45deg;
                        }
                        Rectangle {
                            x: (parent.width - 7px) / 2;
                            y: (parent.height - 1.5px) / 2;
                            width: 7px;
                            height: 1.5px;
                            border-radius: 0.75px;
                            background: #d9d6cc;
                            transform-rotation: -45deg;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        Rectangle {
            height: root.composer-height;
            background: transparent;

            if root.composer-command != "" : Text {
                x: 0;
                y: 1px;
                height: 20px;
                text: root.composer-command;
                color: #d8c06a;
                font-size: 13px;
                vertical-alignment: center;
                init => { root.command-word-width = self.preferred-width; }
                changed preferred-width => { root.command-word-width = self.preferred-width; }
            }

            draft-window := DraftEditor {
                use-canvas: root.canvas-mode;
                canvas: root.composer-canvas;
                canvas-height: root.composer-canvas-height;
                caret-x: root.composer-caret-x;
                caret-y: root.composer-caret-y;
                caret-height: root.composer-caret-height;
                x: root.composer-command == "" ? 0px : root.command-word-width + 6px;
                width: parent.width - self.x;
                height: root.composer-height;
                caret-request <=> root.composer-caret-request;
                text <=> root.composer-text;
                font-size: Type.body;
                edited(t) => {
                    root.composer-text = t;
                    root.composer-has-text = t != "";
                    // the caret travels with the text: the command token is
                    // whatever the caret is inside, wherever that is
                    root.slash-typed(t, self.caret-offset);
                }
                        key-pressed(event) => {
                                // The command menu answers first while it is open.
                                if root.slash-take(event) {
                                    return EventResult.accept;
                                }
                                // Backspace at the very start of the words takes
                                // the command word away with it: it is the only
                                // way to remove it, and it must work
                                if event.text == Key.Backspace
                                    && root.composer-command != ""
                                    && (root.composer-text == "" || self.caret-offset <= 0)
                                {
                                    root.composer-command-cleared();
                                    return EventResult.accept;
                                }
                                // Enter sends, Alt+Enter steers into the
                                // running turn, Shift+Enter is a newline,
                                // Esc aborts � the TUI's bindings
                                if event.text == Key.Return {
                                    // A command word in front of the caret is half of
                                    // the message: the box is empty when a command was
                                    // taken from the menu, and that is still something
                                    // to send, not a dead key.
                                    // Ctrl+Enter (or Alt+Enter, kept from before) folds
                                    // the message into the turn that is running instead
                                    // of parking it behind
                                    if event.modifiers.control || event.modifiers.alt {
                                        if root.composer-text != ""
                                            || root.composer-command != ""
                                            || root.attachment-images.length > 0
                                        {
                                            root.steer-requested(root.composer-text);
                                            root.composer-text = "";
                                        }
                                        return EventResult.accept;
                                    }
                                    if !event.modifiers.shift {
                                        if root.composer-text != ""
                                            || root.composer-command != ""
                                            || root.attachment-images.length > 0
                                        {
                                            root.send-requested(root.composer-text);
                                            root.composer-text = "";
                                        }
                                        return EventResult.accept;
                                    }
                                }
                                // Ctrl+Shift+V attaches an image from the clipboard;
                                // plain Ctrl+V stays text paste
                                // One key for both kinds of paste: Ctrl+V attaches the
                                // image when the clipboard holds one, and otherwise
                                // falls through to the text input's own paste. The text
                                // of a chorded key is not always the letter � with
                                // control it arrives as the control character, with
                                // shift as the capital � so all three are the same key.
                                if event.modifiers.control
                                    && (event.text == "v" || event.text == "V"
                                        || event.text == "\u{16}")
                                {
                                    if root.attach-pasted() {
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                                if event.text == Key.Escape {
                                    root.abort-requested();
                                    return EventResult.accept;
                                }
                                if event.text == Key.End && event.modifiers.control {
                                    root.scroll-to-end();
                                    return EventResult.accept;
                                }
                                // page keys scroll the transcript while the caret
                                // stays in the words being written
                                if event.text == Key.PageUp {
                                    root.page-scroll(-1);
                                    return EventResult.accept;
                                }
                                if event.text == Key.PageDown {
                                    root.page-scroll(1);
                                    return EventResult.accept;
                                }
                                if event.text == Key.Home && event.modifiers.control {
                                    root.scroll-to-top();
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                init => { self.grab-focus(); }

            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            // the context ring sits in the button row, not in the status strip:
            // the strip appears and disappears with every turn, and a number you
            // are reading should not travel
            Rectangle {
                width: 22px;
                height: 24px;

                ctx := Rectangle {
                    x: 1px;
                    y: 2px;
                    width: 20px;
                    height: 20px;

                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 10.00 4.00 L 10.00 1.30";
                        stroke: 0.0000 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 11.55 4.20 L 12.25 1.60";
                        stroke: 0.0417 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 13.00 4.80 L 14.35 2.47";
                        stroke: 0.0833 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 14.24 5.76 L 16.15 3.85";
                        stroke: 0.1250 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.20 7.00 L 17.53 5.65";
                        stroke: 0.1667 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.80 8.45 L 18.40 7.75";
                        stroke: 0.2083 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 16.00 10.00 L 18.70 10.00";
                        stroke: 0.2500 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.80 11.55 L 18.40 12.25";
                        stroke: 0.2917 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.20 13.00 L 17.53 14.35";
                        stroke: 0.3333 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 14.24 14.24 L 16.15 16.15";
                        stroke: 0.3750 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 13.00 15.20 L 14.35 17.53";
                        stroke: 0.4167 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 11.55 15.80 L 12.25 18.40";
                        stroke: 0.4583 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 10.00 16.00 L 10.00 18.70";
                        stroke: 0.5000 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 8.45 15.80 L 7.75 18.40";
                        stroke: 0.5417 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 7.00 15.20 L 5.65 17.53";
                        stroke: 0.5833 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 5.76 14.24 L 3.85 16.15";
                        stroke: 0.6250 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.80 13.00 L 2.47 14.35";
                        stroke: 0.6667 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.20 11.55 L 1.60 12.25";
                        stroke: 0.7083 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.00 10.00 L 1.30 10.00";
                        stroke: 0.7500 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.20 8.45 L 1.60 7.75";
                        stroke: 0.7917 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.80 7.00 L 2.47 5.65";
                        stroke: 0.8333 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 5.76 5.76 L 3.85 3.85";
                        stroke: 0.8750 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 7.00 4.80 L 5.65 2.47";
                        stroke: 0.9167 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 8.45 4.20 L 7.75 1.60";
                        stroke: 0.9583 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                }

                // the ring is 20px: the hover target is the whole cell
                ctx-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.pointer;
                    changed has-hover => { root.ctx-hover = self.has-hover; }
                }

                // the numbers behind the ring
                if root.ctx-hover : Rectangle {
                    x: -self.width + 20px;
                    y: -self.height - 14px;
                    width: 216px;
                    height: self.preferred-height;
                    background: #171814;
                    border-color: #2a2c24;
                    border-width: 1px;
                    border-radius: 8px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000066;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        ContextCard {
                            fill: root.context-fill;
                            used: root.context-text;
                            percent: root.ctx-percent;
                            messages: root.stat-messages;
                            tools: root.stat-tools;
                            input: root.stat-in;
                            output: root.stat-out;
                            cached: root.stat-cache;
                            cost: root.cost-session;
                            cost-family: root.cost-family;
                            cost-family-on: root.cost-family-on;
                        }
                    }
                }
            }

            // attach: a plus in a quiet resting surface, same family as the rest
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: attach-touch.has-hover ? #23251f : #1a1b16;
                animate background { duration: 120ms; }
                Rectangle {
                    x: (parent.width - 8px) / 2;
                    y: (parent.height - 1.5px) / 2;
                    width: 8px;
                    height: 1.5px;
                    border-radius: 0.75px;
                    background: attach-touch.has-hover ? #b0b1a8 : #8a8d82;
                }
                Rectangle {
                    x: (parent.width - 1.5px) / 2;
                    y: (parent.height - 8px) / 2;
                    width: 1.5px;
                    height: 8px;
                    border-radius: 0.75px;
                    background: attach-touch.has-hover ? #b0b1a8 : #8a8d82;
                }
                attach-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.attach-requested(); }
                }
            }
            Chip {
                label: root.model-label;
                open: root.model-menu;
                toggled => {
                    root.model-menu = !root.model-menu;
                    if root.model-menu {
                        root.model-menu-opened();
                    }
                }
            }
            // One control, two jobs: send while the session is idle, stop while it
            // works. A single TouchArea with the branch inside it - a button that
            // swaps element on a condition does not take clicks here.
            //
            // The two marks are always both present and cross over: the arrow
            // shrinks and turns as it goes, the stop square grows out of the
            // middle and turns the other way. Slint cannot interpolate one path
            // into another, so the fluidity is scale, rotation and opacity on the
            // same clock - which is what a morph looks like anyway.
            Rectangle {
                width: 25px;
                height: 25px;
                border-radius: 12.5px;
                background: root.stop-mode
                    ? (send-touch.has-hover ? #b8614c : #a2543f)
                    : (send-touch.has-hover ? #b39e4c : #a18e41);
                animate background { duration: 240ms; easing: ease-in-out; }

                IconSend {
                    width: 12px * (1.0 - 0.34 * root.stop-mix);
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    opacity: 1.0 - root.stop-mix;
                    transform-rotation: root.stop-mix * 45deg;
                }

                Rectangle {
                    width: 2px + 6px * root.stop-mix;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    // a dot rounding out into a square as it arrives
                    border-radius: 3px - 1.5px * root.stop-mix;
                    background: #f6efe6;
                    opacity: root.stop-mix;
                    transform-rotation: (1.0 - root.stop-mix) * -45deg;
                }

                send-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.model-menu = false;
                        if root.stop-mode {
                            // the daemon keeps the queue flowing behind the stopped
                            // run, so the next waiting message is not stranded
                            root.abort-requested();
                        } else {
                            root.send-requested(root.composer-text);
                            root.composer-text = "";
                        }
                    }
                }
            }
        }
    }
                    }
                }

            }

            // Blank by request: the column, its width and its fold, nothing else.
            if root.right-open : Rectangle {
                width: 320px;
                background: #10110e;
            }
        }
    }

    // title card: anchored to the row it describes and shown just to the right
    // of the sidebar, the way a tooltip is expected to behave
    if root.hover-title != "" : Rectangle {
        // 12px clear of the column, whichever width it has
        x: root.sidebar-open ? 244px : 60px;
        y: clamp(root.hover-y - 4px, 40px, root.height - self.height - 12px);
        width: min(self.preferred-width, 260px);
        height: self.preferred-height;
        background: #171814;
        border-color: #2a2c24;
        border-width: 1px;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            Text {
                text: root.hover-title;
                color: #e2e0d8;
                font-size: 11px;
                wrap: word-wrap;
                max-width: 240px;
            }
        }
    }


        // nothing keeps a hover alive forever: this is the safety net
    tooltip-timer := Timer {
        interval: 6000ms;
        running: root.tooltip-on;
        triggered => {
            root.hover-title = "";
            root.tooltip-on = false;
        }
    }

    // the menu is the last child of the window so nothing paints or hit-tests
    // above it: nested in the composer it sat behind the transcript's scroll
    // layer, which composites over later siblings

    // The command menu: opens the moment a slash starts the message, narrows as
    // more is typed, and sits directly above the box it belongs to. Capped and
    // scrollable, because it can hold every builtin at once.
    if root.slash-open && root.slash-items.length > 0 : Rectangle {
        x: composer-box.absolute-position.x + 12px;
        y: composer-box.absolute-position.y - self.height - 6px;
        width: min(460px, composer-box.width - 24px);
        // ten rows at a time; the list scrolls and the highlight pulls it along
        height: min(312px, 12px + root.slash-items.length * 30px);
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        slash-list := ScrollView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: self.visible-height;
            // the highlight must never walk off the top or bottom of the list:
            // arrowing down past the fold used to select a row nobody could see
            content-y: -clamp(
                root.slash-index * 30px - 60px,
                0px,
                max(0px, root.slash-items.length * 30px - self.height)
            );

            slash-rows := VerticalLayout {
                width: slash-list.visible-width;
                for item[index] in root.slash-items : Rectangle {
                    width: parent.width;
                    height: 28px;
                    border-radius: 6px;
                    // the row answers the pointer: a background under it and the
                    // one sentence that says what the command does. At rest the
                    // list is names only, like a menu should be.
                    background: index == root.slash-index || slash-touch.has-hover
                        ? #1f211a : transparent;
                    animate background { duration: 90ms; }

                    HorizontalLayout {
                        x: 10px;
                        y: 0;
                        width: parent.width - 20px;
                        height: 100%;
                        spacing: 8px;
                        Text {
                            text: "/" + item.name;
                            font-size: 13px;
                            color: index == root.slash-index || slash-touch.has-hover
                                ? #d8c06a : #b0b1a8;
                            vertical-alignment: center;
                        }
                        if (index == root.slash-index || slash-touch.has-hover) && item.hint != "" : Text {
                            text: item.hint;
                            font-size: 11px;
                            color: #8f917f;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.description;
                            font-size: 11px;
                            color: #6b6e63;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            opacity: index == root.slash-index || slash-touch.has-hover ? 1 : 0;
                            animate opacity { duration: 90ms; }
                        }
                    }

                    slash-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.slash-index = index;
                            root.slash-accept();
                        }
                    }
                }
            }
        }
    }

    // the model menu: real catalog, grouped by provider, each
    // group collapsible. Anchored above the composer box at the
    // right, where the model chip sits.
    if root.model-menu : Rectangle {
        x: composer-box.absolute-position.x + composer-box.width - self.width - 12px;
        y: composer-box.absolute-position.y - self.height - 6px;
        width: 300px;
        height: max(64px, min(340px, root.model-menu-height));
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        menu-scroll := ScrollView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: menu-list.preferred-height;

            // A group is one block: its header plus a row per
            // model. Collapsed groups carry no models at all,
            // so their height is just the header.
            // behind every row: a move here is a move off the rows
            menu-bg := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: parent.content-height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.pointer-moved();
                    }
                }
            }

            menu-list := VerticalLayout {
                for group in root.model-groups : Rectangle {
                    height: 26px + group.models.length * 24px;

                    group-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 26px;
                        mouse-cursor: pointer;
                        clicked => { root.provider-toggled(group.provider); }
                        // a header is not a model row: the ladder does not
                        // belong to it
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.pointer-moved();
                            }
                        }
                    }

                    IconCaret {
                        x: 6px;
                        y: (26px - self.height) / 2;
                        up: !group.open;
                    }
                    Text {
                        x: 22px;
                        y: 0;
                        width: parent.width - 80px;
                        height: 26px;
                        text: group.label;
                        color: group.configured ? #d9d8d1 : #6b6f62;
                        font-size: 11px;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    Text {
                        x: parent.width - 58px;
                        y: 0;
                        width: 52px;
                        height: 26px;
                        text: group.configured ? group.count : "not signed in";
                        color: #565a4f;
                        font-size: 9px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    for model[i] in group.models : Rectangle {
                        x: 0;
                        y: 26px + i * 24px;
                        width: 100%;
                        height: 24px;
                        border-radius: 5px;
                        background: model.current ? #23251f
                            : (model-touch.has-hover ? #1f211a : transparent);

                        model-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.model-picked(model.id, group.provider);
                                root.model-menu = false;
                            }
                            // the ladder drops off the row under the pointer;
                            // the row's window y is what it hangs from. Two
                            // sources, because the move callback alone missed
                            // pointer entries that never reported a move.
                            moved => {
                                if self.has-hover {
                                    root.model-hovered(group.provider, model.id,
                                        self.absolute-position.y);
                                }
                            }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move {
                                    root.model-hovered(group.provider, model.id,
                                        self.absolute-position.y);
                                }
                            }
                        }

                        Text {
                            x: 24px;
                            y: 0;
                            width: parent.width - 108px;
                            height: 100%;
                            text: model.label;
                            color: model.current ? #e7e5df : #b0b1a8;
                            font-size: 11px;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        // the running model names its level right of the name;
                        // every other row shows the context window instead
                        Text {
                            x: parent.width - 118px;
                            y: 0;
                            width: 74px;
                            height: 100%;
                            text: model.effort != "" ? model.effort : model.detail;
                            color: model.effort != "" ? #a18e41 : #565a4f;
                            font-size: 9px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        // the selected model is marked, not just tinted: two
                        // 2px strokes, heavier than the 1.5px marks elsewhere
                        if model.current : Path {
                            x: parent.width - 26px;
                            y: (parent.height - self.height) / 2;
                            width: 11px;
                            height: 11px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            stroke: #a18e41;
                            stroke-width: 1.5px;
                            commands: "M 1 6.4 L 4.4 9.8 L 11 2.2";
                        }
                    }
                }
            }
        }
    }

    // The effort ladder, hung to the left of the model menu: the menu sits on
    // the composer's right edge, so there is no room on its right for a second
    // column. It tracks the hovered row's y and stays inside the menu's band.
    if root.model-menu && root.effort-open : Rectangle {
        x: composer-box.absolute-position.x + composer-box.width - 300px - 12px
            - self.width - 6px;
        y: max(
            composer-box.absolute-position.y
                - max(64px, min(340px, root.model-menu-height)) - 6px,
            min(root.effort-y - 4px,
                composer-box.absolute-position.y - 6px - self.height)
        );
        width: 132px;
        height: 10px + root.effort-items.length * 26px;
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 8px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000060;

        // the ladder answers for its own surface, or moving onto it would
        // count as leaving the row it hangs from
        ladder-bg := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.effort-hovered();
                }
            }
        }

        for item[i] in root.effort-items : Rectangle {
            x: 0;
            y: 5px + i * 26px;
            width: 100%;
            height: 26px;
            border-radius: 5px;
            background: item-touch.has-hover ? #1f211a : transparent;

            item-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.effort-picked(i); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.effort-hovered();
                    }
                }
            }

            Text {
                x: 12px;
                y: 0;
                width: parent.width - 40px;
                height: 100%;
                text: item.label;
                color: item.current ? #e7e5df : #b0b1a8;
                font-size: 11px;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
            if item.current : Path {
                x: parent.width - 24px;
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                viewbox-width: 12;
                viewbox-height: 12;
                stroke: #a18e41;
                stroke-width: 1.4px;
                commands: "M 1 6.4 L 4.4 9.8 L 11 2.2";
            }
        }
    }

    // The queue panel hangs off the strip, at the window root like the model
    // menu: inside the band it sat at a negative y, where it painted outside
    // the area that answers clicks.
    if root.queue-open && root.queued-count > 0 : queue-panel := Rectangle {
        // measured off the composer box, not the band: the strip's height is
        // animated, and the panel has to ride it
        x: composer-box.absolute-position.x + composer-box.width - self.width;
        y: composer-box.absolute-position.y - root.busy-h - self.height - 6px;
        width: 320px;
        // the list is capped and scrolls: a long queue used to walk off the top
        // of the window, where the rows could not even be reached
        // not `q-scroll.height`: a ScrollView's height reads back as nothing at
        // the time the parent binds, which collapsed the panel to a sliver
        height: root.q-scroll-h + 12px;
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        q-scroll := ScrollView {
            x: 0;
            y: 6px;
            width: parent.width;
            height: root.q-scroll-h;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: root.q-content-h;

            Rectangle {
                width: 100%;
                height: root.q-content-h;
                // rows are placed by arithmetic, so the content root is the one
                // thing that can stop a long queue painting past the panel
                clip: true;

                if root.queued-steering.length > 0 : Text {
                    x: 10px;
                    y: 0;
                    height: 20px;
                    vertical-alignment: center;
                    text: root.queued-count == 1 ? "1 message waiting" : root.queued-count + " messages waiting";
                    color: #b0b1a8;
                    font-size: 9px;
                }
                for item[i] in root.queued-steering : QueueRow {
                    y: root.q-head-in + i * 34px;
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.text;
                    lane: "steering";
                    slot: item.slot;
                    thumb: item.thumb;
                    act(lane, slot, action) => {
                        root.queue-act(lane, slot, action);
                        if action != "edit" {
                            root.queue-open = false;
                        }
                    }
                }

                if root.queued-followup.length > 0 : Text {
                    x: 10px;
                    y: root.q-head-in + root.q-rows-in + root.q-lane-gap;
                    height: 20px;
                    vertical-alignment: center;
                    text: "runs next";
                    color: #6b6e63;
                    font-size: 9px;
                }
                for item[i] in root.queued-followup : QueueRowUp {
                    y: root.q-head-in + root.q-rows-in + root.q-lane-gap + root.q-head-next + i * 34px;
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.text;
                    lane: "followUp";
                    slot: item.slot;
                    thumb: item.thumb;
                    act(lane, slot, action) => {
                        root.queue-act(lane, slot, action);
                        if action != "edit" {
                            root.queue-open = false;
                        }
                    }
                }

                Rectangle {
                    x: 8px;
                    y: root.q-content-h - 24px;
                    width: parent.width - 16px;
                    height: 22px;
                    border-radius: 5px;
                    background: clear-touch.has-hover ? #1f211a : transparent;

                    Text {
                        x: 2px;
                        y: 0;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "clear all";
                        color: clear-touch.has-hover ? #d9d8d1 : #6b6e63;
                        font-size: 10px;
                    }

                    clear-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.queue-clear();
                            root.queue-open = false;
                        }
                    }
                }
            }
        }
    }

    // A failure reason is drawn at the window root: inside the row it was
    // covered by whatever row came next, so a command row painted over the
    // popup that belonged to the row above it.
    // The cap is on the width. `max-width` could not be: it is a constraint the
    // layout engine applies, and this popup is out of every layout, so
    // `width: self.preferred-width` won and the box grew to the message's own
    // width — past the window edge, where the message was then cut mid-word.
    // It sits on one line, because a reason is an exception message and its
    // interesting end is in the tail; whatever the cap cannot show travels
    // inside it (MarqueeText), so a long reason is read by watching instead of
    // being lost off the right edge.
    //
    // Hidden rather than created and destroyed: hover opens this and leaving
    // closes it, and a marquee that is created already past the end has nothing
    // to animate from. Out of sight it keeps its place — `active` falls, the
    // text walks home, and the next hover starts the sweep from the start.
    Rectangle {
        visible: root.reason-open;
        x: min(root.reason-x, root.width - self.width - 12px);
        y: root.reason-y + 4px;
        width: min(reason-text.preferred-width + 20px, 440px);
        height: reason-text.height + 16px;
        background: #1d1412;
        border-color: #6b342b;
        border-width: 1px;
        border-radius: 6px;

        reason-text := MarqueeText {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            text: root.reason-text;
            text-color: #e0b6ad;
            font-size: 10px;
            active: root.reason-open;
            loop: true;
        }
    }







    // drawn last so it sits above the content and the drag surface beneath it
    title-bar := TitleBar {
        y: 0;
        width: 100%;
        caption: root.title;
        right-open: root.right-open;
        toggle-right => { root.right-open = !root.right-open; }
        maximized: root.titlebar-maximized;
        max-hover: root.titlebar-max-hover;
        minimize => { root.titlebar-minimize(); }
        close => { root.titlebar-close(); }
        menu => { root.titlebar-menu(); }
    }
}
