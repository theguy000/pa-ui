                                    commands: "M 16.00 10.00 L 18.70 10.00";
                                    stroke: 0.2500 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 15.80 11.55 L 18.40 12.25";
                                    stroke: 0.2917 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 15.20 13.00 L 17.53 14.35";
                                    stroke: 0.3333 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 14.24 14.24 L 16.15 16.15";
                                    stroke: 0.3750 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 13.00 15.20 L 14.35 17.53";
                                    stroke: 0.4167 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 11.55 15.80 L 12.25 18.40";
                                    stroke: 0.4583 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 10.00 16.00 L 10.00 18.70";
                                    stroke: 0.5000 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 8.45 15.80 L 7.75 18.40";
                                    stroke: 0.5417 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 7.00 15.20 L 5.65 17.53";
                                    stroke: 0.5833 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 5.76 14.24 L 3.85 16.15";
                                    stroke: 0.6250 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 4.80 13.00 L 2.47 14.35";
                                    stroke: 0.6667 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 4.20 11.55 L 1.60 12.25";
                                    stroke: 0.7083 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 4.00 10.00 L 1.30 10.00";
                                    stroke: 0.7500 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 4.20 8.45 L 1.60 7.75";
                                    stroke: 0.7917 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 4.80 7.00 L 2.47 5.65";
                                    stroke: 0.8333 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 5.76 5.76 L 3.85 3.85";
                                    stroke: 0.8750 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 7.00 4.80 L 5.65 2.47";
                                    stroke: 0.9167 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 8.45 4.20 L 7.75 1.60";
                                    stroke: 0.9583 <= root.context-fill ? #c9a86a : #2c2e26;
                                    stroke-width: 1.5px;
                                }
                        }
                        // the whole status row is the hover target: a 20px ring is
                        // too small a hit area to aim at
                        ctx-touch := TouchArea {
                            x: parent.width - 46px;
                            y: 0;
                            width: 46px;
                            height: 100%;
                            changed has-hover => { root.ctx-hover = self.has-hover; }
                        }

                        // the numbers behind the ring
                        if root.ctx-hover : Rectangle {
                            x: parent.width - self.width - 22px;
                            y: -self.height - 8px;
                            width: self.preferred-width;
                            min-width: 170px;
                            height: self.preferred-height;
                            background: #171814;
                            border-color: #2a2c24;
                            border-width: 1px;
                            border-radius: 8px;
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 9px;
                                padding-bottom: 9px;
                                spacing: 4px;
                                Text { text: "context"; color: #565a4f; font-size: 10px; }
                                Text { text: root.context-text; color: #e0dcc8; font-size: 12px; }
                                Text {
                                    text: root.stats-text;
                                    color: #8b8c85;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                composer-band := Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: root.dragging ? root.band-freeze : root.composer-total;
                    background: transparent;

                    // drag surface first so the box and its buttons stay on top.
                    // Its top-left is pinned to the band, so pointer travel is
                    // measured from a fixed origin while the box grows upward.
                    drag-zone := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.dragging = true;
                                root.band-freeze = root.composer-total;
                                root.last-pointer-y = drag-zone.mouse-y;
                            }
                            if event.kind == PointerEventKind.up
                                || event.kind == PointerEventKind.cancel
                            {
                                root.dragging = false;
                            }
                            if event.kind == PointerEventKind.move && root.dragging {
                                // incremental deltas: a stale start value (pressed-y
                                // is only set after the press callback runs) made the
                                // first delta enormous and snapped the box to its
                                // limit on the slightest nudge
                                let step = root.last-pointer-y - drag-zone.mouse-y;
                                root.last-pointer-y = drag-zone.mouse-y;
                                if step > -40px && step < 40px {
                                    root.composer-height = clamp(
                                        root.composer-height + step,
                                        root.composer-min,
                                        root.composer-max
                                    );
                                }
                            }
                        }
                    }

                    // handle, drawn on the box's top border
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: composer-box.y - 1.5px;
                        width: 36px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: root.dragging ? #6b7059
                            : (drag-zone.has-hover ? #4a4d42 : #33362d);
                    }

                    // strip above the box: queued messages left, jump control right
                    Rectangle {
                        x: 18px;
                        y: composer-box.y - 30px;
                        width: parent.width - 36px;
                        height: 24px;
                        background: transparent;

                        if root.queued-count > 0 : HorizontalLayout {
                            x: 4px;
                            y: 0;
                            width: parent.width - 44px;
                            height: parent.height;
                            spacing: 6px;
                            Text {
                                text: "\u{21b3}";
                                color: #6f7364;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.queued-count + " queued";
                                color: #8b8c85;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.queued-preview;
                                color: #565a4f;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }


                    }

composer-box := Rectangle {
                    x: 18px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 36px;
                    height: root.box-height;
    background: #0f100d;
    border-color: #23251f;
    border-width: 1px;
    border-radius: 12px;

    // the handle drawn on the box's top border
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: -self.height / 2;
        width: 36px;
        height: 3px;
        border-radius: 1.5px;
        background: root.dragging ? #6b7059
            : (drag-zone.has-hover ? #4a4d42 : #33362d);
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 10px;
        // a fixed-height window over a text input that is allowed to grow:
        // pinning its bottom edge keeps the caret (newest line) in view, which
        // a fixed-height TextInput does not do on its own
        draft-window := DraftEditor {
            height: root.composer-height;
            text <=> root.composer-text;
            font-size: 13px;
            edited(t) => { root.composer-text = t; }
                    key-pressed(event) => {
                            // Enter sends, Alt+Enter steers into the
                            // running turn, Shift+Enter is a newline,
                            // Esc aborts — the TUI's bindings
                            if event.text == Key.Return {
                                if event.modifiers.alt {
                                    if root.composer-text != "" {
                                        root.steer-requested(root.composer-text);
                                        root.composer-text = "";
                                    }
                                    return EventResult.accept;
                                }
                                if !event.modifiers.shift {
                                    if root.composer-text != "" {
                                        root.send-requested(root.composer-text);
                                        root.composer-text = "";
                                    }
                                    return EventResult.accept;
                                }
                            }
                            if event.text == Key.Escape {
                                root.abort-requested();
                                return EventResult.accept;
                            }
                            if event.text == Key.End && event.modifiers.control {
                                root.scroll-to-end();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
            init => { self.grab-focus(); }
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Chip {
                label: root.model-label;
                open: root.model-menu;
                toggled => { root.model-menu = !root.model-menu; }
            }
            Rectangle {
                width: 25px;
                height: 25px;
                border-radius: 12.5px;
                background: send-touch.has-hover ? #b39e4c : #a18e41;
                IconSend {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                send-touch := TouchArea {
                    clicked => {
                        root.send-requested(root.composer-text);
                        root.composer-text = "";
                    }
                }
            }
        }
    }
}
                }
            }

            Rectangle {
                width: 260px;
                background: #10110e;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Rectangle {
                        height: 16px;
                        Text {
                            text: "session";
                            color: #565a4f;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    // the ring lives in the status row; the panel keeps the numbers
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "context";
                            color: #8b8c85;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: root.context-text;
                            color: #565a4f;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.stats-text;
                        color: #565a4f;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 1px; background: #1c1e19; }

                    Text {
                        text: "review";
                        color: #565a4f;
                        font-size: 10px;
                    }
                    Text {
                        text: "nothing to review yet";
                        color: #34372e;
                        font-size: 11px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
    }
}
