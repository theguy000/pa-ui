component StatusDot inherits Rectangle {
    in property <string> status;
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background: status == "working" ? #a18e41 : status == "parked" ? #4a4d44 : #6f9f5f;
}

component SessionRow inherits Rectangle {
    in property <SessionItem> item;
    in property <bool> selected;
    in property <bool> editing;
    in-out property <string> draft;
    callback picked(string);
    // the row's own window position rides along, so the card can sit beside it
    callback hovered(string, length);
    callback edit(string);
    callback commit(string, string);
    // the row's own pointer state, so the component can watch it change: a
    // `changed` block only takes an identifier, and `ta.has-hover` is not one
    out property <bool> hot: ta.has-hover;

    height: 32px;
    border-radius: 6px;
    background: selected ? #1d1e19 : (ta.has-hover ? #171814 : transparent);

    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 30px;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(root.item.id); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered(root.item.tip, self.absolute-position.y);
            }
        }
    }

    // Leaving the row is the half `move` cannot report: walking up into the
    // blank band above the list produces no further move inside the row, so the
    // card used to sit there until the timer gave up. The `changed` block lives
    // on the row rather than inside the TouchArea - inside it, a has-hover
    // change eats the click that follows.
    changed hot => {
        if !hot {
            root.hovered("", 0px);
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            clip: true;

            if !root.editing : Text {
                text: root.item.name;
                color: root.selected ? #e7e5df : #b0b1a8;
                font-size: 12px;
                height: parent.height;
                vertical-alignment: center;
                x: ta.has-hover && root.item.scroll > 0px ? -root.item.scroll : 0px;
                animate x { duration: 1.8s; easing: ease-in-out; }
            }

            if root.editing : input := TextInput {
                text: root.draft;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                color: #e7e5df;
                font-size: 12px;
                single-line: true;
                edited => { root.draft = self.text; }
                accepted => { root.commit(root.item.id, root.draft); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.commit(root.item.id, root.item.full);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                init => { self.focus(); }
            }
        }

        Rectangle {
            width: 18px;
            height: 32px;
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: edit-touch.has-hover ? #2a2c24 : #1d1e19;
                visible: !root.editing;
                opacity: ta.has-hover || edit-touch.has-hover ? 1 : 0;
                animate opacity { duration: 100ms; }
                IconPencil {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                edit-touch := TouchArea {
                    enabled: !root.editing;
                    clicked => { root.edit(root.item.id); }
                }
            }
        }

        Rectangle {
            width: age-text.preferred-width;
            height: 32px;
            age-text := Text {
                text: root.item.age;
                color: #565a4f;
                font-size: 10px;
                height: parent.height;
                vertical-alignment: center;
                opacity: root.editing ? 0 : 1;
            }
        }

        Rectangle {
            width: 5px;
            height: 32px;
            StatusDot {
                y: (parent.height - self.height) / 2;
                status: root.item.status;
                opacity: root.editing ? 0 : 1;
            }
        }
    }
}

component TranscriptRow inherits VerticalLayout {
    spacing: 0px;
    property <bool> err-hover: false;

    in property <TRow> data;
    callback toggle();
    // where the failure reason should be drawn: at the window's root, not in
    // this row, or the row beneath paints over it
    callback reason-hover(string, length, length);
    callback reason-leave();

    if data.kind == 0 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            background: #2e2916;
            border-radius: 10px;
            width: min(self.preferred-width, 560px);
            height: self.preferred-height;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                StyledText {
                    text: data.body;
                    default-color: #e7e5df;
                    default-font-size: 13px;
                    link-color: #a18e41;
                }
            }
        }
    }

    if data.kind == 1 : Rectangle {
        height: agent-text.preferred-height + 12px;
        agent-text := StyledText {
            x: 24px;
            y: 6px;
            width: parent.width - 48px;
            text: data.body;
            default-color: #d2d1ca;
            default-font-size: 13px;
            link-color: #a18e41;
        }
    }

    if data.kind == 2 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            width: self.preferred-width;
            height: 24px;
            border-radius: 6px;
            background: think-touch.has-hover ? #1a1b17 : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text { text: "thinking"; color: #6b6c65; font-size: 10px; vertical-alignment: center; }
                Text { text: data.meta; color: #4a4d44; font-size: 10px; vertical-alignment: center; }

                Rectangle {
                    width: 10px;
                    height: 24px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }
            }
            think-touch := TouchArea { clicked => { root.toggle(); } }
        }

        if data.expanded : Rectangle {
            background: #0f100d;
            border-color: #1e201a;
            border-width: 1px;
            border-radius: 8px;
            height: min(think-text.preferred-height + 24px, 6 * think-probe.preferred-height + 24px);
            think-probe := Text {
                x: -200px;
                y: 0px;
                text: "x";
                font-family: "Cascadia Code";
                font-size: 11px;
                opacity: 0;
            }
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    think-text := StyledText {
                        text: data.body;
                        default-color: #7e8076;
                        default-font-family: "Cascadia Code";
                        default-font-size: 11px;
                    }
                }
            }
        }
    }

    if data.kind == 3 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            height: 26px;
            border-radius: 6px;
            background: data.failed
                ? (cell-hot ? #241713 : #1d1412)
                : (cell-hot ? #181a14 : #14160f);

            property <bool> cell-hot: cell-touch.has-hover || root.err-hover;

            cell-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                clicked => { root.toggle(); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;

                Rectangle {
                    width: 10px;
                    height: 26px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }

                Text {
                    text: data.title;
                    color: data.failed ? #c98a7f : #8b8c85;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text { text: data.meta; color: #4a4d44; font-size: 10px; vertical-alignment: center; }
                // the separator is full white so the run reads as two parts
                // instead of a sentence ending in a full stop
                Text {
                    text: "\u{00b7}";
                    color: #ffffff;
                    font-size: 10px;
                    vertical-alignment: center;
                    visible: data.elapsed != "";
                }
                Text {
                    text: data.elapsed;
                    color: #4a4d44;
                    font-size: 10px;
                    vertical-alignment: center;
                    visible: data.elapsed != "";
                }

                if data.failed : Rectangle {
                    width: 14px;
                    height: 26px;
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: err-touch.has-hover ? #8d4235 : #6b342b;
                        IconAlert { x: 0; y: 0; }
                        err-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            changed has-hover => {
                                root.err-hover = self.has-hover;
                                if self.has-hover {
                                    root.reason-hover(
                                        data.reason,
                                        self.absolute-position.x,
                                        self.absolute-position.y + self.height,
                                    );
                                } else {
                                    root.reason-leave();
                                }
                            }
                        }
                    }
                }
            }


        }

        if data.expanded : Rectangle {
            background: #0f100d;
            border-color: #23251f;
            border-width: 1px;
            border-radius: 8px;
            height: self.preferred-height;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                StyledText {
                    text: data.code;
                    default-color: #cfd3c8;
                    default-font-family: "Cascadia Code";
                    default-font-size: 12px;
                }
                if data.has-output : Rectangle {
                    height: 1px;
                    background: #1e201a;
                }
                if data.has-output : StyledText {
                    text: data.output;
                    default-color: data.failed ? #c98a7f : #8f9187;
                    default-font-family: "Cascadia Code";
                    default-font-size: 11px;
                }
            }
        }
    }

    if data.kind == 5 : HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: data.title;
            color: #4a4d44;
            font-size: 10px;
        }
    }

    // A fenced block: its own surface, mono, the language named in the corner
    // the way a code card names it. The colours are the TUI's mdCodeBlock (a
    // sage) and its syntax palette, warmed to sit in this theme.
    if data.kind == 6 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 5px;
        padding-bottom: 5px;
        Rectangle {
            height: code-text.preferred-height + 24px + (data.meta == "" ? 0px : 15px);
            background: #0d0e0b;
            border-radius: 8px;

            Text {
                x: 12px;
                y: 9px;
                text: data.meta;
                color: #565a4f;
                font-size: 9px;
                visible: data.meta != "";
            }
            code-text := StyledText {
                x: 12px;
                y: 12px + (data.meta == "" ? 0px : 15px);
                width: parent.width - 24px;
                text: data.code;
                default-color: #b3bb9e;
                default-font-size: 11.5px;
                default-font-family: "Cascadia Code";
            }
        }
    }

    // A table, box-drawn as text: it stays copyable and needs no cell model.
    if data.kind == 7 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 5px;
        padding-bottom: 5px;
        table-text := StyledText {
            text: data.body;
            default-color: #a9ab9d;
            default-font-size: 11px;
            default-font-family: "Cascadia Code";
        }
    }
    // an image the user sent: the picture itself, thumbnailed, on the same edge
    // as the bubble so the sent turn reads as one thing
    if data.kind == 8 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        Rectangle {
            width: 220px;
            height: 150px;
            background: #1a1c16;
            border-radius: 10px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: data.image;
                image-fit: contain;
            }
        }
    }
}


// One line of the context ledger: the label, then the value flush right in a
// fixed slot so the whole column of numbers has one edge to line up on.
component Ledger inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> ink: #b0b1a8;
    height: 16px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: #6b6e63;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.value;
            color: root.ink;
            font-size: 10.5px;
            width: 58px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// The context card, shared by the ring's hover popup and the right column: the
// window first (how close the session is to forgetting), then the counts, then
// the money - one question at two scales.
component ContextCard inherits Rectangle {
    in property <float> fill: 0.0;
    in property <string> used: "";
    in property <string> percent: "";
    in property <string> messages: "";
    in property <string> tools: "";
    in property <string> input: "";
    in property <string> output: "";
    in property <string> cached: "";
    in property <string> cost: "";
    in property <string> cost-family: "";
    in property <bool> cost-family-on: false;
    background: transparent;
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            Text {
                text: "context";
                color: #6b6e63;
                font-size: 10px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.percent;
                color: #e7e5df;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        // the bar answers "how close am I" before a single number is read
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: #23251f;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * root.fill;
                border-radius: 1.5px;
                background: #a18e41;
            }
        }
        Text {
            text: root.used;
            color: #8b8c85;
            font-size: 10px;
        }
        Rectangle { height: 1px; background: #1c1e19; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 1px;
            Ledger { label: "messages"; value: root.messages; }
            Ledger { label: "tools"; value: root.tools; }
            Ledger { label: "in"; value: root.input; }
            Ledger { label: "out"; value: root.output; }
            Ledger { label: "cached"; value: root.cached; }
        }
        Rectangle { height: 1px; background: #1c1e19; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 1px;
            Ledger { label: "cost"; value: root.cost; ink: #d9d7cd; }
            if root.cost-family-on : Ledger {
                label: "with subagents";
                value: root.cost-family;
                ink: #d9d7cd;
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback toggled;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    // The resting state is what the old hover state was: a chip that only
    // appears under the pointer reads as decoration, not as a control.
    background: ct.has-hover || open ? #23251f : #1a1b16;
    border-color: ct.has-hover || open ? #33362d : #23251f;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.label;
            color: ct.has-hover || open ? #e7e5df : #b0b1a8;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 10px;
            height: 24px;
            IconCaret {
                y: (parent.height - self.height) / 2;
                up: root.open;
            }
        }
    }
    ct := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}









export component AppWindow inherits Window {
    // the failure reason of a cell, drawn here so no row can paint over it
    in-out property <bool> reason-open;
    in-out property <length> reason-x;
    in-out property <length> reason-y;
    in-out property <string> reason-text;
    title: "prime-agent";

    // The drag surface is the whole window, so the pointer can never leave it
    // mid-drag, and it measures the pointer in window coordinates: anchored to
    // the composer box it moved as the box grew, which is what made the drag
    // stutter and lose the pointer.
    drag-surface := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: root.handle-hover || root.dragging ? MouseCursor.row-resize
            : MouseCursor.default;
        // a click that lands on nothing in particular dismisses the model menu
        clicked => { root.model-menu = false; root.queue-open = false; root.search-open = false; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-moved();
            }
            if event.kind == PointerEventKind.down {
                // only the handle starts a drag; the rest of the band belongs
                // to the chip and the model menu
                if root.handle-hover {
                    root.dragging = true;
                    root.band-freeze = root.composer-total;
                    root.last-pointer-y = drag-surface.mouse-y;
                }
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
            if event.kind == PointerEventKind.move && root.dragging {
                let step = root.last-pointer-y - drag-surface.mouse-y;
                root.last-pointer-y = drag-surface.mouse-y;
                if step > -60px && step < 60px {
                    root.composer-height = clamp(
                        root.composer-height + step,
                        root.composer-min,
                        root.composer-max
                    );
                }
            }
        }
    }

    // no fixed width/height: a fixed size leaves the new area blank when the
    // user resizes the window, because the root keeps its declared size
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 820px;
    background: #12130f;
    default-font-family: "Segoe UI";

    in property <[SessionItem]> sessions;
    in property <[TRow]> transcript;
    in property <[ModelGroup]> model-groups;
    // how tall the menu needs to be for the groups that are open
    in-out property <length> model-menu-height: 0px;
    in-out property <string> model-provider: "";
    in property <length> menu-width: 180px;
    in-out property <string> model-id;
    // the running model's thinking level: the wire word (`max`) and the name
    // the menu shows (`Max`)
    in-out property <string> current-effort;
    in-out property <string> current-level;
    out property <length> box-x: composer-box.absolute-position.x;
    out property <length> box-y: composer-box.absolute-position.y;
    out property <length> box-w: composer-box.width;
    // the effort submenu: open while a hovered row has a ladder to choose from
    in-out property <bool> effort-open: false;
    in-out property <length> effort-y: 0px;
    in-out property <[EffortItem]> effort-items;
    in-out property <string> model-label: "model";
    in-out property <string> title-text: "";
    in-out property <string> draft: "";
    in-out property <string> composer-text: "";
    // The command menu: every builtin the daemon knows, narrowed by what is
    // typed after the slash. It answers keys before the composer does, so Enter
    // picks the highlighted command instead of sending half a word.
    in-out property <[SlashItem]> slash-items;
    in-out property <bool> slash-open: false;
    in-out property <int> slash-index: 0;
    // the menu takes the keys it wants before the message box sees them
    public function slash-take(event: KeyEvent) -> bool {
        if !root.slash-open || root.slash-items.length == 0 {
            return false;
        }
        if event.text == Key.DownArrow {
            root.slash-move(1);
            return true;
        }
        if event.text == Key.UpArrow {
            root.slash-move(-1);
            return true;
        }
        if event.text == Key.Escape {
            root.slash-dismiss();
            return true;
        }
        if event.text == Key.Return || event.text == Key.Tab {
            root.slash-accept();
            return true;
        }
        false
    }
    in-out property <int> queued-count: 0;
    // the two lanes, kept apart: one runs inside this turn, one after it
    in property <[QueueItem]> queued-steering;
    in property <[QueueItem]> queued-followup;
    in-out property <bool> queue-open: false;
    // the queue panel's geometry, in one place: its rows are stacked by
    // arithmetic, and every y below is a sum of these
    out property <length> q-head-in: root.queued-steering.length > 0 ? 20px : 0px;
    out property <length> q-rows-in: root.queued-steering.length * 34px;
    out property <length> q-head-next: root.queued-followup.length > 0 ? 20px : 0px;
    out property <length> q-rows-next: root.queued-followup.length * 34px;
    out property <length> q-lane-gap: root.queued-steering.length > 0
        && root.queued-followup.length > 0 ? 8px : 0px;
    out property <length> q-content-h: root.q-head-in + root.q-rows-in + root.q-lane-gap
        + root.q-head-next + root.q-rows-next + 24px;
    out property <length> q-scroll-h: min(root.q-content-h, 288px);
    in-out property <string> queued-preview: "";
    in-out property <float> context-fill: 0.0;
    // composer input height; the pill on its top border toggles it
    in-out property <length> composer-height: 68px;
    in-out property <[image]> attachment-images: [];
    // 44px tiles plus the layout's 10px spacing plus a hairline of slack
    out property <length> attach-h: root.attachment-images.length > 0 ? 62px : 0px;
    animate attach-h { duration: 170ms; easing: ease-out; }
    // input + box chrome (10+8 padding, 10 spacing, 24 button row, 2 borders)
    // + strip (24) + band padding (8+10)
    // 13px text is ~17px per line: 4 lines by default, 10 at most
    out property <length> composer-min: 68px;
    out property <length> composer-max: 170px;
    // the band is exactly the box plus the 12px pad under it; the queue line
    // and the jump control live elsewhere, so nothing else needs reserving
    // queued chip sits above the box, so the transcript has to stop short of it
    // the popup is drawn at the window root (a child at negative y paints but
    // cannot be hit), so it anchors off the composer box, which never moves
    // The band reserves 34px above the box for the chip, and - while a turn is
    // running - the busy row plus another 34px above it, so the gap that keeps
    // the transcript off the input sits above the status line instead of below.
    // The status strip grows open and shuts fast. Everything that has to move
    // with it reads this one length: the strip's height, the box's height, the
    // padding above the input, and the band the transcript stops at.
    // the strip is the home of the queue as well, so it opens while anything is
    // waiting even if the turn that queued it has just ended
    in-out property <length> busy-h: root.busy || root.queued-count > 0 ? 26px : 0px;
    animate busy-h {
        duration: root.busy ? 190ms : 110ms;
        easing: root.busy ? ease-out : ease-in;
    }
    // the contents come in a beat after the gap opens, and go before it shuts
    in-out property <float> busy-fade: root.busy || root.queued-count > 0 ? 1.0 : 0.0;
    animate busy-fade {
        duration: root.busy ? 150ms : 90ms;
        delay: root.busy ? 60ms : 0ms;
        easing: ease-out;
    }
    out property <length> composer-total: root.box-height + 46px + root.busy-h;
    // box chrome around the input: 10+8 padding, 10 spacing, 24 button row, 2 borders
    out property <length> box-height: root.composer-height + 54px + root.attach-h;
    in-out property <bool> dragging: false;
    // where the handle actually sits, in window coordinates: the drag surface
    // is the whole window, so the press has to be tested against it
    out property <length> handle-cy: composer-band.absolute-position.y + 34px + root.busy-h;
    out property <length> handle-cx: composer-band.absolute-position.x + composer-band.width / 2;
    out property <bool> handle-hover: drag-surface.has-hover
        && abs(drag-surface.mouse-x - root.handle-cx) <= 48px
        && abs(drag-surface.mouse-y - root.handle-cy) <= 9px;
    // the band's height at press time: frozen for the gesture so the drag
    // origin (and the clamp on mouse-y) cannot move under the pointer
    in-out property <length> band-freeze: 0px;
    in-out property <length> last-pointer-y: 0px;
    in-out property <length> drag-start-y: 0px;
    in-out property <length> drag-start-h: 0px;
    in-out property <string> context-text: "";
    in-out property <string> ctx-percent: "";
    in-out property <string> stat-messages: "";
    in-out property <string> stat-tools: "";
    in-out property <string> stat-in: "";
    in-out property <string> stat-out: "";
    in-out property <string> stat-cache: "";
    in-out property <string> cost-session: "";
    in-out property <string> cost-family: "";
    in-out property <bool> cost-family-on: false;
    in-out property <bool> ctx-hover: false;
    in-out property <string> editing-id: "";
    in property <string> status-line: "connecting";
    in-out property <string> hover-title: "";
    in-out property <length> hover-y: 0px;
    in-out property <bool> tooltip-on: false;
    in-out property <bool> rail-open: true;
    in-out property <bool> model-menu: false;
    in-out property <string> selected-id;

    in property <bool> activity-busy: false;
    in property <string> activity: "idle";
    in property <string> activity-elapsed: "";

    in property <bool> busy: false;
    in property <string> busy-label: "";
    in property <string> busy-elapsed: "";
    in property <string> spinner-frame: "\u{280b}";
    in property <float> shimmer: 0.0;

    callback send-requested(string);
    // the command menu: what is typed after the slash, moving the highlight, and
    // taking the highlighted command
    callback slash-typed(string);
    callback slash-move(int);
    callback slash-accept();
    callback slash-dismiss();
    callback steer-requested(string);
    callback abort-requested();
    // images ride beside the text: the strip is the attachment list, and the
    // prompt carries whatever is in it when the message is sent
    callback attach-requested();
    callback attach-pasted() -> bool;
    callback attachment-removed(int);
    callback model-picked(string, string);
    // a row's effort ladder: which model, and the row's window y to hang from
    callback model-hovered(string, string, length);
    // the pointer is somewhere that is neither a model row nor its ladder:
    // the popup has no reason to stay
    callback pointer-moved();
    // the pointer is on the ladder itself, which keeps it alive
    callback effort-hovered();
    callback effort-picked(int);
    callback model-menu-opened;
    callback provider-toggled(string);
    callback rename-requested(string, string);
    callback toggle-row(int);
    callback queue-act(string, int, string);
    callback queue-clear();
    callback new-chat();
    // the rail's filter: "" means every session is shown
    in-out property <string> search-query: "";
    // 0 while idle, 1 while a run is in flight: the one clock the send button's
    // two marks share
    // Stop is only the button's job while the composer is empty. The moment you
    // type, the same control becomes send again — and sending while a turn runs
    // queues the message instead of interrupting it.
    in-out property <bool> composer-has-text: false;
    out property <bool> stop-mode: root.busy && !root.composer-has-text;
    in-out property <float> stop-mix: root.stop-mode ? 1.0 : 0.0;
    animate stop-mix { duration: 240ms; easing: ease-in-out; }
    in-out property <bool> search-open: false;
    // the composer taking the caret is "somewhere else" too
    out property <bool> composer-focused: draft-window.has-focus;
    callback search-edited(string);

    // true while the reader is parked at the newest row; a new row then pulls
    // the view along, and scrolling up turns it off
    in-out property <bool> follow-bottom: true;
    // derived from the scroll offset, so it tracks wheel scrolling without
    // relying on change notifications from the ListView
    out property <length> dbg-cy: transcript-list.content-y;
    out property <length> dbg-ch: transcript-list.content-height;
    out property <length> dbg-h: transcript-list.height;
    out property <bool> at-bottom: transcript-list.content-y <= -root.scroll-range + 80px;

    // how far the transcript can travel; content-y is the *offset* of the
    // content, negative once you scroll down, so this is what it bottoms out at
    out property <length> scroll-range: max(
        0px,
        transcript-list.content-height - transcript-list.height
    );

    public function scroll-to-end() {
        root.follow-bottom = true;
        transcript-list.content-y = -root.scroll-range;
    }

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: #10110e;

            Rectangle {
                x: 8px;
                y: 9px;
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: rail-touch.has-hover ? #1d1e19 : transparent;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        IconRail { open: root.rail-open; }
                    }
                }
                rail-touch := TouchArea { clicked => { root.rail-open = !root.rail-open; } }
            }

            Text {
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
                text: root.status-line;
                color: #565a4f;
                font-size: 10px;
            }
        }

        HorizontalLayout {
            if root.rail-open : Rectangle {
                width: 232px;
                background: #10110e;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    spacing: 6px;
                    // The header carries the two things a list of chats needs:
                    // find one, and start one. Both are drawn marks on a fill,
                    // no borders.
                    //
                    // Search opens a field here and closes when the pointer goes
                    // elsewhere - but that only hides it: the filter stays until
                    // the x inside the field is pressed, so a collapsed search
                    // still explains why the list is short.
                    Rectangle {
                        height: 22px;



                        if !root.search-open : Text {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            text: "sessions";
                            color: #565a4f;
                            font-size: 10px;
                        }

                        // the find button
                        if !root.search-open : Rectangle {
                            x: parent.width - 44px;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            border-radius: 5px;
                            // a live filter keeps the button lit: the list is
                            // short for a reason, and this is the reason
                            background: search-touch.has-hover || root.search-query != ""
                                ? #23251f : #1a1b16;

                            Rectangle {
                                x: 5px;
                                y: 5px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                border-width: 1.3px;
                                border-color: search-touch.has-hover || root.search-query != ""
                                    ? #e7e5df : #b0b1a8;
                            }
                            Path {
                                width: 6px;
                                height: 6px;
                                x: 11px;
                                y: 11px;
                                viewbox-width: 6;
                                viewbox-height: 6;
                                commands: "M 0.7 0.7 L 5 5";
                                stroke: search-touch.has-hover || root.search-query != ""
                                    ? #e7e5df : #b0b1a8;
                                stroke-width: 1.3px;
                                fill: transparent;
                            }
                            search-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.search-open = true; }
                            }
                        }

                        // the field, in the header's own row
                        if root.search-open : Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 22px;
                        border-radius: 6px;
                        background: #1a1b16;

                        Rectangle {
                            x: 6px;
                            y: 7px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            border-width: 1.2px;
                            border-color: #8b8c85;
                        }
                        Path {
                            x: 12px;
                            y: 13px;
                            width: 5px;
                            height: 5px;
                            viewbox-width: 5;
                            viewbox-height: 5;
                            commands: "M 0.6 0.6 L 4.2 4.2";
                            stroke: #8b8c85;
                            stroke-width: 1.2px;
                            fill: transparent;
                        }

                        if root.search-query == "" : Text {
                            x: 24px;
                            y: 0;
                            height: parent.height;
                            vertical-alignment: center;
                            text: "search sessions";
                            color: #565a4f;
                            font-size: 10px;
                        }

                        search-field := TextInput {
                            x: 24px;
                            y: 0;
                            width: parent.width - 46px;
                            height: parent.height;
                            text <=> root.search-query;
                            color: #e7e5df;
                            font-size: 11px;
                            vertical-alignment: center;
                            single-line: true;
                            // it takes the focus it is created with, so
                            // opening the search is enough to type
                            init => { self.focus(); }
                            edited => { root.search-edited(root.search-query); }
                            key-pressed(event) => {
                                // escape and return both put the field away;
                                // neither touches what was typed
                                if event.text == "\u{1b}" || event.text == "\n" {
                                    root.search-open = false;
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        // the only reset
                        Rectangle {
                            x: parent.width - 20px;
                            y: 3px;
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            background: clear-search.has-hover ? #2a2d24 : transparent;

                            IconX {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 9px;
                                height: 9px;
                                tint: clear-search.has-hover ? #f3ded8 : #8b8c85;
                            }
                            clear-search := TouchArea {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.search-query = "";
                                    root.search-edited("");
                                    root.search-open = false;
                                }
                            }
                        }
}

                        // the new chat button
                        if !root.search-open : Rectangle {
                            x: parent.width - 20px;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            border-radius: 5px;
                            background: new-chat-touch.has-hover ? #23251f : #1a1b16;
                            Rectangle {
                                x: 5px;
                                y: 9px;
                                width: 10px;
                                height: 1px;
                                background: new-chat-touch.has-hover ? #e7e5df : #b0b1a8;
                            }
                            Rectangle {
                                x: 9px;
                                y: 5px;
                                width: 1px;
                                height: 10px;
                                background: new-chat-touch.has-hover ? #e7e5df : #b0b1a8;
                            }
                            new-chat-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.new-chat(); }
                            }
                        }
                    }

                    ListView {
                        for item in root.sessions : SessionRow {
                            item: item;
                            selected: item.id == root.selected-id;
                            editing: item.id == root.editing-id;
                            draft <=> root.draft;
                            picked(id) => {
                                root.model-menu = false;
                                root.search-open = false;
                                root.selected-id = id;
                                // a picked row drops the card: leaving hover as the
                                // only way to clear it made it look stuck
                                root.hover-title = "";
                            }
                            hovered(full, row-y) => {
                                if full != "" {
                                    root.hover-y = row-y;
                                }
                                root.hover-title = full;
                                // hover rots: hide the card if it stops being fed,
                                // which is what made a stale title look stuck.
                                // Toggling restarts the timer: `running` is bound,
                                // so calling restart() on it would be overridden.
                                root.tooltip-on = false;
                                root.tooltip-on = true;
                            }
                            edit(id) => { root.editing-id = id; root.draft = item.full; }
                            commit(id, name) => {
                                root.editing-id = "";
                                root.rename-requested(id, name);
                            }
                        }
                    }
                }
            }

            // explicit geometry: a Rectangle's preferred size never reflects its
            // children in Slint, so a layout here always under-measured the
            // composer and let it spill past the window
            center-column := Rectangle {

                    transcript-area := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - root.composer-total;
                        background: #12130f;

                        area-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move {
                                    root.hover-title = "";
                                }
                                // this area takes the press, so the drag surface
                                // below never reports the click that should close
                                // the rail's search field
                                if event.kind == PointerEventKind.down {
                                    root.search-open = false;
                                }
                            }
                        }

                        transcript-list := ScrollView {
                            // explicit geometry: without it the view sizes itself to its
                            // content, its viewport height equals the content height, and
                            // there is no scroll range at all
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                for item[i] in root.transcript : TranscriptRow {
                                    data: item;
                                    toggle => {
                                        root.model-menu = false;
                                        root.toggle-row(i);
                                    }
                                    reason-hover(reason, x, y) => {
                                        root.reason-text = reason;
                                        root.reason-x = x;
                                        root.reason-y = y;
                                        root.reason-open = true;
                                    }
                                    reason-leave => {
                                        root.reason-open = false;
                                    }
                                }
                            }
                        }

                        // floating just above the status row, aligned with the
                    // context ring: detached from the composer
                    if !root.at-bottom : Rectangle {
                        x: transcript-area.width - self.width - 22px;
                        y: transcript-area.height - self.height - 10px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: jump-touch.has-hover ? #2e3026 : #1b1d18;
                        border-color: #34372e;
                        border-width: 1px;
                        IconDown {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        jump-touch := TouchArea {
                            clicked => { root.scroll-to-end(); }
                            mouse-cursor: pointer;
                        }
                    }

                    
                    
                        // While the rail's search is open, the whole transcript is
                        // one dismiss target: a press here cannot reach anything
                        // inside the rail, so this is where "click elsewhere" is
                        // caught. It is above the rows and swallows that press.
                        if root.search-open : Rectangle {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;

                            search-scrim := TouchArea {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        root.search-open = false;
                                    }
                                }
                            }
                        }
                    }

                    // live status row: TUI-style — one cell size for glyph and label
                    // always present: an `if`-created subtree got no hover tracking

                composer-band := Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: root.dragging ? root.band-freeze : root.composer-total;
                    background: transparent;

                    // handle, drawn on the box's top border
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: composer-box.y - 1.5px;
                        width: 36px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: root.dragging ? #6b7059
                            : (root.handle-hover ? #4a4d42 : #33362d);
                    }



    // The status row is its own rounded top, tucked 12px behind the box: while
    // a turn runs you see two rounded tops (a small one above the input's), and
    // the corner of the strip is the one that grows.
    busy-row := Rectangle {
        x: 18px;
        y: composer-box.y - root.busy-h;
        width: parent.width - 36px;
        height: root.busy-h + 12px;
        opacity: root.busy-fade;
        // No background on this rectangle at all: its own rounded corner would
        // draw a second edge a pixel off the stroke. The fill is a child, inset
        // by exactly the stroke width.

        // The outline: a border-coloured rounded rect with a fill-coloured one
        // inset by a pixel, both clipped at the strip's *visible* height. The
        // clip cuts away the bottom edge, so what is left is a rounded top and
        // two straight sides - the curvature is the rectangle's own, which is
        // the only way to get it the right way round without stroked paths.
        // The fill reaches 12px past the junction and is square by then, so it
        // wraps the box's rounded corner instead of leaving bare background in
        // the wedge between the two outlines. The box paints over the rest.
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height + 24px;
                background: #2c2f26;
                border-radius: 12px;
            }
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height + 24px;
                background: #191a14;
                border-radius: 11px;
            }
        }

        // the visible half of the strip: everything above the box's top edge
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: root.busy-h;

                            spin := Text {
                                x: 14px;
                                visible: root.busy-h > 1px;
                                text: root.spinner-frame;
                                color: #c9a86a;
                                font-family: "Cascadia Code";
                                font-size: 19px;
                                height: parent.height;
                                vertical-alignment: center;
                            }

                            lbl := Text {
                                x: spin.x + spin.width + 4px;
                                visible: root.busy-h > 1px;
                                text: root.busy-label;
                                color: #c9a86a;
                                font-family: "Cascadia Code";
                                font-size: 11px;
                                height: parent.height;
                                vertical-alignment: center;
                            }

                            Text {
                                x: lbl.x + lbl.width + 8px;
                                visible: root.busy-h > 1px;
                                text: root.busy-elapsed;
                                color: #565a4f;
                                font-family: "Cascadia Code";
                                font-size: 11px;
                                height: parent.height;
                                vertical-alignment: center;
                            }

                            // The queue lives on the strip itself: the lanes
                            // named the way the panel names them, right-aligned
                            // against the strip's padding so it balances the
                            // spinner on the left. The pill only appears under
                            // the pointer - at rest it is part of the strip.
                            if root.queued-count > 0 : Rectangle {
                                x: parent.width - self.width - 14px;
                                y: (parent.height - self.height) / 2;
                                width: lane-row.preferred-width + 16px;
                                height: 18px;
                                border-radius: 6px;
                                background: lane-touch.has-hover || root.queue-open ? #1f211a : transparent;

                                lane-row := HorizontalLayout {
                                    // full width with centred alignment: the
                                    // contents are centred in the pill by the
                                    // layout itself, not by arithmetic on a
                                    // guessed preferred width
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: root.queued-count;
                                        color: lane-touch.has-hover ? #e7e5df : #b0b1a8;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "queued";
                                        color: lane-touch.has-hover ? #b0b1a8 : #6b6e63;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                lane-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.search-open = false;
                                        root.queue-open = !root.queue-open;
                                    }
                                }
                            }

                            }
    }

                    composer-box := Rectangle {
                    x: 18px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 36px;
                    height: root.box-height;
    background: #0f100d;
    border-color: #23251f;
    border-width: 1px;
    border-radius: 12px;

    // the handle drawn on the box's top border
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: -self.height / 2;
        width: 36px;
        height: 3px;
        border-radius: 1.5px;
        background: root.dragging ? #6b7059
            : (root.handle-hover ? #4a4d42 : #33362d);
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 10px;
        // a fixed-height window over a text input that is allowed to grow:
        // pinning its bottom edge keeps the caret (newest line) in view, which
        // a fixed-height TextInput does not do on its own
        // thumbnails, 44px tiles at an 8px pitch, only while something is attached
        if root.attachment-images.length > 0 : Rectangle {
            height: 52px;
            clip: true;
            background: transparent;
            HorizontalLayout {
                y: (parent.height - 44px) / 2;
                spacing: 8px;
                for image[i] in root.attachment-images : Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 8px;
                    clip: true;
                    background: #191a15;
                    border-width: 1px;
                    border-color: thumb-touch.has-hover ? #3a3d32 : #2a2c24;

                    Image {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        source: image;
                        image-fit: cover;
                    }
                    thumb-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.attachment-removed(i); }
                    }
                    // the × only shows when the pointer is on the tile: a strip of
                    // crosses at rest reads as a toolbar, not as your attachment
                    Rectangle {
                        x: parent.width - 17px;
                        y: 3px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: #0b0c09;
                        opacity: thumb-touch.has-hover ? 0.92 : 0.0;
                        animate opacity { duration: 120ms; }
                        Rectangle {
                            x: (parent.width - 7px) / 2;
                            y: (parent.height - 1.5px) / 2;
                            width: 7px;
                            height: 1.5px;
                            border-radius: 0.75px;
                            background: #d9d6cc;
                            transform-rotation: 45deg;
                        }
                        Rectangle {
                            x: (parent.width - 7px) / 2;
                            y: (parent.height - 1.5px) / 2;
                            width: 7px;
                            height: 1.5px;
                            border-radius: 0.75px;
                            background: #d9d6cc;
                            transform-rotation: -45deg;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        draft-window := DraftEditor {
            height: root.composer-height;
            text <=> root.composer-text;
            font-size: 13px;
            edited(t) => {
                root.composer-text = t;
                root.composer-has-text = t != "";
                root.slash-typed(t);
            }
                    key-pressed(event) => {
                            // The command menu answers first while it is open.
                            if root.slash-take(event) {
                                return EventResult.accept;
                            }
                            // Enter sends, Alt+Enter steers into the
                            // running turn, Shift+Enter is a newline,
                            // Esc aborts — the TUI's bindings
                            if event.text == Key.Return {
                                // Ctrl+Enter (or Alt+Enter, kept from before) folds
                                // the message into the turn that is running instead
                                // of parking it behind
                                if event.modifiers.control || event.modifiers.alt {
                                    if root.composer-text != ""
                                        || root.attachment-images.length > 0
                                    {
                                        root.steer-requested(root.composer-text);
                                        root.composer-text = "";
                                    }
                                    return EventResult.accept;
                                }
                                if !event.modifiers.shift {
                                    if root.composer-text != ""
                                        || root.attachment-images.length > 0
                                    {
                                        root.send-requested(root.composer-text);
                                        root.composer-text = "";
                                    }
                                    return EventResult.accept;
                                }
                            }
                            // Ctrl+Shift+V attaches an image from the clipboard;
                            // plain Ctrl+V stays text paste
                            // One key for both kinds of paste: Ctrl+V attaches the
                            // image when the clipboard holds one, and otherwise
                            // falls through to the text input's own paste. The text
                            // of a chorded key is not always the letter — with
                            // control it arrives as the control character, with
                            // shift as the capital — so all three are the same key.
                            if event.modifiers.control
                                && (event.text == "v" || event.text == "V"
                                    || event.text == "\u{16}")
                            {
                                if root.attach-pasted() {
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                            if event.text == Key.Escape {
                                root.abort-requested();
                                return EventResult.accept;
                            }
                            if event.text == Key.End && event.modifiers.control {
                                root.scroll-to-end();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
            init => { self.grab-focus(); }
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            // the context ring sits in the button row, not in the status strip:
            // the strip appears and disappears with every turn, and a number you
            // are reading should not travel
            Rectangle {
                width: 22px;
                height: 24px;

                ctx := Rectangle {
                    x: 1px;
                    y: 2px;
                    width: 20px;
                    height: 20px;

                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 10.00 4.00 L 10.00 1.30";
                        stroke: 0.0000 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 11.55 4.20 L 12.25 1.60";
                        stroke: 0.0417 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 13.00 4.80 L 14.35 2.47";
                        stroke: 0.0833 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 14.24 5.76 L 16.15 3.85";
                        stroke: 0.1250 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.20 7.00 L 17.53 5.65";
                        stroke: 0.1667 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.80 8.45 L 18.40 7.75";
                        stroke: 0.2083 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 16.00 10.00 L 18.70 10.00";
                        stroke: 0.2500 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.80 11.55 L 18.40 12.25";
                        stroke: 0.2917 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 15.20 13.00 L 17.53 14.35";
                        stroke: 0.3333 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 14.24 14.24 L 16.15 16.15";
                        stroke: 0.3750 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 13.00 15.20 L 14.35 17.53";
                        stroke: 0.4167 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 11.55 15.80 L 12.25 18.40";
                        stroke: 0.4583 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 10.00 16.00 L 10.00 18.70";
                        stroke: 0.5000 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 8.45 15.80 L 7.75 18.40";
                        stroke: 0.5417 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 7.00 15.20 L 5.65 17.53";
                        stroke: 0.5833 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 5.76 14.24 L 3.85 16.15";
                        stroke: 0.6250 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.80 13.00 L 2.47 14.35";
                        stroke: 0.6667 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.20 11.55 L 1.60 12.25";
                        stroke: 0.7083 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.00 10.00 L 1.30 10.00";
                        stroke: 0.7500 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.20 8.45 L 1.60 7.75";
                        stroke: 0.7917 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 4.80 7.00 L 2.47 5.65";
                        stroke: 0.8333 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 5.76 5.76 L 3.85 3.85";
                        stroke: 0.8750 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 7.00 4.80 L 5.65 2.47";
                        stroke: 0.9167 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 8.45 4.20 L 7.75 1.60";
                        stroke: 0.9583 <= root.context-fill ? #c9a86a : #33362d;
                        stroke-width: 1.5px;
                    }
                }

                // the ring is 20px: the hover target is the whole cell
                ctx-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.pointer;
                    changed has-hover => { root.ctx-hover = self.has-hover; }
                }

                // the numbers behind the ring
                if root.ctx-hover : Rectangle {
                    x: -self.width + 20px;
                    y: -self.height - 14px;
                    width: 216px;
                    height: self.preferred-height;
                    background: #171814;
                    border-color: #2a2c24;
                    border-width: 1px;
                    border-radius: 8px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000066;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        ContextCard {
                            fill: root.context-fill;
                            used: root.context-text;
                            percent: root.ctx-percent;
                            messages: root.stat-messages;
                            tools: root.stat-tools;
                            input: root.stat-in;
                            output: root.stat-out;
                            cached: root.stat-cache;
                            cost: root.cost-session;
                            cost-family: root.cost-family;
                            cost-family-on: root.cost-family-on;
                        }
                    }
                }
            }

            // attach: a plus in a quiet resting surface, same family as the rest
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: attach-touch.has-hover ? #23251f : #1a1b16;
                animate background { duration: 120ms; }
                Rectangle {
                    x: (parent.width - 8px) / 2;
                    y: (parent.height - 1.5px) / 2;
                    width: 8px;
                    height: 1.5px;
                    border-radius: 0.75px;
                    background: attach-touch.has-hover ? #b0b1a8 : #8a8d82;
                }
                Rectangle {
                    x: (parent.width - 1.5px) / 2;
                    y: (parent.height - 8px) / 2;
                    width: 1.5px;
                    height: 8px;
                    border-radius: 0.75px;
                    background: attach-touch.has-hover ? #b0b1a8 : #8a8d82;
                }
                attach-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.attach-requested(); }
                }
            }
            Chip {
                label: root.model-label;
                open: root.model-menu;
                toggled => {
                    root.search-open = false;
                    root.model-menu = !root.model-menu;
                    if root.model-menu {
                        root.model-menu-opened();
                    }
                }
            }
            // One control, two jobs: send while the session is idle, stop while it
            // works. A single TouchArea with the branch inside it - a button that
            // swaps element on a condition does not take clicks here.
            //
            // The two marks are always both present and cross over: the arrow
            // shrinks and turns as it goes, the stop square grows out of the
            // middle and turns the other way. Slint cannot interpolate one path
            // into another, so the fluidity is scale, rotation and opacity on the
            // same clock - which is what a morph looks like anyway.
            Rectangle {
                width: 25px;
                height: 25px;
                border-radius: 12.5px;
                background: root.stop-mode
                    ? (send-touch.has-hover ? #b8614c : #a2543f)
                    : (send-touch.has-hover ? #b39e4c : #a18e41);
                animate background { duration: 240ms; easing: ease-in-out; }

                IconSend {
                    width: 12px * (1.0 - 0.34 * root.stop-mix);
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    opacity: 1.0 - root.stop-mix;
                    transform-rotation: root.stop-mix * 45deg;
                }

                Rectangle {
                    width: 2px + 6px * root.stop-mix;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    // a dot rounding out into a square as it arrives
                    border-radius: 3px - 1.5px * root.stop-mix;
                    background: #f6efe6;
                    opacity: root.stop-mix;
                    transform-rotation: (1.0 - root.stop-mix) * -45deg;
                }

                send-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.model-menu = false;
                        if root.stop-mode {
                            // the daemon keeps the queue flowing behind the stopped
                            // run, so the next waiting message is not stranded
                            root.abort-requested();
                        } else {
                            root.send-requested(root.composer-text);
                            root.composer-text = "";
                        }
                    }
                }
            }
        }
    }
}
                }
            }

            Rectangle {
                width: 260px;
                background: #10110e;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text {
                        text: "review";
                        color: #565a4f;
                        font-size: 10px;
                    }
                    Text {
                        text: "nothing to review yet";
                        color: #34372e;
                        font-size: 11px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
    }

    // title card: anchored to the row it describes and shown just to the right
    // of the rail, the way a tooltip is expected to behave
    if root.hover-title != "" : Rectangle {
        x: 244px;
        y: clamp(root.hover-y - 4px, 46px, root.height - self.height - 12px);
        width: min(self.preferred-width, 260px);
        height: self.preferred-height;
        background: #171814;
        border-color: #2a2c24;
        border-width: 1px;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            Text {
                text: root.hover-title;
                color: #e2e0d8;
                font-size: 11px;
                wrap: word-wrap;
                max-width: 240px;
            }
        }
    }


        // nothing keeps a hover alive forever: this is the safety net
    tooltip-timer := Timer {
        interval: 6000ms;
        running: root.tooltip-on;
        triggered => {
            root.hover-title = "";
            root.tooltip-on = false;
        }
    }

    // the menu is the last child of the window so nothing paints or hit-tests
    // above it: nested in the composer it sat behind the transcript's scroll
    // layer, which composites over later siblings
    changed composer-focused => {
        if root.composer-focused {
            root.search-open = false;
        }
    }

    // The command menu: opens the moment a slash starts the message, narrows as
    // more is typed, and sits directly above the box it belongs to. Capped and
    // scrollable, because it can hold every builtin at once.
    if root.slash-open && root.slash-items.length > 0 : Rectangle {
        x: composer-box.absolute-position.x + 12px;
        y: composer-box.absolute-position.y - self.height - 6px;
        width: min(460px, composer-box.width - 24px);
        // ten rows at a time; the list scrolls and the highlight pulls it along
        height: min(312px, 12px + root.slash-items.length * 30px);
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        slash-list := ScrollView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: self.visible-height;
            // the highlight must never walk off the top or bottom of the list:
            // arrowing down past the fold used to select a row nobody could see
            viewport-y: -clamp(
                root.slash-index * 30px - 60px,
                0px,
                max(0px, root.slash-items.length * 30px - self.height)
            );

            slash-rows := VerticalLayout {
                width: slash-list.visible-width;
                for item[index] in root.slash-items : Rectangle {
                    width: parent.width;
                    height: 30px;
                    border-radius: 6px;
                    background: index == root.slash-index ? #1f211a : transparent;

                    HorizontalLayout {
                        x: 8px;
                        y: 0;
                        width: parent.width - 16px;
                        height: 100%;
                        spacing: 6px;
                        Text {
                            text: "/" + item.name;
                            font-size: 13px;
                            color: index == root.slash-index ? #e7e5df : #b0b1a8;
                            vertical-alignment: center;
                        }
                        if item.hint != "" : Text {
                            text: item.hint;
                            font-size: 11px;
                            color: index == root.slash-index ? #8f917f : #565a4f;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.description;
                            font-size: 11px;
                            color: index == root.slash-index ? #a9ab9d : #6b6e63;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    slash-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.slash-index = index;
                            root.slash-accept();
                        }
                        moved => {
                            if self.has-hover {
                                root.slash-index = index;
                            }
                        }
                    }
                }
            }
        }
    }

    // the model menu: real catalog, grouped by provider, each
    // group collapsible. Anchored above the composer box at the
    // right, where the model chip sits.
    if root.model-menu : Rectangle {
        x: composer-box.absolute-position.x + composer-box.width - self.width - 12px;
        y: composer-box.absolute-position.y - self.height - 6px;
        width: 300px;
        height: max(64px, min(340px, root.model-menu-height));
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        menu-scroll := ScrollView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: menu-list.preferred-height;

            // A group is one block: its header plus a row per
            // model. Collapsed groups carry no models at all,
            // so their height is just the header.
            // behind every row: a move here is a move off the rows
            menu-bg := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: parent.content-height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.pointer-moved();
                    }
                }
            }

            menu-list := VerticalLayout {
                for group in root.model-groups : Rectangle {
                    height: 26px + group.models.length * 24px;

                    group-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 26px;
                        mouse-cursor: pointer;
                        clicked => { root.provider-toggled(group.provider); }
                        // a header is not a model row: the ladder does not
                        // belong to it
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.pointer-moved();
                            }
                        }
                    }

                    IconCaret {
                        x: 6px;
                        y: (26px - self.height) / 2;
                        up: !group.open;
                    }
                    Text {
                        x: 22px;
                        y: 0;
                        width: parent.width - 80px;
                        height: 26px;
                        text: group.label;
                        color: group.configured ? #d9d8d1 : #6b6f62;
                        font-size: 11px;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    Text {
                        x: parent.width - 58px;
                        y: 0;
                        width: 52px;
                        height: 26px;
                        text: group.configured ? group.count : "not signed in";
                        color: #565a4f;
                        font-size: 9px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    for model[i] in group.models : Rectangle {
                        x: 0;
                        y: 26px + i * 24px;
                        width: 100%;
                        height: 24px;
                        border-radius: 5px;
                        background: model.current ? #23251f
                            : (model-touch.has-hover ? #1f211a : transparent);

                        model-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.model-picked(model.id, group.provider);
                                root.model-menu = false;
                            }
                            // the ladder drops off the row under the pointer;
                            // the row's window y is what it hangs from. Two
                            // sources, because the move callback alone missed
                            // pointer entries that never reported a move.
                            moved => {
                                if self.has-hover {
                                    root.model-hovered(group.provider, model.id,
                                        self.absolute-position.y);
                                }
                            }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move {
                                    root.model-hovered(group.provider, model.id,
                                        self.absolute-position.y);
                                }
                            }
                        }

                        Text {
                            x: 24px;
                            y: 0;
                            width: parent.width - 108px;
                            height: 100%;
                            text: model.label;
                            color: model.current ? #e7e5df : #b0b1a8;
                            font-size: 11px;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        // the running model names its level right of the name;
                        // every other row shows the context window instead
                        Text {
                            x: parent.width - 118px;
                            y: 0;
                            width: 74px;
                            height: 100%;
                            text: model.effort != "" ? model.effort : model.detail;
                            color: model.effort != "" ? #a18e41 : #565a4f;
                            font-size: 9px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        // the selected model is marked, not just tinted: two
                        // 2px strokes, heavier than the 1.5px marks elsewhere
                        if model.current : Path {
                            x: parent.width - 26px;
                            y: (parent.height - self.height) / 2;
                            width: 11px;
                            height: 11px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            stroke: #a18e41;
                            stroke-width: 1.5px;
                            commands: "M 1 6.4 L 4.4 9.8 L 11 2.2";
                        }
                    }
                }
            }
        }
    }

    // The effort ladder, hung to the left of the model menu: the menu sits on
    // the composer's right edge, so there is no room on its right for a second
    // column. It tracks the hovered row's y and stays inside the menu's band.
    if root.model-menu && root.effort-open : Rectangle {
        x: composer-box.absolute-position.x + composer-box.width - 300px - 12px
            - self.width - 6px;
        y: max(
            composer-box.absolute-position.y
                - max(64px, min(340px, root.model-menu-height)) - 6px,
            min(root.effort-y - 4px,
                composer-box.absolute-position.y - 6px - self.height)
        );
        width: 132px;
        height: 10px + root.effort-items.length * 26px;
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 8px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000060;

        // the ladder answers for its own surface, or moving onto it would
        // count as leaving the row it hangs from
        ladder-bg := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.effort-hovered();
                }
            }
        }

        for item[i] in root.effort-items : Rectangle {
            x: 0;
            y: 5px + i * 26px;
            width: 100%;
            height: 26px;
            border-radius: 5px;
            background: item-touch.has-hover ? #1f211a : transparent;

            item-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.effort-picked(i); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.effort-hovered();
                    }
                }
            }

            Text {
                x: 12px;
                y: 0;
                width: parent.width - 40px;
                height: 100%;
                text: item.label;
                color: item.current ? #e7e5df : #b0b1a8;
                font-size: 11px;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
            if item.current : Path {
                x: parent.width - 24px;
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                viewbox-width: 12;
                viewbox-height: 12;
                stroke: #a18e41;
                stroke-width: 1.4px;
                commands: "M 1 6.4 L 4.4 9.8 L 11 2.2";
            }
        }
    }

    // The queue panel hangs off the strip, at the window root like the model
    // menu: inside the band it sat at a negative y, where it painted outside
    // the area that answers clicks.
    if root.queue-open && root.queued-count > 0 : queue-panel := Rectangle {
        // measured off the composer box, not the band: the strip's height is
        // animated, and the panel has to ride it
        x: composer-box.absolute-position.x + composer-box.width - self.width;
        y: composer-box.absolute-position.y - root.busy-h - self.height - 6px;
        width: 320px;
        // the list is capped and scrolls: a long queue used to walk off the top
        // of the window, where the rows could not even be reached
        // not `q-scroll.height`: a ScrollView's height reads back as nothing at
        // the time the parent binds, which collapsed the panel to a sliver
        height: root.q-scroll-h + 12px;
        background: #171814;
        border-color: #2c2f26;
        border-width: 1px;
        border-radius: 10px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        q-scroll := ScrollView {
            x: 0;
            y: 6px;
            width: parent.width;
            height: root.q-scroll-h;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: root.q-content-h;

            Rectangle {
                width: 100%;
                height: root.q-content-h;
                // rows are placed by arithmetic, so the content root is the one
                // thing that can stop a long queue painting past the panel
                clip: true;

                if root.queued-steering.length > 0 : Text {
                    x: 10px;
                    y: 0;
                    height: 20px;
                    vertical-alignment: center;
                    text: root.queued-count == 1 ? "1 message waiting" : root.queued-count + " messages waiting";
                    color: #b0b1a8;
                    font-size: 9px;
                }
                for item[i] in root.queued-steering : QueueRow {
                    y: root.q-head-in + i * 34px;
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.text;
                    lane: "steering";
                    slot: item.slot;
                    thumb: item.thumb;
                    act(lane, slot, action) => {
                        root.queue-act(lane, slot, action);
                        if action != "edit" {
                            root.queue-open = false;
                        }
                    }
                }

                if root.queued-followup.length > 0 : Text {
                    x: 10px;
                    y: root.q-head-in + root.q-rows-in + root.q-lane-gap;
                    height: 20px;
                    vertical-alignment: center;
                    text: "runs next";
                    color: #6b6e63;
                    font-size: 9px;
                }
                for item[i] in root.queued-followup : QueueRowUp {
                    y: root.q-head-in + root.q-rows-in + root.q-lane-gap + root.q-head-next + i * 34px;
                    x: 8px;
                    width: parent.width - 16px;
                    text: item.text;
                    lane: "followUp";
                    slot: item.slot;
                    thumb: item.thumb;
                    act(lane, slot, action) => {
                        root.queue-act(lane, slot, action);
                        if action != "edit" {
                            root.queue-open = false;
                        }
                    }
                }

                Rectangle {
                    x: 8px;
                    y: root.q-content-h - 24px;
                    width: parent.width - 16px;
                    height: 22px;
                    border-radius: 5px;
                    background: clear-touch.has-hover ? #1f211a : transparent;

                    Text {
                        x: 2px;
                        y: 0;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "clear all";
                        color: clear-touch.has-hover ? #d9d8d1 : #6b6e63;
                        font-size: 10px;
                    }

                    clear-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.queue-clear();
                            root.queue-open = false;
                        }
                    }
                }
            }
        }
    }

    // A failure reason is drawn at the window root: inside the row it was
    // covered by whatever row came next, so a command row painted over the
    // popup that belonged to the row above it.
    if root.reason-open : Rectangle {
        x: min(root.reason-x, root.width - self.width - 12px);
        y: root.reason-y + 4px;
        width: self.preferred-width;
        max-width: 320px;
        height: self.preferred-height;
        max-height: 4 * reason-line.preferred-height + 16px;
        background: #1d1412;
        border-color: #6b342b;
        border-width: 1px;
        border-radius: 6px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            Text {
                text: root.reason-text;
                color: #e0b6ad;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
        reason-line := Text {
            x: -400px;
            text: "x";
            font-size: 10px;
            opacity: 0;
        }
    }







}
