// The sessions column: one session's row, and the headers that group the rows.
//
// A row is a name and nothing else: the state it is in is which group the row sits
// under, so no row carries a tag dot, an age or a status word. Double-clicking a
// row renames it in place; the three-dots menu appears under the pointer.

import { SessionItem, Type } from "types.slint";
import { IconCaret, IconDoneTick, IconGrip, IconMore } from "icons.slint";
import { Theme } from "theme.slint";
import { Button } from "primitives.slint";

// A group header: the caret, the word, and how many rows it holds. Clicking it
// folds the group.
export component SessionGroupHeader inherits Rectangle {
    in property <string> label;
    in property <int> count;
    // folded: the caret points at the rows instead of down at them
    in property <bool> closed: false;
    callback toggled();

    height: 32px;
    border-radius: 6px;
    background: header-touch.has-hover ? Theme.sidebar-row-fill-hover : transparent;

    header-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }

    // No layout here either, for the same reason as the row below: a layout
    // makes the header report a preferred height the list then uses, and the
    // list drew its entries a header apart from where they were written.
    hdr-label := Text {
        x: 10px;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        text: root.label;
        color: header-touch.has-hover ? Theme.sidebar-name-ink-selected : Theme.sidebar-group-ink;
        font-size: 12.5px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    Rectangle {
        x: 10px + hdr-label.preferred-width + 6px;
        y: 0;
        width: 12px;
        height: parent.height;
        opacity: header-touch.has-hover ? 1.0 : 0.0;
        animate opacity { duration: 120ms; easing: ease-in-out; }

        IconCaret {
            x: 0;
            y: (parent.height - self.height) / 2 + 1px;
            up: false;
            transform-rotation: root.closed ? -90deg : 0deg;
            animate transform-rotation { duration: 160ms; easing: ease-in-out; }
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            tint: header-touch.has-hover ? Theme.sidebar-name-ink-selected : Theme.sidebar-group-caret;
        }
    }

    Text {
        // the count's own cell, right-aligned at the header's edge
        x: parent.width - 10px - 32px;
        y: 0;
        width: 32px;
        height: parent.height;
        text: root.count;
        color: header-touch.has-hover ? Theme.sidebar-name-ink-selected : Theme.sidebar-group-ink;
        font-size: 11.5px;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

export component SessionRow inherits Rectangle {
    in property <SessionItem> item;
    in property <bool> selected;
    in property <bool> editing;
    in-out property <string> draft;
    // the row's menu is open: the dots stay lit under it
    in property <bool> menu-open: false;
    in property <bool> reorderable: false;
    in property <bool> dragging-this: false;
    in property <bool> drop-before: false;
    in property <bool> drop-after: false;
    callback picked(string);
    // the row's own window position rides along, so the card can sit beside it
    callback hovered(string, length);
    callback edit(string);
    callback commit(string, string);
    // the three dots: the row's menu, opened beside the button, or closed when
    // this row's menu is the open one. The position is sent so the panel can
    // hang there, and the id so the window can read which item set the row's
    // kind calls for.
    callback toggled(string, length, length);
    callback drag-started(string, string, length);
    callback drag-moved(length);
    callback drag-ended(bool, length);
    // the row's own pointer state, so the component can watch it change: a
    // `changed` block only takes an identifier, and `ta.has-hover` is not one
    out property <bool> hot: ta.has-hover;
    private property <bool> press-armed: false;
    private property <bool> dragging: false;
    private property <bool> suppress-click: false;
    private property <length> press-y: 0px;

    function reset-drag() {
        if root.dragging {
            root.drag-ended(false, 0px);
        }
        root.dragging = false;
        root.press-armed = false;
        root.suppress-click = false;
    }

    changed reorderable => {
        if !root.reorderable {
            root.reset-drag();
        }
    }

    changed editing => {
        if root.editing {
            root.reset-drag();
        }
    }

    height: 32px;
    border-radius: 6px;
    border-width: root.dragging-this ? 1px : 0px;
    border-color: Theme.search-match-ink;
    background: selected ? Theme.sidebar-row-fill-selected
        : (ta.has-hover ? Theme.sidebar-row-fill-hover : Theme.sidebar-row-fill);

    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 28px;
        height: 100%;
        mouse-cursor: root.dragging ? MouseCursor.grabbing
            : (root.reorderable && !root.editing && self.mouse-x < 20px ? MouseCursor.grab : MouseCursor.pointer);
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)
                && (root.dragging || root.press-armed)
            {
                if root.dragging {
                    root.drag-ended(
                        event.kind == PointerEventKind.up && root.reorderable && !root.editing,
                        self.absolute-position.y + self.mouse-y,
                    );
                    root.dragging = false;
                }
                if event.kind == PointerEventKind.cancel || !self.has-hover || !root.reorderable || root.editing {
                    root.suppress-click = false;
                }
                root.press-armed = false;
                return;
            }
            if !root.reorderable || root.editing {
                root.suppress-click = false;
                return;
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.press-armed = true;
                root.dragging = false;
                root.suppress-click = false;
                root.press-y = self.absolute-position.y + self.mouse-y;
            } else if event.kind == PointerEventKind.move && root.press-armed {
                let cy = self.absolute-position.y + self.mouse-y;
                if !root.dragging && abs(cy - root.press-y) > 5px {
                    root.dragging = true;
                    root.suppress-click = true;
                    root.drag-started(root.item.id, root.item.status, cy);
                } else if root.dragging {
                    root.drag-moved(cy);
                }
            }
        }
        clicked => {
            if !root.suppress-click {
                root.picked(root.item.id);
            }
            root.suppress-click = false;
        }
        double-clicked => { root.edit(root.item.id); }
    }

    if root.reorderable && !root.editing : IconGrip {
        x: 6px;
        y: (parent.height - self.height) / 2;
        tint: root.dragging-this || ta.has-hover
            ? Theme.sidebar-name-ink-selected
            : Theme.sidebar-group-caret;
    }

    if root.drop-before : Rectangle {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.search-match-ink;
    }

    if root.drop-after : Rectangle {
        x: 4px;
        y: parent.height - 2px;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.search-match-ink;
    }

    changed hot => {
        if !hot {
            root.hovered("", 0px);
        }
    }

    if root.item.done : Rectangle {
        x: 20px;
        y: 0;
        width: 11px;
        height: parent.height;
        IconDoneTick {
            x: 0;
            y: (parent.height - self.height) / 2;
        }
    }

    // the name: from the indent (or tick) to just before the three-dots button
    if !root.editing : Text {
        x: root.item.done ? 36px : 20px;
        y: 0;
        width: parent.width - self.x - 9px - 22px;
        height: parent.height;
        text: root.item.name;
        color: root.selected ? Theme.sidebar-name-ink-selected
            : Theme.sidebar-name-ink;
        font-size: Type.item;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    if root.editing : input := TextInput {
        x: root.item.done ? 36px : 20px;
        text <=> root.draft;
        y: 0;
        width: parent.width - self.x - 9px - 22px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.sidebar-name-ink-editing;
        font-size: Type.item;
        single-line: true;
        accepted => { root.commit(root.item.id, self.text); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.commit(root.item.id, root.item.full);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        init => { self.focus(); }
    }

    // The dots, at the row's right edge: 22px wide, 6px in from it.
    menu-slot := Rectangle {
        x: parent.width - 6px - 22px;
        y: 0;
        width: 22px;
        height: parent.height;

        menu := Button {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            border-radius: 5px;
            lit: root.menu-open || ta.has-hover;
            // The button is always mounted so the 22px slot still takes the
            // pointer; at rest it is transparent instead of opacity: 0. A
            // per-row Opacity item with children allocates a layer for every
            // row, even off screen, which made a 150-row fold crawl.
            fill: transparent;
            fill-hover: Theme.sidebar-row-rename-fill-hover;
            enabled: !root.editing;
            described: "Session menu";
            clicked => {
                // the row's own toggle: `app.slint` owns which menu is open, so
                // it decides whether this press opens one or closes the one here
                root.toggled(root.item.id, self.absolute-position.x,
                    self.absolute-position.y + self.height);
            }
            visible: !root.editing;
            IconMore {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: menu.on ? Theme.sidebar-name-ink-selected : transparent;
                animate tint { duration: 100ms; }
            }
        }
    }
}
