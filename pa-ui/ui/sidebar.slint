// The sessions column: one session's row, and the tag that says what it is doing.

import { SessionItem, Type } from "types.slint";
import { MarqueeText } from "marquee-text.slint";
import { IconPencil } from "icons.slint";
import { Theme } from "theme.slint";
import { Button, Tag, TagKind } from "primitives.slint";

export component SessionRow inherits Rectangle {
    in property <SessionItem> item;
    in property <bool> selected;
    in property <bool> editing;
    in-out property <string> draft;
    callback picked(string);
    // the row's own window position rides along, so the card can sit beside it
    callback hovered(string, length);
    callback edit(string);
    callback commit(string, string);
    // the row's own pointer state, so the component can watch it change: a
    // `changed` block only takes an identifier, and `ta.has-hover` is not one
    out property <bool> hot: ta.has-hover;

    height: 32px;
    border-radius: 6px;
    background: selected ? Theme.sidebar-row-fill-selected
        : (ta.has-hover ? Theme.sidebar-row-fill-hover : Theme.sidebar-row-fill);

    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 30px;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(root.item.id); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered(root.item.tip, self.absolute-position.y);
            }
        }
    }

    // Leaving the row is the half `move` cannot report: walking up into the
    // blank band above the list produces no further move inside the row, so the
    // card used to sit there until the timer gave up. The `changed` block lives
    // on the row rather than inside the TouchArea - inside it, a has-hover
    // change eats the click that follows.
    changed hot => {
        if !hot {
            root.hovered("", 0px);
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            clip: true;

            // a name longer than the sidebar travels while the row is hovered;
            // left alone the row is clipped where it lies, as it always was
            if !root.editing : MarqueeText {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.item.name;
                text-color: root.selected ? Theme.sidebar-name-ink-selected
                    : Theme.sidebar-name-ink;
                font-size: Type.item;
                active: ta.has-hover;
            }

            if root.editing : input := TextInput {
                text: root.draft;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                color: Theme.sidebar-name-ink-editing;
                font-size: Type.item;
                single-line: true;
                edited => { root.draft = self.text; }
                accepted => { root.commit(root.item.id, root.draft); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.commit(root.item.id, root.item.full);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                init => { self.focus(); }
            }
        }

        Rectangle {
            width: 18px;
            height: 32px;
            rename := Button {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                // The chip only appears under the pointer, so its resting fill is
                // the row's own hover rather than a field of its own; the pointer
                // on the chip itself lifts it one more step.
                fill: Theme.sidebar-row-rename-fill;
                fill-hover: Theme.sidebar-row-rename-fill-hover;
                enabled: !root.editing;
                described: "Rename the session";
                clicked => { root.edit(root.item.id); }
                visible: !root.editing;
                opacity: ta.has-hover || rename.hot ? 1 : 0;
                animate opacity { duration: 100ms; }
                IconPencil {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        Rectangle {
            width: age-text.preferred-width;
            height: 32px;
            age-text := Text {
                text: root.item.age;
                color: Theme.sidebar-age-ink;
                font-size: 10px;
                height: parent.height;
                vertical-alignment: center;
                opacity: root.editing ? 0 : 1;
            }
        }

        Rectangle {
            width: 5px;
            height: 32px;
            // The three words the wire uses for what a session is doing, and the
            // one tag state each of them names.
            Tag {
                y: (parent.height - self.height) / 2;
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                kind: root.item.status == "working" ? TagKind.working
                    : root.item.status == "parked" ? TagKind.parked : TagKind.idle;
                opacity: root.editing ? 0 : 1;
            }
        }
    }
}
