import { ScrollView } from "std-widgets.slint";
import { Button, Panel, PopupShell } from "primitives.slint";
import {
    IconCaret,
    IconCheck,
    IconCross,
    IconSearch,
    IconSettingsAppearance,
    IconSettingsGeneral
} from "icons.slint";
import { Appearance, ThemeItem, Type } from "types.slint";
import { Theme } from "theme.slint";

component SettingsToggle inherits Button {
    in property <bool> checked: false;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    fill: root.checked ? Theme.composer-send-fill : Theme.panel-edge;
    fill-hover: root.checked ? Theme.composer-send-fill-hover : Theme.composer-chip-edge-hover;

    Rectangle {
        x: root.checked ? 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.composer-send-mark : Theme.search-row-ink-hover;
        animate x { duration: Appearance.hover-duration; easing: ease-out; }
    }
}

component SettingsChoice inherits Button {
    in property <string> value;
    in property <[string]> options;
    in property <bool> expanded: false;
    callback picked(string);
    callback dismissed();
    width: 168px;
    height: 28px;
    border-radius: 7px;
    fill: Theme.composer-surface;
    fill-hover: Theme.panel-row-fill-hover;
    border-width: 1px;
    border-color: root.expanded || root.hot ? Theme.composer-chip-edge-hover : Theme.panel-edge;
    lit: root.expanded;

    Text {
        x: 10px;
        y: 0;
        width: parent.width - 30px;
        height: 100%;
        text: root.value;
        color: Theme.search-row-ink-hover;
        font-size: Type.item - 1px;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    IconCaret {
        x: parent.width - 18px;
        y: (parent.height - self.height) / 2;
        up: root.expanded;
        tint: root.expanded || root.hot ? Theme.search-row-ink-hover : Theme.model-menu-caret-mark;
    }

    popup := PopupShell {
        popup-x: root.width - 210px;
        popup-y: root.height + 6px;
        popup-width: 210px;
        popup-height: root.options.length * 30px + 6px;
        menu-radius: 8px;
        open: root.expanded;
        dismissed => { root.dismissed(); }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 4px;
            spacing: 2px;

            for option in root.options : Rectangle {
                height: 28px;
                border-radius: 5px;
                background: option == root.value ? Theme.panel-row-fill-current
                    : option-touch.has-hover ? Theme.panel-row-fill-hover : transparent;

                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked(option);
                        root.dismissed();
                    }
                }

                Text {
                    x: 10px;
                    y: 0;
                    width: parent.width - 38px;
                    height: 100%;
                    text: option;
                    color: option == root.value || option-touch.has-hover
                        ? Theme.search-row-ink-hover : Theme.search-row-ink;
                    font-size: Type.item - 1px;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }

                if option == root.value : IconCheck {
                    x: parent.width - 22px;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

component SettingsSegmented3 inherits Rectangle {
    in property <string> opt-a;
    in property <string> opt-b;
    in property <string> opt-c;
    in property <string> value;
    callback picked(string);

    width: 210px;
    height: 28px;
    border-radius: 7px;
    background: Theme.composer-surface;
    border-width: 1px;
    border-color: Theme.panel-edge;

    seg-a := Button {
        x: 2px;
        y: 2px;
        width: 68px;
        height: 24px;
        border-radius: 5px;
        lit: root.value == root.opt-a;
        fill: transparent;
        fill-hover: root.value == root.opt-a ? Theme.panel-row-fill-current : Theme.panel-row-fill-hover;
        described: root.opt-a;
        clicked => { root.picked(root.opt-a); }
        Text {
            width: 100%;
            height: 100%;
            text: root.opt-a;
            color: root.value == root.opt-a || seg-a.hot ? Theme.search-row-ink-hover : Theme.search-row-ink;
            font-size: Appearance.session-count-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    seg-b := Button {
        x: 71px;
        y: 2px;
        width: 68px;
        height: 24px;
        border-radius: 5px;
        lit: root.value == root.opt-b;
        fill: transparent;
        fill-hover: root.value == root.opt-b ? Theme.panel-row-fill-current : Theme.panel-row-fill-hover;
        described: root.opt-b;
        clicked => { root.picked(root.opt-b); }
        Text {
            width: 100%;
            height: 100%;
            text: root.opt-b;
            color: root.value == root.opt-b || seg-b.hot ? Theme.search-row-ink-hover : Theme.search-row-ink;
            font-size: Appearance.session-count-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    seg-c := Button {
        x: 140px;
        y: 2px;
        width: 68px;
        height: 24px;
        border-radius: 5px;
        lit: root.value == root.opt-c;
        fill: transparent;
        fill-hover: root.value == root.opt-c ? Theme.panel-row-fill-current : Theme.panel-row-fill-hover;
        described: root.opt-c;
        clicked => { root.picked(root.opt-c); }
        Text {
            width: 100%;
            height: 100%;
            text: root.opt-c;
            color: root.value == root.opt-c || seg-c.hot ? Theme.search-row-ink-hover : Theme.search-row-ink;
            font-size: Appearance.session-count-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

