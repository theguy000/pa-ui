// Every glyph the window draws, in the order the window reads: chrome, sidebar,
// transcript, composer, menus. Each is a Path over a 24- or 12-unit viewbox, sized
// in px here, so a call site sets a tint and a position and nothing else.
//
// Outlines stroke `tint` and fill nothing; solids fill `tint` and stroke nothing.
// The tint defaults to a role rather than a value, and it is the role of the part
// the glyph rests in, so a glyph drawn into a themed window follows that theme
// without its call site saying anything. A call site overrides it only where the
// glyph is drawn in another state or another part.
//
// Material Symbols (filled) is Apache-2.0; Lucide is ISC.

import { Theme } from "theme.slint";

// window chrome

// The minimise, maximise and close marks. A base, not a glyph: the three call
// sites supply their own `commands` on a 10x10 viewbox.
export component CaptionGlyph inherits Path {
    in property <color> tint: Theme.title-bar-glyph;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    stroke: tint;
    stroke-width: 1px;
    fill: transparent;
}

// A frame, its folded edge, and - once the pointer is on it - the direction the
// column will travel. Resting it is only a frame, so the hover is what tells you
// what the click is going to do. Two columns draw it: the right one from the
// title bar, which tints it from the title bar's roles, and the sidebar from its
// own header, which is why the default is the sidebar's resting mark.
export component PanelIcon inherits Path {
    // the folded edge sits on the right for the right-hand column
    in property <bool> folded-edge-right: false;
    in property <bool> arrow: false;
    in property <bool> point-left: false;
    in property <color> tint: Theme.sidebar-fold-glyph;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 7 3 L 17 3 A 4 4 0 0 1 21 7 L 21 17 A 4 4 0 0 1 17 21 L 7 21 A 4 4 0 0 1 3 17 L 3 7 A 4 4 0 0 1 7 3 Z"
        + (folded-edge-right ? " M 16 8 L 16 16" : " M 8 8 L 8 16")
        + (arrow
            ? (folded-edge-right
                ? (point-left ? " M 11.5 9.5 L 8.5 12 L 11.5 14.5" : " M 9 9.5 L 12 12 L 9 14.5")
                : (point-left ? " M 15 9.5 L 12 12 L 15 14.5" : " M 12.5 9.5 L 15.5 12 L 12.5 14.5"))
            : "");
}

// sidebar

// The Prime Agent mark (from design/logo-designer.html: stemExt = 0.100 (+10.0%), weight = 0.152),
// drawn bare without its dark tile on a tight 74x74 viewbox around the glyph bounds
// (x: 28..73, y: 16.5..89.5), with the source-atop shadows pre-clipped to the stem and wing.
//
// Its six tones are the theme's, not the artwork's: every one of them is a brand
// role, and five of those are the brand tone mixed towards the field the mark is
// cut from, so a theme that turns the window over turns the mark over with it and
// the shadows keep their distance from the shapes they darken. The mixes live on
// the roles in src/theme/table.rs, and the tones they come to in that table's
// tests.
export component PrimeAgentMark inherits Rectangle {
    width: 18px;
    height: 18px;
    background: transparent;

    // Lower parallel wing, with wingVy = th / cos(angLow) = 18.31
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 13.5;
        viewbox-y: 16.0;
        viewbox-width: 74;
        viewbox-height: 74;
        fill: Theme.brand-mark-wing;
        stroke: transparent;
        commands: "M 51.59 37.56 L 43.2 43.19 L 43.2 61.5 L 73 41.5 Z";
    }

    // Wing's inner stem-shadow, clipped to x = 43.2..45.4
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 13.5;
        viewbox-y: 16.0;
        viewbox-width: 74;
        viewbox-height: 74;
        fill: Theme.brand-mark-wing-inner-shadow;
        stroke: transparent;
        commands: "M 43.2 43.19 L 43.2 61.5 L 45.4 60.02 L 45.4 41.72 Z";
    }

    // Top-blade shadow clipped to lower wing
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 13.5;
        viewbox-y: 16.0;
        viewbox-width: 74;
        viewbox-height: 74;
        fill: Theme.brand-mark-wing-shadow;
        stroke: transparent;
        commands: "M 51.59 37.56 L 48.32 39.76 L 69.73 43.70 L 73 41.5 Z";
    }

    // Extended vertical P-stem
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 13.5;
        viewbox-y: 16.0;
        viewbox-width: 74;
        viewbox-height: 74;
        fill: Theme.brand-mark-stem;
        stroke: transparent;
        commands: "M 28 16.5 L 28 89.5 L 43.2 79.3 L 43.2 27.14 Z";
    }

    // Top-blade shadow clipped to P-stem
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 13.5;
        viewbox-y: 16.0;
        viewbox-width: 74;
        viewbox-height: 74;
        fill: Theme.brand-mark-stem-shadow;
        stroke: transparent;
        commands: "M 28 33.22 L 28 36.02 L 43.2 38.82 L 43.2 36.02 Z";
    }

    // Top blade
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 13.5;
        viewbox-y: 16.0;
        viewbox-width: 74;
        viewbox-height: 74;
        fill: Theme.brand-mark-blade;
        stroke: transparent;
        commands: "M 28 16.5 L 28 33.22 L 73 41.5 L 50 16.5 Z";
    }
}


// The new-session mark: a ring left open at its top right, with the pen that
// opened it still crossing the gap. Both shapes are stroked outlines, so they
// share one Path: the viewbox is the 24 the mark was drawn on, and the pen is
// that drawing's rounded rect carried through its own -45 degree turn.
export component IconNewChat inherits Path {
    in property <color> tint: Theme.sidebar-new-session-mark;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    // the mark's own 2.1 on a 24 viewbox, at the size it is drawn here
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 10.5 5 C 6 5 4 7.2 4 12.5 C 4 17.8 6.2 20 11.8 20 C 17.4 20 19.5 17.8 19.5 13 "
        + "M 9.36 10.93 L 15.73 4.56 A 1.8 1.8 0 0 1 18.27 4.56 L 18.84 5.13 "
        + "A 1.8 1.8 0 0 1 18.84 7.67 L 12.47 14.04 A 1.8 1.8 0 0 1 9.93 14.04 "
        + "L 9.36 13.47 A 1.8 1.8 0 0 1 9.36 10.93 Z";
}

// The magnifier: a lens that fills most of its box and a handle cut short, so
// the pair still reads at 16px. Its tint stays the quiet one the column draws it
// in: the mark is drawn and inert until search exists, and a control that cannot
// be clicked should not look like one.
export component IconSearch inherits Path {
    in property <color> tint: Theme.sidebar-search-mark;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    // the mark's own 2.3 on a 24 viewbox, at the size it is drawn here
    stroke-width: 1.5px;
    stroke-line-cap: butt;
    // the circle is four quarter arcs: no half-turn flag to get wrong
    commands: "M 11 3.5 A 7.5 7.5 0 0 1 18.5 11 A 7.5 7.5 0 0 1 11 18.5 "
        + "A 7.5 7.5 0 0 1 3.5 11 A 7.5 7.5 0 0 1 11 3.5 Z "
        + "M 16.3 16.3 L 20.2 20.2";
}

// The pencil that names a session's rename, offered by its row.
export component IconPencil inherits Path {
    in property <color> tint: Theme.sidebar-row-rename-mark;
    width: 11px;
    height: 11px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 2 8.2 L 2 10 L 3.8 10 L 10 3.8 L 8.2 2 Z";
    stroke: tint;
    stroke-width: 1.1px;
    fill: transparent;
}

// A solid pencil: the edit action on a waiting row.
export component IconEdit inherits Path {
    in property <color> tint: Theme.queue-row-control-mark;
    width: 13px;
    height: 13px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a.996.996 0 0 0 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z";
    fill: tint;
    stroke: transparent;
}

// A bin with its lid left on: delete, without the promise of permanence.
export component IconTrash inherits Path {
    in property <color> tint: Theme.queue-row-control-mark;
    width: 13px;
    height: 13px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM8 9h8v10H8V9zm7.5-5-1-1h-5l-1 1H5v2h14V4z";
    fill: tint;
    stroke: transparent;
}

// transcript

// The caret that says a row opens and closes, in a thinking row's header and in
// a cell's. The model menu and the composer's chip draw the same shape, and both
// tint it from their own part.
export component IconCaret inherits Path {
    in property <bool> up;
    in property <color> tint: Theme.transcript-caret-mark;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: up ? "M 2 6.5 L 5 3.5 L 8 6.5" : "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: tint;
    stroke-width: 1.3px;
    fill: transparent;
}

// The arrow that pulls a waiting follow-up message into the turn already running.
export component IconToTop inherits Path {
    in property <color> tint: Theme.queue-row-promote-mark;
    width: 16px;
    height: 16px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: "M 3.2 2.9 L 10.8 2.9 M 7 11.6 L 7 5.3 M 4.4 7.9 L 7 5.3 L 9.6 7.9";
    stroke: tint;
    stroke-width: 1.3px;
    fill: transparent;
}

// The alert inside the badge a failed cell carries.
export component IconAlert inherits Path {
    in property <color> tint: Theme.transcript-cell-badge-mark;
    width: 16px;
    height: 16px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: "M 7 3.5 L 7 8.0 M 7 9.5 L 7 10.5";
    stroke: tint;
    stroke-width: 2px;
    fill: transparent;
}

// composer

export component IconSend inherits Path {
    in property <color> tint: Theme.composer-send-mark;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 6 10.5 L 6 2 M 2.2 5.8 L 6 2 L 9.8 5.8";
    stroke: tint;
    stroke-width: 1.6px;
    fill: transparent;
}

// The attach control: two 8px arms, centred on its box, with rounded ends.
export component IconPlus inherits Path {
    in property <color> tint: Theme.composer-attach-ink;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 6 2 L 6 10 M 2 6 L 10 6";
    stroke: tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: transparent;
}

// menus

// The "this is the one running" tick, beside the current model or level. The
// ladder is a panel of its own and tints it from its own role.
export component IconCheck inherits Path {
    in property <color> tint: Theme.model-menu-check-mark;
    width: 11px;
    height: 11px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 1 6.4 L 4.4 9.8 L 11 2.2";
    stroke: tint;
    stroke-width: 1.5px;
    fill: transparent;
}

// The chevron on the chip that walks the reader back to the newest row.
export component IconChevronDown inherits Path {
    in property <color> tint: Theme.transcript-jump-mark;
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 2 3.5 L 5 6.5 L 8 3.5";
    stroke: tint;
    stroke-width: 1.6px;
    fill: transparent;
}
