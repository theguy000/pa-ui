import { Button, ButtonKind, Panel } from "primitives.slint";
import { IconWarning } from "icons.slint";
import { Theme } from "theme.slint";

component QuitAction inherits Button {
    in property <string> label;
    in property <color> label-color;
    in property <bool> focused: false;

    height: 32px;
    border-radius: 8px;
    border-width: root.focused ? 1px : 0px;
    border-color: Theme.sidebar-new-session-ink;
    described: root.label;

    Text {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.label-color;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component QuitConfirmPopup inherits Panel {
    in property <int> focus-tick: 0;
    private property <bool> focus-quit: false;

    callback cancelled();
    callback confirmed();

    width: 420px;
    height: 184px;
    border-radius: 20px;
    border-width: 0px;

    changed focus-tick => {
        root.focus-quit = false;
        keys.focus();
    }

    IconWarning {
        x: 20px;
        y: 20px;
    }

    Text {
        x: 44px;
        y: 15px;
        width: parent.width - 66px;
        height: 28px;
        text: "A Session is still running";
        color: Theme.search-row-ink-hover;
        font-size: 16px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    Rectangle {
        x: 0;
        y: 54px;
        width: 100%;
        height: 1px;
        background: Theme.panel-edge;
    }

    Text {
        x: 22px;
        y: 70px;
        width: parent.width - 44px;
        height: 44px;
        text: "A Session still has a running turn. Quitting closes the window without stopping it.";
        color: Theme.search-row-ink;
        font-size: 12px;
        wrap: word-wrap;
        overflow: elide;
    }

    QuitAction {
        x: parent.width - 22px - 72px - 8px - 84px;
        y: parent.height - 54px;
        width: 84px;
        kind: ButtonKind.primary;
        label: "Cancel";
        label-color: Theme.sidebar-new-session-ink;
        focused: keys.has-focus && !root.focus-quit;
        clicked => { root.cancelled(); }
    }

    QuitAction {
        x: parent.width - 22px - 72px;
        y: parent.height - 54px;
        width: 72px;
        kind: ButtonKind.danger;
        label: "Quit";
        label-color: Theme.composer-stop-mark;
        focused: keys.has-focus && root.focus-quit;
        clicked => { root.confirmed(); }
    }

    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        init => {
            root.focus-quit = false;
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return EventResult.accept;
            }
            if event.text == Key.Tab {
                root.focus-quit = !root.focus-quit;
                return EventResult.accept;
            }
            if event.text == Key.Return {
                if root.focus-quit {
                    root.confirmed();
                } else {
                    root.cancelled();
                }
                return EventResult.accept;
            }
            reject
        }
    }
}
