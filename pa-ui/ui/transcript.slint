// The transcript's rows: a tool cell, and the pane of prose, code and output a
// message opens into. Both are driven by TRow and carry no state of their own.

import { ScrollView } from "std-widgets.slint";
import { Appearance, TRow, Type } from "types.slint";
import { IconChevronRight, IconEdit, IconThinking, IconToTop, IconToolBash, IconToolPython, IconTrash, IconWarning } from "icons.slint";
import { Theme } from "theme.slint";
import { Button } from "primitives.slint";

// One waiting message in the steering lane: already inside this turn, so the
// only action is delete. Two row components instead of one with a conditional
// button: a button made conditional does not take clicks here, even though it
// paints.
export component QueueRow inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    in property <image> thumb;
    callback act(string, int, string);

    // Two lines, fixed height: the panel stacks rows by arithmetic, so a row
    // that grew with its text would overlap the next one. Wrapped and elided,
    // a long message shows its beginning and where it was cut.
    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? Theme.panel-row-fill-hover : transparent;

    // the text is the edit affordance; it stops short of the button
    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 64px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    if root.thumb.width > 0 : Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.thumb;
            image-fit: cover;
        }
    }

    Text {
        x: root.thumb.width > 0 ? 34px : 6px;
        y: 0;
        width: parent.width - (root.thumb.width > 0 ? 100px : 72px);
        height: 100%;
        text: root.text;
        color: Theme.queue-row-ink;
        font-size: 11px;
        // centred: a one-line message sat against the top of a 34px row
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    // editing is a button, not a lucky click on the text: a row whose only way
    // to change is an invisible target looks uneditable
    edit := Button {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        fill: Theme.queue-row-control-fill;
        fill-hover: Theme.queue-row-control-fill-hover;
        described: "Edit this message";
        clicked => { root.act(root.lane, root.slot, "edit"); }
        IconEdit {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: edit.hot ? Theme.queue-row-control-mark-hover
                : Theme.queue-row-control-mark;
        }
    }

    // a resting surface, not a hover-only one: an action that looks like empty
    // space until the pointer finds it is a hidden control
    del := Button {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        // colour alone, no outline: the fill sits a clear step above both the
        // panel and the row's hover, which is what keeps the button a button
        fill: Theme.queue-row-control-fill;
        fill-hover: Theme.queue-row-control-fill-hover;
        described: "Delete this message";
        clicked => { root.act(root.lane, root.slot, "delete"); }
        IconTrash {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: del.hot ? Theme.queue-row-delete-mark
                : Theme.queue-row-control-mark;
        }
    }
}

// A follow-up row: the same row plus the up arrow that pulls the message into
// the turn that is already running.
export component QueueRowUp inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    in property <image> thumb;
    callback act(string, int, string);

    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? Theme.panel-row-fill-hover : transparent;

    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 92px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    if root.thumb.width > 0 : Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.thumb;
            image-fit: cover;
        }
    }

    Text {
        x: root.thumb.width > 0 ? 34px : 6px;
        y: 0;
        width: parent.width - (root.thumb.width > 0 ? 128px : 100px);
        height: 100%;
        text: root.text;
        color: Theme.queue-row-ink;
        font-size: 11px;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    edit := Button {
        x: parent.width - 84px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        fill: Theme.queue-row-control-fill;
        fill-hover: Theme.queue-row-control-fill-hover;
        described: "Edit this message";
        clicked => { root.act(root.lane, root.slot, "edit"); }
        IconEdit {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: edit.hot ? Theme.queue-row-control-mark-hover
                : Theme.queue-row-control-mark;
        }
    }

    up := Button {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        fill: Theme.queue-row-control-fill;
        fill-hover: Theme.queue-row-control-fill-hover;
        described: "Run this message next";
        clicked => { root.act(root.lane, root.slot, "promote"); }
        IconToTop {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: up.hot ? Theme.queue-row-promote-mark-hover
                : Theme.queue-row-promote-mark;
        }
    }

    del := Button {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        // colour alone, no outline: the fill sits a clear step above both the
        // panel and the row's hover, which is what keeps the button a button
        fill: Theme.queue-row-control-fill;
        fill-hover: Theme.queue-row-control-fill-hover;
        described: "Delete this message";
        clicked => { root.act(root.lane, root.slot, "delete"); }
        IconTrash {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: del.hot ? Theme.queue-row-delete-mark
                : Theme.queue-row-control-mark;
        }
    }
}

export component TranscriptRow inherits VerticalLayout {
    function open-link(link: string) {
        if link.starts-with("https://") || link.starts-with("http://") {
            Platform.open-url(link);
        }
    }

    spacing: 0px;

    in property <TRow> data;
    in property <int> working-elapsed-ms: 0;
    property <bool> is-summary: data.kind == 10;
    callback toggle();
    callback copy() -> bool;

    if data.kind == 0 : HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.row-pad-y;
        padding-bottom: Appearance.row-pad-y;
        if Appearance.show-timestamps && data.timestamp != "" : Text {
            text: data.timestamp;
            color: Theme.transcript-cell-meta-ink;
            font-size: Appearance.meta-size;
            vertical-alignment: center;
        }
        Rectangle {
            background: Theme.transcript-message-fill;
            border-radius: 10px;
            width: min(self.preferred-width, 560px);
            height: self.preferred-height;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                StyledText {
                    text: data.body;
                    default-color: Theme.transcript-message-ink;
                    default-font-size: Type.body;
                    link-color: Theme.transcript-link-ink;
                    link-clicked(link) => { root.open-link(link); }
                }
            }
        }
    }

    if data.kind == 1 : VerticalLayout {
        width: root.width;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.row-pad-y;
        padding-bottom: Appearance.row-pad-y;
        spacing: 2px;
        if Appearance.show-timestamps && data.timestamp != "" : Text {
            text: data.timestamp;
            color: Theme.transcript-cell-meta-ink;
            font-size: Appearance.meta-size;
        }
        agent-text := StyledText {
            width: root.width - 48px;
            text: data.body;
            default-color: Theme.transcript-prose-ink;
            default-font-size: Type.body;
            link-color: Theme.transcript-link-ink;
            link-clicked(link) => { root.open-link(link); }
        }
    }

    if data.kind == 11 : VerticalLayout {
        width: root.width;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.row-pad-y;
        padding-bottom: Appearance.row-pad-y;
        spacing: 2px;
        if Appearance.show-timestamps && data.timestamp != "" : Text {
            text: data.timestamp;
            color: Theme.transcript-cell-meta-ink;
            font-size: Appearance.meta-size;
        }
        Rectangle {
            width: root.width - 48px;
            height: quote-text.preferred-height;
            quote-bar := Rectangle {
                x: 0px;
                y: 0px;
                width: 2px;
                height: parent.height;
                border-radius: 1px;
                background: Theme.transcript-quote-edge;
            }
            quote-text := StyledText {
                x: 12px;
                y: 0px;
                width: root.width - 60px;
                text: data.body;
                default-color: Theme.transcript-quote-ink;
                default-font-size: Type.body;
                link-color: Theme.transcript-link-ink;
                link-clicked(link) => { root.open-link(link); }
            }
        }
    }

    if data.kind == 2 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.cell-pad-y;
        padding-bottom: Appearance.cell-pad-y;
        spacing: Appearance.cell-gap;

        Rectangle {
            width: self.preferred-width;
            height: 24px;
            border-radius: 6px;
            background: think-touch.has-hover ? Theme.transcript-thinking-fill-hover
                : Theme.transcript-thinking-fill;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 8px;
                spacing: 8px;
                Rectangle {
                    width: 14px;
                    height: 24px;
                    IconThinking {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        running: data.running;
                        phase-ms: root.working-elapsed-ms;
                        tint: data.running ? Theme.transcript-working-ink : Theme.transcript-thinking-label-ink;
                    }
                }
                Text {
                    text: data.running ? "Thinking\u{2026}" : (data.title != "" ? data.title : "Thinking");
                    color: data.running ? Theme.transcript-thinking-label-ink-working : Theme.transcript-thinking-label-ink;
                    font-size: Appearance.label-size;
                    vertical-alignment: center;
                }
                if Appearance.show-timestamps && data.timestamp != "" : Text {
                    text: data.timestamp;
                    color: Theme.transcript-cell-meta-ink;
                    font-size: Appearance.meta-size;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 12px;
                    height: 24px;
                    IconChevronRight {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        open: data.expanded;
                        tint: Theme.transcript-caret-mark;
                    }
                }
            }
            think-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
            }
        }

        if data.expanded : Rectangle {
            width: root.width - 48px;
            background: Theme.transcript-row-fill-expanded;
            border-color: Theme.transcript-thinking-edge-expanded;
            border-width: 1px;
            border-radius: 8px;
            height: min(
                think-text.preferred-height + (Appearance.expanded-pad-y + 2px) * 2,
                6 * think-probe.preferred-height + (Appearance.expanded-pad-y + 2px) * 2
            );
            think-probe := Text {
                x: -200px;
                y: 0px;
                text: "x";
                font-family: Appearance.code-font;
                font-size: Appearance.cell-output-size;
                opacity: 0;
            }
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding-left: Appearance.expanded-pad-x;
                    padding-right: Appearance.expanded-pad-x;
                    padding-top: Appearance.expanded-pad-y + 2px;
                    padding-bottom: Appearance.expanded-pad-y + 2px;
                    think-text := StyledText {
                        width: root.width - 48px - Appearance.expanded-pad-x * 2;
                        text: data.body;
                        default-color: Theme.transcript-thinking-ink;
                        default-font-family: Appearance.code-font;
                        default-font-size: Appearance.cell-output-size;
                    }
                }
            }
        }
    }

    if data.kind == 3 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.cell-pad-y;
        padding-bottom: Appearance.cell-pad-y;
        spacing: 0px;

        Rectangle {
            width: root.width - 48px;
            background: data.running ? Theme.transcript-cell-fill-working : Theme.transcript-cell-fill;
            border-color: data.running ? Theme.transcript-cell-edge-working : Theme.transcript-cell-edge;
            border-width: 1px;
            border-radius: 8px;
            clip: true;

            animate background, border-color {
                duration: Appearance.reduce-motion ? 0ms : 140ms;
                easing: ease;
            }

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 30px;
                    background: cell-touch.has-hover
                        ? (data.running ? Theme.transcript-cell-fill-working-hover : Theme.transcript-cell-fill-hover)
                        : transparent;

                    cell-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.toggle(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        Rectangle {
                            width: 14px;
                            height: 30px;
                            if data.verb.starts-with("bash") : IconToolBash {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                running: data.running;
                                phase-ms: root.working-elapsed-ms;
                                tint: data.running ? Theme.transcript-working-ink
                                    : (data.failed ? Theme.transcript-cell-ink-failed : Theme.transcript-cell-verb-ink);
                            }
                            if !data.verb.starts-with("bash") : IconToolPython {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                running: data.running;
                                phase-ms: root.working-elapsed-ms;
                                tint: data.running ? Theme.transcript-working-ink
                                    : (data.failed ? Theme.transcript-cell-ink-failed : Theme.transcript-cell-verb-ink);
                            }
                        }

                        if data.verb != "" : Text {
                            text: data.verb;
                            color: data.running ? Theme.transcript-cell-verb-ink-working
                                : (data.failed ? Theme.transcript-cell-ink-failed : Theme.transcript-cell-verb-ink);
                            font-size: Appearance.label-size;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        Text {
                            text: data.title;
                            color: data.running ? Theme.transcript-cell-title-ink-working
                                : (data.failed ? Theme.transcript-cell-ink-failed : Theme.transcript-cell-title-ink);
                            font-family: Appearance.code-font;
                            font-size: Appearance.label-size;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if data.running : Text {
                            text: "running";
                            color: Theme.transcript-cell-meta-ink-working;
                            font-size: Appearance.meta-size;
                            vertical-alignment: center;
                        }

                        if !data.running && data.failed : Text {
                            text: "failed";
                            color: Theme.transcript-cell-ink-failed;
                            font-size: Appearance.meta-size;
                            vertical-alignment: center;
                        }

                        if !data.running && data.elapsed != "" : Text {
                            text: data.elapsed;
                            color: Theme.transcript-cell-meta-ink;
                            font-size: Appearance.meta-size;
                            vertical-alignment: center;
                        }

                        if Appearance.show-timestamps && data.timestamp != "" : Text {
                            text: data.timestamp;
                            color: Theme.transcript-cell-meta-ink;
                            font-size: Appearance.meta-size;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 12px;
                            height: 30px;
                            IconChevronRight {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                open: data.expanded;
                                tint: Theme.transcript-caret-mark;
                            }
                        }
                    }
                }

                if data.expanded : well := Rectangle {
                    property <bool> copied: false;

                    background: Theme.transcript-row-fill-expanded;
                    height: self.preferred-height;

                    copy-timer := Timer {
                        interval: 900ms;
                        running: well.copied;
                        triggered => { well.copied = false; }
                    }

                    well-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                    }

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 1px;
                            background: Theme.transcript-cell-rule;
                        }

                        VerticalLayout {
                            padding-left: 32px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 9px;
                            spacing: 7px;

                            if data.has-code : StyledText {
                                width: max(0px, root.width - 48px - 96px);
                                text: data.code;
                                default-color: Theme.transcript-cell-code-ink;
                                default-font-family: Appearance.code-font;
                                default-font-size: Appearance.cell-code-size;
                            }
                            if data.has-code && data.has-output : Rectangle {
                                height: 1px;
                                background: Theme.transcript-cell-rule;
                            }
                            if data.has-output : StyledText {
                                width: max(0px, root.width - 48px - 44px);
                                text: data.output;
                                default-color: data.failed ? Theme.transcript-cell-ink-failed
                                    : Theme.transcript-cell-output-ink;
                                default-font-family: Appearance.code-font;
                                default-font-size: Appearance.cell-output-size;
                            }
                        }
                    }

                    if data.has-code : copy-btn := Button {
                        property <bool> revealed: cell-touch.has-hover || well-touch.has-hover || self.on || well.copied;

                        x: parent.width - 10px - self.width;
                        y: 7px;
                        width: 56px;
                        height: 20px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: revealed
                            ? (self.on ? Theme.transcript-cell-copy-edge-hover : Theme.transcript-cell-copy-edge)
                            : transparent;
                        fill: revealed ? Theme.transcript-cell-copy-fill : transparent;
                        fill-hover: Theme.transcript-cell-copy-fill-hover;
                        fade: Appearance.reduce-motion ? 0ms : 100ms;
                        described: well.copied ? "Copied" : "Copy cell code";
                        clicked => {
                            if root.copy() {
                                well.copied = true;
                                copy-timer.restart();
                            }
                        }

                        Text {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: well.copied ? "Copied" : "Copy";
                            color: revealed
                                ? (copy-btn.on ? Theme.transcript-cell-copy-ink-hover : Theme.transcript-cell-copy-ink)
                                : transparent;
                            font-size: Appearance.meta-size;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: Appearance.reduce-motion ? 0ms : 100ms; }
                        }
                    }
                }
            }
        }
    }

    if data.kind == 5 || is-summary : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.cell-pad-y;
        padding-bottom: Appearance.cell-pad-y;
        spacing: 0px;

        Rectangle {
            width: root.width - 48px;
            background: Theme.transcript-cell-fill;
            border-color: Theme.transcript-cell-edge;
            border-width: 1px;
            border-radius: 8px;
            clip: true;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 30px;
                    background: (data.has-body && custom-touch.has-hover)
                        ? Theme.transcript-cell-fill-hover
                        : transparent;

                    custom-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        enabled: data.has-body;
                        mouse-cursor: data.has-body ? MouseCursor.pointer : MouseCursor.default;
                        clicked => {
                            if data.has-body {
                                root.toggle();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        if data.custom-kind == "bash-done" : Rectangle {
                            width: 14px;
                            height: 30px;
                            Path {
                                width: 13px;
                                height: 13px;
                                x: 0.5px;
                                y: (parent.height - self.height) / 2 + 0.5px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: data.failed ? Theme.transcript-cell-ink-failed : Theme.transcript-cell-meta-ink;
                                stroke-width: 2px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                                commands: "M4 17l6-6-6-6 M12 19h8";
                            }
                        }

                        if data.custom-kind == "agent-message" : Rectangle {
                            width: 14px;
                            height: 30px;
                            Path {
                                width: 13px;
                                height: 13px;
                                x: 0.5px;
                                y: (parent.height - self.height) / 2 + 0.5px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: Theme.transcript-heading-ink;
                                stroke-width: 2px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                                commands: "M12 8V4H8 M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z M2 14h2 M20 14h2 M15 13v2 M9 13v2";
                            }
                        }

                        if data.custom-kind == "provider-retry" : Rectangle {
                            width: 14px;
                            height: 30px;
                            property <bool> retrying: data.badge-secondary == "waiting" && !data.failed;
                            property <float> phase: retrying ? Math.mod(animation-tick() / 1ms, 2400) / 2400.0 : 0.0;
                            property <angle> flip: retrying && phase >= 0.7 ? ((phase - 0.7) / 0.3) * 180deg : 0deg;
                            Path {
                                width: 13px;
                                height: 13px;
                                x: 0.5px;
                                y: (parent.height - self.height) / 2 + 0.5px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: retrying ? Theme.transcript-working-ink : Theme.transcript-cell-meta-ink;
                                stroke-width: 2px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                                transform-rotation: flip;
                                commands: "M5 22h14 M5 2h14 M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22 M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2";
                            }
                            if retrying && phase < 0.7 : Rectangle {
                                x: 6.5px;
                                y: 14px + Math.mod(animation-tick() / 1ms, 900) / 900.0 * 5px;
                                width: 1.5px;
                                height: 2px;
                                border-radius: 1px;
                                background: Theme.transcript-working-ink;
                            }
                        }

                        if data.custom-kind == "harness" || is-summary : Rectangle {
                            width: 14px;
                            height: 30px;
                            Path {
                                width: 13px;
                                height: 13px;
                                x: 0.5px;
                                y: (parent.height - self.height) / 2 + 0.5px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: Theme.transcript-cell-meta-ink;
                                stroke-width: 2px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                                commands: "M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z";
                            }
                        }

                        Text {
                            text: data.title;
                            color: data.failed ? Theme.transcript-cell-ink-failed
                                : Theme.transcript-heading-ink;
                            font-size: Appearance.label-size;
                            font-weight: is-summary ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if data.meta != "" : Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: data.custom-kind == "provider-retry"
                                ? Theme.transcript-cell-edge-working
                                : Theme.transcript-cell-edge;

                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;

                                Text {
                                    text: data.meta;
                                    color: data.failed
                                        ? Theme.transcript-cell-ink-failed
                                        : data.custom-kind == "provider-retry"
                                            ? Theme.transcript-cell-edge-working
                                            : Theme.transcript-cell-meta-ink;
                                    font-size: Appearance.meta-size;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if data.badge-secondary != "" : Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: Theme.transcript-cell-edge;

                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;

                                Text {
                                    text: data.badge-secondary;
                                    color: Theme.transcript-cell-meta-ink;
                                    font-size: Appearance.meta-size;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if data.has-body : Rectangle {
                            width: 14px;
                            height: 30px;
                            IconChevronRight {
                                x: 1px;
                                y: (parent.height - self.height) / 2;
                                open: data.expanded;
                                tint: Theme.transcript-caret-mark;
                            }
                        }
                    }
                }

                if data.expanded && data.has-body : Rectangle {
                    background: Theme.transcript-row-fill-expanded;
                    height: self.preferred-height;

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 1px;
                            background: Theme.transcript-cell-rule;
                        }

                        VerticalLayout {
                            padding-left: 32px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 9px;

                            custom-text := StyledText {
                                width: max(0px, root.width - 48px - 44px);
                                text: data.body;
                                default-color: data.failed ? Theme.transcript-cell-ink-failed
                                    : Theme.transcript-prose-ink;
                                default-font-size: Type.item;
                                link-color: Theme.transcript-link-ink;
                                link-clicked(link) => { root.open-link(link); }
                            }
                        }
                    }
                }
            }
        }
    }

    if data.kind == 9 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.cell-pad-y;
        padding-bottom: Appearance.cell-pad-y;

        Rectangle {
            width: root.width - 48px;
            background: Theme.transcript-error-fill;
            border-color: Theme.transcript-error-edge;
            border-width: 1px;
            border-radius: 8px;
            height: self.preferred-height;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;

                Rectangle {
                    width: 16px;
                    height: 20px;
                    IconWarning {
                        x: 0px;
                        y: 2px;
                        width: 16px;
                        height: 16px;
                    }
                }

                error-label := Text {
                    text: data.title;
                    color: Theme.transcript-error-ink;
                    font-size: Type.body;
                    font-weight: 600;
                    vertical-alignment: top;
                }

                error-line := StyledText {
                    width: max(0px, root.width - 102px - error-label.preferred-width);
                    text: data.body;
                    default-color: Theme.transcript-error-ink;
                    default-font-size: Type.body;
                    link-color: Theme.transcript-link-ink;
                    link-clicked(link) => { root.open-link(link); }
                }
            }
        }
    }

    // A fenced block: a card with a quiet header and the code below it.
    if data.kind == 6 : VerticalLayout {
        width: root.width;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.code-pad-y;
        padding-bottom: Appearance.code-pad-y;

        code-card := Rectangle {
            property <bool> copied: false;

            width: root.width - 48px;
            height: self.preferred-height;
            background: Theme.transcript-code-fill;
            border-color: Theme.transcript-cell-edge;
            border-width: 1px;
            border-radius: 8px;
            clip: true;

            code-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
            }

            code-copy-timer := Timer {
                interval: 900ms;
                running: code-card.copied;
                triggered => { code-card.copied = false; }
            }

            VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    height: 28px;
                    padding-left: 12px;
                    padding-right: 74px;
                    spacing: 8px;

                    if data.meta != "" : Text {
                        text: data.meta;
                        color: Theme.transcript-code-label-ink;
                        font-size: Appearance.meta-size;
                        vertical-alignment: center;
                    }

                    if Appearance.show-timestamps && data.timestamp != "" : Text {
                        text: data.timestamp;
                        color: Theme.transcript-cell-meta-ink;
                        font-size: Appearance.meta-size;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: Appearance.code-pad-y;
                    padding-bottom: Appearance.code-pad-y;

                    code-text := StyledText {
                        width: root.width - 72px;
                        text: data.code;
                        default-color: Theme.transcript-code-ink;
                        default-font-size: Appearance.code-size;
                        default-font-family: Appearance.code-font;
                    }
                }
            }

            code-copy-btn := Button {
                property <bool> revealed: code-touch.has-hover || self.on || code-card.copied;

                x: parent.width - 10px - self.width;
                y: 4px;
                width: 56px;
                height: 20px;
                border-radius: 5px;
                border-width: 1px;
                border-color: revealed
                    ? (self.on ? Theme.transcript-cell-copy-edge-hover : Theme.transcript-cell-copy-edge)
                    : transparent;
                fill: revealed ? Theme.transcript-cell-copy-fill : transparent;
                fill-hover: Theme.transcript-cell-copy-fill-hover;
                fade: Appearance.reduce-motion ? 0ms : 100ms;
                described: code-card.copied ? "Copied" : "Copy code";
                clicked => {
                    if root.copy() {
                        code-card.copied = true;
                        code-copy-timer.restart();
                    }
                }

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: code-card.copied ? "Copied" : "Copy";
                    color: revealed
                        ? (code-copy-btn.on ? Theme.transcript-cell-copy-ink-hover : Theme.transcript-cell-copy-ink)
                        : transparent;
                    font-size: Appearance.meta-size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: Appearance.reduce-motion ? 0ms : 100ms; }
                }
            }
        }
    }

    // A table: proportional columns on the Sheet, no box and no vertical rules.
    if data.kind == 7 : VerticalLayout {
        width: root.width;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.code-pad-y;
        padding-bottom: Appearance.code-pad-y;

        table-card := Rectangle {
            property <bool> copied: false;
            // every body row starts one row past the header in the flat cell list
            property <int> columns: data.table-widths.length;

            width: root.width - 48px;
            height: data.table-height;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.transcript-cell-edge;
            clip: true;

            table-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
            }

            table-copy-timer := Timer {
                interval: 900ms;
                running: table-card.copied;
                triggered => { table-card.copied = false; }
            }

            // Columns carry their own width, so a table wider than the Sheet
            // scrolls sideways instead of clipping its last columns.
            table-scroll := Flickable {
                width: parent.width;
                height: data.table-height;
                viewport-width: table-content.preferred-width;
                viewport-height: data.table-height;
                interactive: true;

                table-content := VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        background: Theme.transcript-code-fill;

                        HorizontalLayout {
                            spacing: 0px;

                            for column in data.table-column-indices : HorizontalLayout {
                                spacing: 0px;

                                if column > 0 : Rectangle {
                                    width: 1px;
                                    background: Theme.transcript-cell-rule;
                                }

                                Rectangle {
                                    width: data.table-widths[column];

                                    HorizontalLayout {
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        padding-left: 12px;
                                        padding-right: 12px;

                                StyledText {
                                    horizontal-stretch: 1.0;
                                    text: data.table[column].text;
                                    default-color: Theme.transcript-prose-ink;
                                    default-font-size: Type.body;
                                    horizontal-alignment: data.table[column].align == 1 ? right
                                        : data.table[column].align == 2 ? center : left;
                                    link-color: Theme.transcript-link-ink;
                                        link-clicked(link) => { root.open-link(link); }
                                    }
                                }
                            }
                        }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.transcript-cell-edge;
                    }

                    for row in data.table-row-indices : VerticalLayout {
                        spacing: 0px;

                        HorizontalLayout {
                            spacing: 0px;

                            for column in data.table-column-indices : HorizontalLayout {
                                spacing: 0px;

                                if column > 0 : Rectangle {
                                    width: 1px;
                                    background: Theme.transcript-cell-rule;
                                }

                                Rectangle {
                                    width: data.table-widths[column];

                                    HorizontalLayout {
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        padding-left: 12px;
                                        padding-right: 12px;

                                    StyledText {
                                        horizontal-stretch: 1.0;
                                        text: data.table[(row + 1) * table-card.columns + column].text;
                                        default-color: Theme.transcript-prose-ink;
                                        default-font-size: Type.body;
                                        horizontal-alignment: data.table[(row + 1) * table-card.columns + column].align == 1 ? right
                                            : data.table[(row + 1) * table-card.columns + column].align == 2 ? center : left;
                                        link-color: Theme.transcript-link-ink;
                                        link-clicked(link) => { root.open-link(link); }
                                    }
                                }
                            }
                        }
                        }

                        if row < data.table-row-indices.length - 1 : Rectangle {
                            height: 1px;
                            background: Theme.transcript-cell-rule;
                        }
                    }
                }
            }

            table-copy-btn := Button {
                property <bool> revealed: table-touch.has-hover || self.on || table-card.copied;

                x: parent.width - 10px - self.width;
                y: 4px;
                width: 56px;
                height: 20px;
                border-radius: 5px;
                border-width: 1px;
                border-color: revealed
                    ? (self.on ? Theme.transcript-cell-copy-edge-hover : Theme.transcript-cell-copy-edge)
                    : transparent;
                fill: revealed ? Theme.transcript-cell-copy-fill : transparent;
                fill-hover: Theme.transcript-cell-copy-fill-hover;
                fade: Appearance.reduce-motion ? 0ms : 100ms;
                described: table-card.copied ? "Copied" : "Copy table";
                clicked => {
                    if root.copy() {
                        table-card.copied = true;
                        table-copy-timer.restart();
                    }
                }

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: table-card.copied ? "Copied" : "Copy";
                    color: revealed
                        ? (table-copy-btn.on ? Theme.transcript-cell-copy-ink-hover : Theme.transcript-cell-copy-ink)
                        : transparent;
                    font-size: Appearance.meta-size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: Appearance.reduce-motion ? 0ms : 100ms; }
                }
            }
        }

        if table-scroll.viewport-width > table-scroll.width : Rectangle {
            width: root.width - 48px;
            height: 8px;
            background: transparent;

            Rectangle {
                property <length> track-w: parent.width;
                property <length> thumb-w: max(32px, track-w * (table-scroll.width / table-scroll.viewport-width));
                property <length> max-scroll: max(1px, table-scroll.viewport-width - table-scroll.width);

                x: (track-w - thumb-w) * clamp(-table-scroll.viewport-x / max-scroll, 0, 1);
                y: 2px;
                width: thumb-w;
                height: 4px;
                border-radius: 2px;
                background: thumb-touch.has-hover || thumb-touch.pressed
                    ? Theme.transcript-cell-copy-ink-hover
                    : Theme.transcript-quote-edge;

                thumb-touch := TouchArea {
                    property <length> drag-start-x;
                    property <length> drag-start-vx;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            drag-start-x = self.mouse-x;
                            drag-start-vx = table-scroll.viewport-x;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            let ratio = (table-scroll.viewport-width - table-scroll.width) / max(1px, parent.width - parent.width * (table-scroll.width / table-scroll.viewport-width));
                            table-scroll.viewport-x = clamp(drag-start-vx - (self.mouse-x - drag-start-x) * ratio, -(table-scroll.viewport-width - table-scroll.width), 0px);
                        }
                    }
                }
            }
        }
    }

    // an image the user sent: the picture itself, thumbnailed, on the same edge
    // as the bubble so the sent turn reads as one thing
    if data.kind == 8 : HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: Appearance.cell-pad-y;
        padding-bottom: Appearance.cell-pad-y;
        if Appearance.show-timestamps && data.timestamp != "" : Text {
            text: data.timestamp;
            color: Theme.transcript-cell-meta-ink;
            font-size: Appearance.meta-size;
            vertical-alignment: center;
        }
        Rectangle {
            width: 220px;
            height: 150px;
            background: Theme.transcript-image-fill;
            border-radius: 10px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: data.image;
                image-fit: contain;
            }
        }
    }
}
