// The transcript's rows: a tool cell, and the pane of prose, code and output a
// message opens into. Both are driven by TRow and carry no state of their own.

import { ScrollView } from "std-widgets.slint";
import { TRow, Type } from "types.slint";
import { MarqueeText } from "marquee-text.slint";
import { IconAlert, IconCaret, IconEdit, IconToTop, IconTrash } from "icons.slint";
import { Theme } from "theme.slint";

// One waiting message in the steering lane: already inside this turn, so the
// only action is delete. Two row components instead of one with a conditional
// button: a button made conditional does not take clicks here, even though it
// paints.
export component QueueRow inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    in property <image> thumb;
    callback act(string, int, string);

    // Two lines, fixed height: the panel stacks rows by arithmetic, so a row
    // that grew with its text would overlap the next one. Wrapped and elided,
    // a long message shows its beginning and where it was cut.
    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? Theme.panel-row-fill-hover : transparent;

    // the text is the edit affordance; it stops short of the button
    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 64px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    if root.thumb.width > 0 : Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.thumb;
            image-fit: cover;
        }
    }

    Text {
        x: root.thumb.width > 0 ? 34px : 6px;
        y: 0;
        width: parent.width - (root.thumb.width > 0 ? 100px : 72px);
        height: 100%;
        text: root.text;
        color: Theme.queue-row-ink;
        font-size: 11px;
        // centred: a one-line message sat against the top of a 34px row
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    // editing is a button, not a lucky click on the text: a row whose only way
    // to change is an invisible target looks uneditable
    Rectangle {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: edit.has-hover ? Theme.queue-row-control-fill-hover
            : Theme.queue-row-control-fill;
        edit := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "edit"); }
        }
        IconEdit {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: edit.has-hover ? Theme.queue-row-control-mark-hover
                : Theme.queue-row-control-mark;
        }
    }

    // a resting surface, not a hover-only one: an action that looks like empty
    // space until the pointer finds it is a hidden control
    Rectangle {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        // colour alone, no outline: the fill sits a clear step above both the
        // panel and the row's hover, which is what keeps the button a button
        background: del.has-hover ? Theme.queue-row-control-fill-hover
            : Theme.queue-row-control-fill;
        del := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "delete"); }
        }
        IconTrash {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: del.has-hover ? Theme.queue-row-delete-mark
                : Theme.queue-row-control-mark;
        }
    }
}

// A follow-up row: the same row plus the up arrow that pulls the message into
// the turn that is already running.
export component QueueRowUp inherits Rectangle {
    in property <string> text;
    in property <string> lane;
    in property <int> slot;
    in property <image> thumb;
    callback act(string, int, string);

    height: 34px;
    border-radius: 6px;
    background: row-touch.has-hover ? Theme.panel-row-fill-hover : transparent;

    row-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 92px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.act(root.lane, root.slot, "edit"); }
    }

    if root.thumb.width > 0 : Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.thumb;
            image-fit: cover;
        }
    }

    Text {
        x: root.thumb.width > 0 ? 34px : 6px;
        y: 0;
        width: parent.width - (root.thumb.width > 0 ? 128px : 100px);
        height: 100%;
        text: root.text;
        color: Theme.queue-row-ink;
        font-size: 11px;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 84px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: edit.has-hover ? Theme.queue-row-control-fill-hover
            : Theme.queue-row-control-fill;
        edit := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "edit"); }
        }
        IconEdit {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: edit.has-hover ? Theme.queue-row-control-mark-hover
                : Theme.queue-row-control-mark;
        }
    }

    Rectangle {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: up.has-hover ? Theme.queue-row-control-fill-hover
            : Theme.queue-row-control-fill;
        up := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "promote"); }
        }
        IconToTop {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: up.has-hover ? Theme.queue-row-promote-mark-hover
                : Theme.queue-row-promote-mark;
        }
    }

    Rectangle {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        // colour alone, no outline: the fill sits a clear step above both the
        // panel and the row's hover, which is what keeps the button a button
        background: del.has-hover ? Theme.queue-row-control-fill-hover
            : Theme.queue-row-control-fill;
        del := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.act(root.lane, root.slot, "delete"); }
        }
        IconTrash {
            width: 12px;
            height: 12px;
            x: 6px;
            y: 6px;
            tint: del.has-hover ? Theme.queue-row-delete-mark
                : Theme.queue-row-control-mark;
        }
    }
}

export component TranscriptRow inherits VerticalLayout {
    spacing: 0px;
    property <bool> err-hover: false;

    in property <TRow> data;
    callback toggle();
    // where the failure reason should be drawn: at the window's root, not in
    // this row, or the row beneath paints over it
    callback reason-hover(string, length, length);
    callback reason-leave();

    if data.kind == 0 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            background: Theme.transcript-message-fill;
            border-radius: 10px;
            width: min(self.preferred-width, 560px);
            height: self.preferred-height;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                StyledText {
                    text: data.body;
                    default-color: Theme.transcript-message-ink;
                    default-font-size: Type.body;
                    link-color: Theme.transcript-link-ink;
                }
            }
        }
    }

    if data.kind == 1 : Rectangle {
        height: agent-text.preferred-height + 12px;
        agent-text := StyledText {
            x: 24px;
            y: 6px;
            width: parent.width - 48px;
            text: data.body;
            default-color: Theme.transcript-prose-ink;
            default-font-size: Type.body;
            link-color: Theme.transcript-link-ink;
        }
    }

    if data.kind == 2 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            width: self.preferred-width;
            height: 24px;
            border-radius: 6px;
            background: think-touch.has-hover ? Theme.transcript-thinking-fill-hover
                : Theme.transcript-thinking-fill;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    text: "thinking";
                    color: Theme.transcript-thinking-label-ink;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: data.meta;
                    color: Theme.transcript-cell-meta-ink;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 10px;
                    height: 24px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }
            }
            think-touch := TouchArea { clicked => { root.toggle(); } }
        }

        if data.expanded : Rectangle {
            background: Theme.transcript-row-fill-expanded;
            border-color: Theme.transcript-thinking-edge-expanded;
            border-width: 1px;
            border-radius: 8px;
            height: min(think-text.preferred-height + 24px, 6 * think-probe.preferred-height + 24px);
            think-probe := Text {
                x: -200px;
                y: 0px;
                text: "x";
                font-family: "Cascadia Code";
                font-size: 11px;
                opacity: 0;
            }
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    think-text := StyledText {
                        text: data.body;
                        default-color: Theme.transcript-thinking-ink;
                        default-font-family: "Cascadia Code";
                        default-font-size: 11px;
                    }
                }
            }
        }
    }

    if data.kind == 3 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            height: 26px;
            border-radius: 6px;
            background: data.failed
                ? (cell-hot ? Theme.transcript-cell-fill-failed-hover
                    : Theme.transcript-cell-fill-failed)
                : (cell-hot ? Theme.transcript-cell-fill-hover : Theme.transcript-cell-fill);

            property <bool> cell-hot: cell-touch.has-hover || root.err-hover;

            cell-touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                clicked => { root.toggle(); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;

                Rectangle {
                    width: 10px;
                    height: 26px;
                    IconCaret {
                        y: (parent.height - self.height) / 2;
                        up: data.expanded;
                    }
                }

                Text {
                    text: data.title;
                    color: data.failed ? Theme.transcript-cell-ink-failed : Theme.transcript-cell-title-ink;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: data.meta;
                    color: Theme.transcript-cell-meta-ink;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                // the separator is full white so the run reads as two parts
                // instead of a sentence ending in a full stop
                Text {
                    text: "\u{00b7}";
                    color: Theme.transcript-cell-separator-ink;
                    font-size: 10px;
                    vertical-alignment: center;
                    visible: data.elapsed != "";
                }
                Text {
                    text: data.elapsed;
                    color: Theme.transcript-cell-meta-ink;
                    font-size: 10px;
                    vertical-alignment: center;
                    visible: data.elapsed != "";
                }

                if data.failed : Rectangle {
                    width: 14px;
                    height: 26px;
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: err-touch.has-hover ? Theme.transcript-cell-badge-fill-hover
                            : Theme.transcript-cell-badge-fill;
                        // the glyph is drawn in the badge's own box: at its
                        // default 16px it overhangs a 14px ring, and its stroke
                        // lands a pixel right and a pixel down of the centre
                        IconAlert {
                            width: parent.width;
                            height: parent.height;
                        }
                        err-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            changed has-hover => {
                                root.err-hover = self.has-hover;
                                if self.has-hover {
                                    root.reason-hover(
                                        data.reason,
                                        self.absolute-position.x,
                                        self.absolute-position.y + self.height,
                                    );
                                } else {
                                    root.reason-leave();
                                }
                            }
                        }
                    }
                }
            }


        }

        if data.expanded : Rectangle {
            background: Theme.transcript-row-fill-expanded;
            border-color: Theme.transcript-cell-edge-expanded;
            border-width: 1px;
            border-radius: 8px;
            height: self.preferred-height;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                StyledText {
                    text: data.code;
                    default-color: Theme.transcript-cell-code-ink;
                    default-font-family: "Cascadia Code";
                    default-font-size: 12px;
                }
                if data.has-output : Rectangle {
                    height: 1px;
                    background: Theme.transcript-cell-rule;
                }
                if data.has-output : StyledText {
                    text: data.output;
                    default-color: data.failed ? Theme.transcript-cell-ink-failed
                        : Theme.transcript-cell-output-ink;
                    default-font-family: "Cascadia Code";
                    default-font-size: 11px;
                }
            }
        }
    }

    if data.kind == 5 : HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: data.title;
            color: Theme.transcript-notice-ink;
            font-size: 10px;
        }
    }

    // A fenced block: its own surface, mono, the language named in the corner
    // the way a code card names it. The card and the code's own colour are
    // roles; the syntax inside the code is still the markup builder's palette,
    // which is the TUI's warmed to sit in this theme.
    if data.kind == 6 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 5px;
        padding-bottom: 5px;
        Rectangle {
            height: code-text.preferred-height + 24px + (data.meta == "" ? 0px : 15px);
            background: Theme.transcript-code-fill;
            border-radius: 8px;

            Text {
                x: 12px;
                y: 9px;
                text: data.meta;
                color: Theme.transcript-code-label-ink;
                font-size: 9px;
                visible: data.meta != "";
            }
            code-text := StyledText {
                x: 12px;
                y: 12px + (data.meta == "" ? 0px : 15px);
                width: parent.width - 24px;
                text: data.code;
                default-color: Theme.transcript-code-ink;
                default-font-size: 11.5px;
                default-font-family: "Cascadia Code";
            }
        }
    }

    // A table, box-drawn as text: it stays copyable and needs no cell model.
    if data.kind == 7 : VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 5px;
        padding-bottom: 5px;
        table-text := StyledText {
            text: data.body;
            default-color: Theme.transcript-table-ink;
            default-font-size: 11px;
            default-font-family: "Cascadia Code";
        }
    }
    // an image the user sent: the picture itself, thumbnailed, on the same edge
    // as the bubble so the sent turn reads as one thing
    if data.kind == 8 : HorizontalLayout {
        alignment: end;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        Rectangle {
            width: 220px;
            height: 150px;
            background: Theme.transcript-image-fill;
            border-radius: 10px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: data.image;
                image-fit: contain;
            }
        }
    }
}
