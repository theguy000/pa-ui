// A draft editor: a scroll view over a text input that grows to its content.
// Slint's own TextEdit is this same composition, but its colours are baked into
// the fluent style, so it is reproduced here with the app's palette instead.
import { ScrollView } from "std-widgets.slint";

export component DraftEditor inherits Rectangle {
    in property <length> font-size: 13px;
    in property <brush> foreground: #e7e5df;
    /// The painted message: coloured runs drawn by the canvas behind the input.
    in property <image> canvas;
    in property <length> canvas-height: 18px;
    in property <length> caret-x: 0px;
    in property <length> caret-y: 0px;
    in property <length> caret-height: 18px;
    in property <brush> selection-background: #3b3f2e;
    in property <brush> selection-foreground: #f2f0e8;
    in-out property <string> text <=> field.text;
    out property <bool> has-focus: field.has-focus;
    /// Where the caret sits, in bytes.
    out property <int> caret-offset: field.cursor-position-byte-offset;
    /// Ask for the caret to land at a byte offset once the text has arrived.
    /// Setting text from outside leaves the caret where it was - in the middle
    /// of a half-typed word - so the move has to wait for the text change.
    in-out property <int> caret-request: -1;
    public function place-caret(offset: int) {
        field.set-selection-offsets(offset, offset);
    }

    callback edited(text: string);
    callback key-pressed(event: KeyEvent) -> EventResult;

    public function grab-focus() { field.focus(); }

    clip: true;
    forward-focus: field;

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: false;
        content-width: self.visible-width;
        content-height: max(self.visible-height, field.preferred-height);

        // the words themselves: exactly what the input would have drawn, but
        // coloured run by run, with the caret placed from the same layout
        Image {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.canvas-height;
            source: root.canvas;
        }

        caret-bar := Rectangle {
            x: root.caret-x;
            y: root.caret-y;
            width: 1.5px;
            height: root.caret-height;
            background: #e7e5df;
            visible: root.has-focus;
        }

        field := TextInput {
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            font-size: root.font-size;
            // transparent glyphs and a zero-width native caret: this input keeps
            // the keys, IME, clipboard and selection, and paints nothing
            color: transparent;
            text-cursor-width: 0px;
            selection-background-color: root.selection-background;
            selection-foreground-color: root.selection-foreground;
            // PageUp/PageDown become sensible inside the box
            page-height: scroll.visible-height;

            edited => { root.edited(self.text); }
            changed text => {
                if root.caret-request >= 0 {
                    root.place-caret(root.caret-request);
                    root.caret-request = -1;
                }
            }
            key-pressed(e) => { root.key-pressed(e) }

            // the caret drives the scroll offset in both directions; the scroll
            // view then maps mouse hits back through that offset, which moving
            // the input around by hand did not
            cursor-position-changed(cpos) => {
                if cpos.y + scroll.content-y < 0px {
                    scroll.content-y = min(
                        0px,
                        max(scroll.visible-height - self.height, -cpos.y)
                    );
                } else if cpos.y + scroll.content-y > scroll.visible-height - 22px {
                    scroll.content-y = min(
                        0px,
                        max(scroll.visible-height - self.height, scroll.visible-height - cpos.y - 22px)
                    );
                }
            }
        }
    }

    // right-click gets the usual text actions instead of starting a selection
    // drag; TextInput's own cut/copy/paste keep text and selection in sync
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Cut";
                enabled: !root.text.is-empty;
                activated => { field.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: !root.text.is-empty;
                activated => { field.copy(); }
            }
            MenuItem {
                title: "Paste";
                activated => { field.paste(); }
            }
            MenuItem {
                title: "Select All";
                enabled: !root.text.is-empty;
                activated => { field.select-all(); }
            }
        }
    }
}
