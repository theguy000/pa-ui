// A draft editor: a scroll view over a text input that grows to its content.
// Slint's own TextEdit is this same composition, but its colours are baked into
// the fluent style, so it is reproduced here with the draft's own roles instead.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component DraftEditor inherits Rectangle {
    in property <length> font-size: 13px;
    in property <brush> foreground: Theme.composer-draft-ink;
    // canvas mode: the words are painted by Rust and this input only edits them
    in property <bool> use-canvas: false;
    in property <image> canvas;
    in property <length> canvas-height: 18px;
    in property <length> caret-x: 0px;
    in property <length> caret-y: 0px;
    in property <length> caret-height: 18px;
    in-out property <bool> blink-on: true;
    /// Where the field itself says the caret is, in its own coordinates. The
    /// painted glyphs and the typing position can disagree by a pixel or two; the
    /// field's own answer is the one the writer expects, so it wins.
    in-out property <length> native-caret-x: 0px;
    in-out property <length> native-caret-y: 0px;
    in-out property <length> canvas-caret-x: 0px;
    in-out property <length> canvas-caret-y: 0px;
    /// the truth for typing, converted into the painted canvas' coordinates
    out property <length> caret-drawn-x: root.native-caret-x > 0px
        ? root.native-caret-x : root.caret-x;
    out property <length> caret-drawn-y: root.native-caret-y > 0px
        ? root.native-caret-y : root.caret-y;
    in property <brush> selection-background: Theme.composer-draft-selection-fill;
    in property <brush> selection-foreground: Theme.composer-draft-selection-ink;
    in-out property <string> text <=> field.text;
    out property <bool> has-focus: field.has-focus;
    /// Where the caret sits, in bytes.
    out property <int> caret-offset: field.cursor-position-byte-offset;
    out property <int> anchor-offset: field.anchor-position-byte-offset;
    /// Ask for the caret to land at a byte offset once the text has arrived.
    /// Setting text from outside leaves the caret where it was - in the middle
    /// of a half-typed word - so the move has to wait for the text change.
    in-out property <int> caret-request: -1;
    public function place-caret(offset: int) {
        field.set-selection-offsets(offset, offset);
    }

    callback edited(text: string);
    callback key-pressed(event: KeyEvent) -> EventResult;

    public function grab-focus() { field.focus(); }

    clip: true;
    forward-focus: field;

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: false;
        content-width: self.visible-width;
        content-height: max(self.visible-height, field.preferred-height);

        // painted first, so it sits under the field and never sees a click
        if root.use-canvas : Image {
            x: 0;
            y: 0;
            width: max(parent.width, 1px);
            height: root.canvas-height;
            source: root.canvas;
            image-fit: fill;
        }

        // the caret the canvas measured, blinking on its own: the native one is
        // invisible while the glyphs are transparent
        if root.use-canvas : Rectangle {
            x: root.caret-drawn-x;
            y: root.caret-drawn-y;
            width: 1.5px;
            height: root.caret-height;
            background: Theme.composer-draft-caret;
            visible: root.blink-on;
        }

        field := TextInput {
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            font-size: root.font-size;
            color: root.use-canvas ? transparent : root.foreground;
            // in canvas mode the highlight is painted into the picture; a native
            // one on top of it would blot the words out
            selection-background-color: root.use-canvas ? transparent : root.selection-background;
            selection-foreground-color: root.use-canvas ? transparent : root.selection-foreground;
            // PageUp/PageDown become sensible inside the box
            page-height: scroll.visible-height;

            edited => {
                root.blink-on = true;
                root.edited(self.text);
            }
            changed text => {
                if root.caret-request >= 0 {
                    root.place-caret(root.caret-request);
                    root.caret-request = -1;
                }
            }
            key-pressed(e) => { root.key-pressed(e) }

            // the caret drives the scroll offset in both directions; the scroll
            // view then maps mouse hits back through that offset, which moving
            // the input around by hand did not
            cursor-position-changed(cpos) => {
                root.native-caret-x = cpos.x;
                root.native-caret-y = cpos.y;
                if cpos.y + scroll.content-y < 0px {
                    scroll.content-y = min(
                        0px,
                        max(scroll.visible-height - self.height, -cpos.y)
                    );
                } else if cpos.y + scroll.content-y > scroll.visible-height - 22px {
                    scroll.content-y = min(
                        0px,
                        max(scroll.visible-height - self.height, scroll.visible-height - cpos.y - 22px)
                    );
                }
            }
        }
    }

    // 530ms is the Windows default half-period
    blink := Timer {
        interval: 530ms;
        running: root.use-canvas && field.has-focus;
        triggered => { root.blink-on = !root.blink-on; }
    }

    // right-click gets the usual text actions instead of starting a selection
    // drag; TextInput's own cut/copy/paste keep text and selection in sync
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Cut";
                enabled: !root.text.is-empty;
                activated => { field.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: !root.text.is-empty;
                activated => { field.copy(); }
            }
            MenuItem {
                title: "Paste";
                activated => { field.paste(); }
            }
            MenuItem {
                title: "Select All";
                enabled: !root.text.is-empty;
                activated => { field.select-all(); }
            }
        }
    }
}
