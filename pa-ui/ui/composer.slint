// The composer's furniture: the model chip, the context ring and the card that
// opens off it.

import { IconCaret } from "icons.slint";

// One line of the context ledger: the label, then the value flush right in a
// fixed slot so the whole column of numbers has one edge to line up on.
export component Ledger inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> ink: #b0b1a8;
    height: 16px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: #6b6e63;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.value;
            color: root.ink;
            font-size: 10.5px;
            width: 58px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// The context card, shared by the ring's hover popup and the right column: the
// window first (how close the session is to forgetting), then the counts, then
// the money - one question at two scales.
export component ContextCard inherits Rectangle {
    in property <float> fill: 0.0;
    in property <string> used: "";
    in property <string> percent: "";
    in property <string> messages: "";
    in property <string> tools: "";
    in property <string> input: "";
    in property <string> output: "";
    in property <string> cached: "";
    in property <string> cost: "";
    in property <string> cost-family: "";
    in property <bool> cost-family-on: false;
    background: transparent;
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            Text {
                text: "context";
                color: #6b6e63;
                font-size: 10px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.percent;
                color: #e7e5df;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        // the bar answers "how close am I" before a single number is read
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: #23251f;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * root.fill;
                border-radius: 1.5px;
                background: #a18e41;
            }
        }
        Text {
            text: root.used;
            color: #8b8c85;
            font-size: 10px;
        }
        Rectangle { height: 1px; background: #1c1e19; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 1px;
            Ledger { label: "messages"; value: root.messages; }
            Ledger { label: "tools"; value: root.tools; }
            Ledger { label: "in"; value: root.input; }
            Ledger { label: "out"; value: root.output; }
            Ledger { label: "cached"; value: root.cached; }
        }
        Rectangle { height: 1px; background: #1c1e19; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 1px;
            Ledger { label: "cost"; value: root.cost; ink: #d9d7cd; }
            if root.cost-family-on : Ledger {
                label: "with subagents";
                value: root.cost-family;
                ink: #d9d7cd;
            }
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback toggled;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    // The resting state is what the old hover state was: a chip that only
    // appears under the pointer reads as decoration, not as a control.
    background: ct.has-hover || open ? #23251f : #1a1b16;
    border-color: ct.has-hover || open ? #33362d : #23251f;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.label;
            color: ct.has-hover || open ? #e7e5df : #b0b1a8;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 10px;
            height: 24px;
            IconCaret {
                y: (parent.height - self.height) / 2;
                up: root.open;
            }
        }
    }
    ct := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}

// The context ring: 24 hairline ticks round a 20x20 box, the first `fill` share of
// them lit. Each tick carries its own threshold, so the ring stays a data table and
// the component stays a loop.

export struct RingTick {
    shape: string,
    at: float,
}

global Ticks {
    out property <[RingTick]> all: [
        { shape: "M 10.00 4.00 L 10.00 1.30", at: 0.0000 },
        { shape: "M 11.55 4.20 L 12.25 1.60", at: 0.0417 },
        { shape: "M 13.00 4.80 L 14.35 2.47", at: 0.0833 },
        { shape: "M 14.24 5.76 L 16.15 3.85", at: 0.1250 },
        { shape: "M 15.20 7.00 L 17.53 5.65", at: 0.1667 },
        { shape: "M 15.80 8.45 L 18.40 7.75", at: 0.2083 },
        { shape: "M 16.00 10.00 L 18.70 10.00", at: 0.2500 },
        { shape: "M 15.80 11.55 L 18.40 12.25", at: 0.2917 },
        { shape: "M 15.20 13.00 L 17.53 14.35", at: 0.3333 },
        { shape: "M 14.24 14.24 L 16.15 16.15", at: 0.3750 },
        { shape: "M 13.00 15.20 L 14.35 17.53", at: 0.4167 },
        { shape: "M 11.55 15.80 L 12.25 18.40", at: 0.4583 },
        { shape: "M 10.00 16.00 L 10.00 18.70", at: 0.5000 },
        { shape: "M 8.45 15.80 L 7.75 18.40", at: 0.5417 },
        { shape: "M 7.00 15.20 L 5.65 17.53", at: 0.5833 },
        { shape: "M 5.76 14.24 L 3.85 16.15", at: 0.6250 },
        { shape: "M 4.80 13.00 L 2.47 14.35", at: 0.6667 },
        { shape: "M 4.20 11.55 L 1.60 12.25", at: 0.7083 },
        { shape: "M 4.00 10.00 L 1.30 10.00", at: 0.7500 },
        { shape: "M 4.20 8.45 L 1.60 7.75", at: 0.7917 },
        { shape: "M 4.80 7.00 L 2.47 5.65", at: 0.8333 },
        { shape: "M 5.76 5.76 L 3.85 3.85", at: 0.8750 },
        { shape: "M 7.00 4.80 L 5.65 2.47", at: 0.9167 },
        { shape: "M 8.45 4.20 L 7.75 1.60", at: 0.9583 }
    ];
}

export component ContextRing inherits Rectangle {
    in property <float> fill: 0.0;
    in property <color> lit: #c9a86a;
    in property <color> unlit: #33362d;

    width: 20px;
    height: 20px;
    background: transparent;

    for tick in Ticks.all : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: tick.shape;
        stroke: tick.at <= root.fill ? root.lit : root.unlit;
        stroke-width: 1.5px;
    }
}
