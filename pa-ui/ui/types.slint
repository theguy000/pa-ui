// The window's shared vocabulary: the sizes it sets type at, and the shape of
// every record a model or a callback carries across the Slint/Rust seam.

// The reading size. The DeepSeek Harness sets its conversation text at 14px on
// a 24px line; this toolkit gives no control over that line, so the size carries
// the difference instead: one point up, on the spacing the font chooses.
export global Type {
    in-out property <length> body: 15px;
    // The sidebar: the harness sets its list of conversations at 13px, one step
    // under the conversation itself.
    in-out property <length> item: 13px;
}

export global Appearance {
    in-out property <length> body-size: 15px;
    in-out property <length> item-size: 13px;
    in-out property <length> label-size: 11px;
    in-out property <length> meta-size: 10px;
    in-out property <length> session-header-size: 12.5px;
    in-out property <length> session-count-size: 11.5px;
    in-out property <length> session-row-height: 32px;
    in-out property <length> code-size: 11.5px;
    in-out property <length> cell-code-size: 12px;
    in-out property <length> cell-output-size: 11px;
    in-out property <string> code-font: "Cascadia Code";
    in-out property <length> row-pad-y: 6px;
    in-out property <length> cell-pad-y: 4px;
    in-out property <length> code-pad-y: 5px;
    in-out property <length> cell-gap: 6px;
    in-out property <length> expanded-pad-x: 12px;
    in-out property <length> expanded-pad-y: 10px;
    in-out property <length> expanded-gap: 8px;
    in-out property <bool> show-timestamps: false;
    in-out property <duration> hover-duration: 120ms;
    in-out property <duration> menu-duration: 90ms;
    in-out property <duration> fold-duration: 220ms;
    in-out property <duration> fold-caret-duration: 160ms;
    in-out property <duration> band-duration: 170ms;
    in-out property <bool> smooth-scroll: true;
}

export struct TRow {
    kind: int,          // KIND_* constants in transcript/mod.rs
    title: string,
    meta: string,
    body: styled-text,
    code: styled-text,
    output: styled-text,
    has-code: bool,
    has-output: bool,
    has-body: bool,
    expanded: bool,
    failed: bool,
    reason: string,
    image: image,
    elapsed: string,
    timestamp: string,
}

export struct SessionItem {
    id: string,
    uuid: string,
    name: string,
    full: string,
    tip: string,
    // the daemon's status, in the window's words: "active", "idle" or "done",
    // which is also the group the row is listed under
    status: string,
    // set aside: no worker holds it, so the row is in the done group
    done: bool,
    // where the session is saved: the path `rename_saved_session` and
    // `delete_saved_session` address, since a row with no worker has no id to
    // target a worker with
    file: string,
}

// One line of the sessions column: a group's header, or one session under it.
// Every entry carries the y it is drawn at, computed by the window from the
// group order, the row counts and the fold state.
export struct SessionEntry {
    // a header, not a session
    is-header: bool,
    // the header's word: "Active", "Idle" or "Done"
    label: string,
    // the header's count, and whether its group is folded
    count: int,
    folded: bool,
    // the row, for a session entry
    item: SessionItem,
    // where it is drawn, from the top of the column
    at: length,
    // where it is drawn once the last fold has settled: equal to `at` when the
    // group it is in is the one folding open or closed
    target: length,
    // the heading a fold moves the entry between: its own group's header, or
    // the next one when its own group has folded
    seam: int,
}

// One row of a session's own menu: the action's key, the words it shows, whether
// it sits below the separator away from the actions that act on the session
// itself, and the warning it turns into once armed.
export struct SessionMenuItem {
    key: string,
    label: string,
    // drawn in the warning ink, and the note under it in that same ink
    danger: bool,
    // what the armed item says it is about to do, and empty at rest
    note: string,
    // below the separator, in the danger ink: the action acts on the file, not
    // on the session
    separated: bool,
}

// One character of a session's name in the search popup, and whether the query
// matched it. A row of these is what the popup draws instead of a plain name,
// because the letters the query hit carry a colour of their own.
export struct SearchGlyph {
    text: string,
    matched: bool,
}

// One row of the search popup: the session it opens, and when it was last used,
// with the name as the characters the row draws it by.
export struct SearchRow {
    id: string,
    age: string,
    glyphs: [SearchGlyph],
}

// One row of the command menu: the word after the slash, the argument hint the
// command takes, and what it does.
export struct SlashItem {
    name: string,
    hint: string,
    description: string,
}

export struct QueueItem {
    // what the row shows: one line, elided
    text: string,
    // what the daemon addressed it by, untouched
    raw: string,
    slot: int,
    // the picture this message carries, if any: the queue projection names text
    // only, so the window supplies the thumbnail it sent
    thumb: image,
}

export struct ModelItem {
    id: string,
    label: string,
    // right-aligned hint: context window
    detail: string,
    // the level this model is thinking at: only ever set on the running one,
    // since a level belongs to the model that holds it
    effort: string,
    current: bool,
}

// one rung of a model's thinking ladder, in the submenu that drops off its row
export struct EffortItem {
    level: string,
    label: string,
    current: bool,
}

// one provider's models; `models` is empty while the group is collapsed, so a
// thousand-entry catalog never becomes a thousand elements
export struct ModelGroup {
    provider: string,
    label: string,
    count: int,
    open: bool,
    configured: bool,
    top: length,
    models: [ModelItem],
}

// one entry in the theme list that opens off the settings menu
export struct ThemeItem {
    id: string,
    label: string,
    current: bool,
}