// The three panels that hang off the composer: the slash command list, the model
// menu, and the thinking-level ladder that drops off one of its rows. Each sits at
// the window root rather than inside the composer band, because a band-height
// animation would drag it along, and each is told where the composer is instead of
// reaching for it.

import { ScrollView } from "std-widgets.slint";
import { EffortItem, ModelGroup, SlashItem } from "types.slint";
import { IconCaret, IconCheck } from "icons.slint";
import { Theme } from "theme.slint";

// The command list above the composer. `index` is the highlighted row; arrowing
// past the fold pulls the list after it.
export component SlashMenu inherits Rectangle {
    in property <[SlashItem]> items;
    in-out property <int> index;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-w;
    callback accepted();

    x: root.anchor-x + 12px;
    y: root.anchor-y - self.height - 6px;
    width: min(460px, root.anchor-w - 24px);
    // ten rows at a time; the list scrolls and the highlight pulls it along
    height: min(312px, 12px + root.items.length * 30px);
    background: Theme.panel-surface;
    border-color: Theme.panel-edge;
    border-width: 1px;
    border-radius: 10px;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.panel-shadow;

    slash-list := ScrollView {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        content-width: self.visible-width;
        content-height: self.visible-height;
        // the highlight must never walk off the top or bottom of the list:
        // arrowing down past the fold used to select a row nobody could see
        content-y: -clamp(
            root.index * 30px - 60px,
            0px,
            max(0px, root.items.length * 30px - self.height)
        );

        slash-rows := VerticalLayout {
            width: slash-list.visible-width;
            for item[index] in root.items : Rectangle {
                width: parent.width;
                height: 28px;
                border-radius: 6px;
                // the row answers the pointer: a background under it and the
                // one sentence that says what the command does. At rest the
                // list is names only, like a menu should be.
                background: index == root.index || slash-touch.has-hover
                    ? Theme.panel-row-fill-hover : transparent;
                animate background { duration: 90ms; }

                HorizontalLayout {
                    x: 10px;
                    y: 0;
                    width: parent.width - 20px;
                    height: 100%;
                    spacing: 8px;
                    Text {
                        text: "/" + item.name;
                        font-size: 13px;
                        color: index == root.index || slash-touch.has-hover
                            ? Theme.slash-menu-row-ink-hover : Theme.slash-menu-row-ink;
                        vertical-alignment: center;
                    }
                    if (index == root.index || slash-touch.has-hover) && item.hint != "" : Text {
                        text: item.hint;
                        font-size: 11px;
                        color: Theme.slash-menu-hint-ink;
                        vertical-alignment: center;
                    }
                    Text {
                        text: item.description;
                        font-size: 11px;
                        color: Theme.slash-menu-description-ink;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        opacity: index == root.index || slash-touch.has-hover ? 1 : 0;
                        animate opacity { duration: 90ms; }
                    }
                }

                slash-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.index = index;
                        root.accepted();
                    }
                }
            }
        }
    }
}

// The provider/model catalog. A group with `open: false` carries no models, so a
// long catalog costs one header each.
export component ModelMenu inherits Rectangle {
    in property <[ModelGroup]> groups;
    in property <length> measured-height;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-w;
    callback picked(string, string);
    callback hovered(string, string, length);
    callback pointer-moved();
    callback provider-toggled(string);
    callback close-requested();

    x: root.anchor-x + root.anchor-w - self.width - 12px;
    y: root.anchor-y - self.height - 6px;
    width: 300px;
    height: max(64px, min(340px, root.measured-height));
    background: Theme.panel-surface;
    border-color: Theme.panel-edge;
    border-width: 1px;
    border-radius: 10px;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.panel-shadow;

    menu-scroll := ScrollView {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        content-width: self.visible-width;
        content-height: menu-list.preferred-height;

        // A group is one block: its header plus a row per
        // model. Collapsed groups carry no models at all,
        // so their height is just the header.
        // behind every row: a move here is a move off the rows
        menu-bg := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: parent.content-height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.pointer-moved();
                }
            }
        }

        menu-list := VerticalLayout {
            for group in root.groups : Rectangle {
                height: 26px + group.models.length * 24px;

                group-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 26px;
                    mouse-cursor: pointer;
                    clicked => { root.provider-toggled(group.provider); }
                    // a header is not a model row: the ladder does not
                    // belong to it
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.pointer-moved();
                        }
                    }
                }

                IconCaret {
                    x: 6px;
                    y: (26px - self.height) / 2;
                    up: !group.open;
                }
                Text {
                    x: 22px;
                    y: 0;
                    width: parent.width - 80px;
                    height: 26px;
                    text: group.label;
                    color: group.configured ? Theme.model-menu-header-ink
                        : Theme.model-menu-header-ink-quiet;
                    font-size: 11px;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Text {
                    x: parent.width - 58px;
                    y: 0;
                    width: 52px;
                    height: 26px;
                    text: group.configured ? group.count : "not signed in";
                    color: Theme.model-menu-count-ink;
                    font-size: 9px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }

                for model[i] in group.models : Rectangle {
                    x: 0;
                    y: 26px + i * 24px;
                    width: 100%;
                    height: 24px;
                    border-radius: 5px;
                    background: model.current ? Theme.panel-row-fill-current
                        : (model-touch.has-hover ? Theme.panel-row-fill-hover : transparent);

                    model-touch := TouchArea {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.picked(model.id, group.provider);
                            root.close-requested();
                        }
                        // the ladder drops off the row under the pointer;
                        // the row's window y is what it hangs from. Two
                        // sources, because the move callback alone missed
                        // pointer entries that never reported a move.
                        moved => {
                            if self.has-hover {
                                root.hovered(group.provider, model.id,
                                    self.absolute-position.y);
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.hovered(group.provider, model.id,
                                    self.absolute-position.y);
                            }
                        }
                    }

                    Text {
                        x: 24px;
                        y: 0;
                        width: parent.width - 108px;
                        height: 100%;
                        text: model.label;
                        color: model.current ? Theme.model-menu-row-ink-current
                            : Theme.model-menu-row-ink;
                        font-size: 11px;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    // the running model names its level right of the name;
                    // every other row shows the context window instead
                    Text {
                        x: parent.width - 118px;
                        y: 0;
                        width: 74px;
                        height: 100%;
                        text: model.effort != "" ? model.effort : model.detail;
                        color: model.effort != "" ? Theme.model-menu-effort-ink
                            : Theme.model-menu-detail-ink;
                        font-size: 9px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    // the selected model is marked, not just tinted: two
                    // 2px strokes, heavier than the 1.5px marks elsewhere
                    if model.current : IconCheck {
                        x: parent.width - 26px;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}

// The thinking ladder, hung to the left of the model menu: the menu sits on the
// composer's right edge, so there is no room on its right for a second column. It
// tracks the hovered row's y and stays inside the menu's band.
export component EffortLadder inherits Rectangle {
    in property <[EffortItem]> items;
    in property <length> row-y;
    in property <length> measured-height;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-w;
    callback picked(int);
    callback hovered();

    x: root.anchor-x + root.anchor-w - 300px - 12px
        - self.width - 6px;
    y: max(
        root.anchor-y
            - max(64px, min(340px, root.measured-height)) - 6px,
        min(root.row-y - 4px,
            root.anchor-y - 6px - self.height)
    );
    width: 132px;
    height: 10px + root.items.length * 26px;
    background: Theme.panel-surface;
    border-color: Theme.panel-edge;
    border-width: 1px;
    border-radius: 8px;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.panel-shadow-nested;

    // the ladder answers for its own surface, or moving onto it would
    // count as leaving the row it hangs from
    ladder-bg := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }

    for item[i] in root.items : Rectangle {
        x: 0;
        y: 5px + i * 26px;
        width: 100%;
        height: 26px;
        border-radius: 5px;
        background: item-touch.has-hover ? Theme.panel-row-fill-hover : transparent;

        item-touch := TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.picked(i); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.hovered();
                }
            }
        }

        Text {
            x: 12px;
            y: 0;
            width: parent.width - 40px;
            height: 100%;
            text: item.label;
            color: item.current ? Theme.effort-ladder-row-ink-current
                : Theme.effort-ladder-row-ink;
            font-size: 11px;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }
            if item.current : IconCheck {
                x: parent.width - 24px;
                y: (parent.height - self.height) / 2;
            }
    }
}
