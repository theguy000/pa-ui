// The window's caption, drawn here because the native one cannot follow the app
// theme. Geometry must agree with HEIGHT and BUTTON in src/titlebar.rs.

import { CaptionGlyph, PanelIcon } from "icons.slint";
import { Theme } from "theme.slint";
import { Button } from "primitives.slint";

// A caption button is the window's own button with the caption's geometry: the
// arrow the native bar draws instead of the window's hand, and no fade, because
// the native caption snaps and a title bar that eased its fills would read as a
// different window.
export component CaptionButton inherits Button {
    width: 46px;
    height: 100%;
    cursor: MouseCursor.default;
    fade: 0ms;
    fill-hover: Theme.title-bar-caption-fill-hover;
}

export component TitleBar inherits Rectangle {
    in property <bool> right-open: false;
    callback toggle-right();
    in property <bool> maximized: false;
    in property <bool> max-hover: false;
    in property <string> caption: "Prime Agent Desktop";
    callback minimize();
    callback close();
    callback menu();

    height: 32px;
    width: 100%;
    // No field of its own: the window's background runs under the bar, and the
    // sidebar's header band sits inside this height.
    background: transparent;

    // The right column's fold lives in the chrome, not in the column: the column is
    // blank, so a mark inside it would have nothing to sit on.
    right-toggle := Button {
        x: parent.width - 172px;
        y: (parent.height - 26px) / 2;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        fill-hover: Theme.title-bar-fold-fill-hover;
        cursor: MouseCursor.default;
        fade: 0ms;
        described: "Toggle the right column";
        clicked => { root.toggle-right(); }
        PanelIcon {
            x: 5px;
            y: 5px;
            folded-edge-right: true;
            arrow: right-toggle.hot;
            point-left: !root.right-open;
            tint: right-toggle.hot
                ? Theme.title-bar-fold-glyph-hover
                : Theme.title-bar-fold-glyph;
        }
    }

    // minimise and close are ours; maximise belongs to Windows for Snap Layouts,
    // which is why its hover state is sampled from the pointer by the Rust side
    // rather than reported by this button's own hit area.
    min-button := CaptionButton {
        x: parent.width - 138px;
        described: "Minimise the window";
        clicked => { root.minimize(); }
        CaptionGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: Theme.title-bar-glyph;
            commands: "M 0.5 5.5 L 9.5 5.5"; }
    }

    max-button := CaptionButton {
        x: parent.width - 92px;
        enabled: false;
        described: "Maximise the window";
        lit: root.max-hover;
        CaptionGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: Theme.title-bar-glyph;
            commands: root.maximized
                ? "M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z"
                : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
        }
    }

    close-button := CaptionButton {
        x: parent.width - 46px;
        fill-hover: Theme.title-bar-close-fill-hover;
        described: "Close the window";
        clicked => { root.close(); }
        CaptionGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: close-button.hot ? Theme.title-bar-close-ink-hover : Theme.title-bar-glyph;
            commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
        }
    }

    // no rule under the caption: the bar and the body meet in one flat field,
    // because the frame around them draws nothing to stop against
}
